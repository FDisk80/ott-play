+    fn resolver_rejects_row_replaced_by_symlink_and_does_not_open_missing_root() {
+        let f = Fixture::new();
+        f.file("one.mp4");
+        let mut rows = Vec::new();
+        visit(&f.profile(), &AtomicBool::new(false), &mut |batch| {
+            rows.extend(batch);
+            Ok(())
+        })
+        .unwrap();
+        std::fs::remove_file(f.0.join("one.mp4")).unwrap();
+        #[cfg(unix)]
+        {
+            let other = Fixture::new();
+            other.file("two.mp4");
+            std::os::unix::fs::symlink(other.0.join("two.mp4"), f.0.join("one.mp4")).unwrap();
+            assert!(resolve(&f.profile(), &rows[0]).is_err());
+        }
+        let mut profile = f.profile();
+        profile.source.push_str("/missing");
+        assert!(visit(&profile, &AtomicBool::new(false), &mut |_| Ok(())).is_err());
+    }
+
+    #[test]
+    fn pre_cancelled_scan_and_closed_receiver_do_not_read_remaining_tree() {
+        let f = Fixture::new();
+        f.file("one.mp4");
+        let report = visit_report(&f.profile(), &AtomicBool::new(true), &mut |_| {
+            panic!("cancelled scan published")
+        })
+        .unwrap();
+        assert!(report.cancelled);
+        assert_eq!(report.inspected, 0);
+        assert_eq!(
+            visit(&f.profile(), &AtomicBool::new(false), &mut |_| Err(
+                "receiver closed"
+            )),
+            Err("receiver closed")
+        );
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn unrepresentable_name_is_reported_without_discarding_readable_videos() {
+        use std::os::unix::ffi::OsStringExt;
+        let f = Fixture::new();
+        f.file("one.mp4");
+        f.file("two.mp4");
+        let mut rows = Vec::new();
+        let mut report = visit_report(&f.profile(), &AtomicBool::new(false), &mut |batch| {
+            rows.extend(batch);
+            Ok(())
+        })
+        .unwrap();
+        // APFS refuses invalid UTF-8 names at creation. Exercise the same
+        // production entry conversion without requiring that OS operation.
+        let bad =
+            f.0.join(std::ffi::OsString::from_vec(b"bad\xff.mp4".to_vec()));
+        assert!(relative_name(&f.0, &bad, &mut report).is_none());
+        assert_eq!(report.videos, 2);
+        assert_eq!(report.skipped, 1);
+        assert_eq!(rows.len(), 2);
+        assert!(outcome(report).is_err());
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn filesystem_invalid_utf8_entry_uses_the_same_partial_catalogue_policy() {
+        use std::os::unix::ffi::OsStringExt;
+        let f = Fixture::new();
+        f.file("one.mp4");
+        f.file("two.mp4");
+        std::fs::write(
+            f.0.join(std::ffi::OsString::from_vec(b"bad\xff.mp4".to_vec())),
+            b"media",
+        )
+        .unwrap();
+        let mut rows = Vec::new();
+        let report = visit_report(&f.profile(), &AtomicBool::new(false), &mut |batch| {
+            rows.extend(batch);
+            Ok(())
+        })
+        .unwrap();
+        assert_eq!(report.videos, 2);
+        assert_eq!(report.skipped, 1);
+        assert_eq!(rows.len(), 2);
+        assert!(visit(&f.profile(), &AtomicBool::new(false), &mut |_| Ok(())).is_err());
+    }
+}
