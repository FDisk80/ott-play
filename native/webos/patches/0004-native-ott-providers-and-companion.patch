+                        state.validate()?;
+                        let state = favorites::recover(state, &write_permit)?;
+                        let entropy = plx_platform::storage::state::Generation::random()
+                            .map_err(|_| "Could not generate operation identities")?
+                            .0;
+                        Ok((state, entropy))
