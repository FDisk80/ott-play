@@ -0,0 +1,52 @@
+//! Catalogue metadata uses the same title, text, poster and reading primitives
+//! as the native media screens. No network or texture ownership lives here.
+use super::{OttPoster, OttRow};
+use plx_machine::machine::Measure;
+use plx_platform::i18n::msg;
+use plx_ui::{Painter,Rect,theme};
+use plx_ui::route_screen::{RouteLayout,draw_back_crumb,CRUMB_BAND};
+use plx_ui::text_view::TextView;
+use plx_ui::widgets::{self,Art};
+
+pub(super) fn paint(p:Painter,measure:&dyn Measure,row:&OttRow,status:&str,reading:bool){
+    let layout=RouteLayout::screen();let area=layout.narrative;
+    draw_back_crumb(p,Rect::new(area.x,area.y,area.w,CRUMB_BAND),if reading {msg::ott_channel_list()} else {msg::ott_brand()},measure);
+    let top=area.y+CRUMB_BAND+theme::space::LG;
+    let title=TextView::new(&row.title,theme::size::HEADLINE,theme::TEXT_HEADING).bold().max_lines(3).with_measure(measure);
+    let height=title.measure_h(area.w);
+    title.draw(p,Rect::new(area.x,top,area.w,height));
+    let detail_top=top+height+theme::space::MD;
+    let detail=TextView::new(&row.detail,theme::size::CAPTION,theme::TEXT_SECONDARY).max_lines(2).with_measure(measure);
+    let detail_h=detail.measure_h(area.w);detail.draw(p,Rect::new(area.x,detail_top,area.w,detail_h));
+    let body_top=detail_top+detail_h+theme::space::LG;
+    let mut body_bottom=layout.action.y-theme::space::MD;
+    // A selected item replaces the route's narrative, but never its catalogue
+    // status. Keep progress and partial-load errors above the shared hint band.
+    // An empty status reserves no space and retains the original composition.
+    if !status.trim().is_empty() {
+        let status=TextView::new(status,theme::size::CAPTION,theme::TEXT_SECONDARY)
+            .max_lines(3).with_measure(measure);
+        let height=status.measure_h(area.w);
+        status.draw(p,Rect::new(area.x,body_bottom-height,area.w,height));
+        body_bottom-=height+theme::space::MD;
+    }
+    let mut body=Rect::new(area.x,body_top,area.w,(body_bottom-body_top).max(0.0));
+    if let Some(poster)=&row.poster {
+        let frame=Rect::new(area.x,body_top,plx_ui::consts::CARD_W,plx_ui::consts::CARD_H.min(body.h));
+        let art=match poster {
+            OttPoster::Plex{server,key}=>Art::Thumb{sid:*server,key,res:(250,375)},
+            OttPoster::Http{url}=>Art::Http{url,res:(250,375)},
+        };
+        widgets::card_named(p,frame,art,None,theme::CARD_RING_RAD,false,1.0,0.0);
+        body.x+=frame.w+theme::space::LG;body.w-=frame.w+theme::space::LG;
+    }
+    if !reading && !row.description.is_empty() && body.h>0.0 {
+        let lines=(body.h/measure.font_scale().points(theme::size::LABEL as f32+theme::space::XS)).floor() as usize;
+        TextView::new(&row.description,theme::size::LABEL,theme::TEXT_SECONDARY).max_lines(lines.max(1))
+            .with_measure(measure).fade_last(theme::space::XL).draw(p,body);
+    }
+    let hint=if reading {msg::ott_read_hint()} else if row.description.is_empty() {msg::ott_favorite_hint()}
+        else {msg::ott_description_hint()};
+    TextView::new(hint,theme::size::CAPTION,theme::TEXT_TERTIARY).with_measure(measure)
+        .draw(p,Rect::new(area.x,layout.action.y,area.w,layout.action.h));
+}
