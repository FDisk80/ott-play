+        Scheme::Http => plaintext(origin, "/library/sections", Method::Get, &headers, policy),
+        Scheme::Https => tls(origin, "/library/sections", Method::Get, &headers, policy, None),
+    };
+    if !proof.current() { return Err(None); }
+    match outcome { RequestOutcome::Response(reply) => Ok(reply), RequestOutcome::Transport(error) => Err(error), RequestOutcome::Deadline => Err(None) }
+}
