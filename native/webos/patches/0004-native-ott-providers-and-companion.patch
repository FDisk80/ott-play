+fn fetch(url: &str, w: u32, h: u32) -> Option<Decoded> {
+    let response = plx_net::net::request(
+        url,
+        &[],
+        "GET",
+        None,
+        plx_net::net::Timeouts {
+            connect_s: 5,
+            total_s: 15,
+            total_ms: 0,
+            low_speed_bps: 1,
+            low_speed_s: 5,
+        },
+        true,
+        Some(MAX_BYTES),
+        None,
+    )?;
