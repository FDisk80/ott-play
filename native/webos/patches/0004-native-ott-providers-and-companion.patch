+//! Cross-provider regression at the second (native Plex) completion boundary.
+//!
+//! This injects the native terminal verdict after the OTT wrapper has admitted
+//! Plex playback. It is not a network/PlayLanding end-to-end test. Unlike the
+//! continuity unit tests it runs the real application tick and requires it to
+//! turn the native failure into the next provider's queued resolver request.
+use super::*;
+
+fn profile(id: &str, name: &str, kind: ProviderKind, source: &str) -> ProviderProfile {
+    ProviderProfile {
+        id: id.into(),
+        name: name.into(),
+        kind,
+        source: source.into(),
+        source_alias: name.into(),
+        enabled: true,
+    }
+}
+
+fn row(id: &str, title: &str, media: MediaLocator) -> CatalogEntry {
+    CatalogEntry {
+        id: id.into(),
+        title: title.into(),
+        category: String::new(),
+        description: String::new(),
+        poster: String::new(),
+        media,
+        duration_ms: Some(60_000),
+        provider_id: None,
+        provider_id_field: None,
+    }
+}
+
+#[test]
+fn injected_plex_terminal_refusal_after_wrapper_admission_queues_local_favorite() {
+    let _serial = plx_base::testlock::serial();
+    struct RegistryCleanup;
+    impl Drop for RegistryCleanup {
+        fn drop(&mut self) {
+            plx_media::player::SHARED.reset_session();
+            plx_media::player::TX.reset();
+            plx_media::route::reset_player_control_for_test(
+                &plx_media::route::PlaybackSession::IDLE,
+            );
+            plx_plex::plex::reset_servers_for_test();
+        }
+    }
+    let _registry_cleanup = RegistryCleanup;
+    plx_plex::plex::reset_servers_for_test();
+    let sid = plx_plex::plex::register_for_test(
+        "fixture-machine",
+        "127.0.0.1",
+        1,
+        "fixture-token",
+        "fixture-client",
+    );
+    plx_plex::plex::client_for(sid).unwrap().disable_data_io();
+    let mut app = app_fixture();
+    let mut runtime = runtime_fixture();
+    let plex = profile(
+        "plex-fixture",
+        "Plex",
+        ProviderKind::Plex,
+        "fixture-machine",
+    );
+    let local = profile(
+        "local-fixture",
+        "Local",
+        ProviderKind::Local,
+        "/fixture/media",
+    );
+    let plex_row = row(
+        "plex-fixture:42",
+        "Plex film",
+        MediaLocator::Plex {
+            server_id: plex.source.clone(),
+            rating_key: "42".into(),
+        },
+    );
+    let local_row = row(
+        "local-fixture:next",
+        "Local film",
+        MediaLocator::Local {
+            relative_path: "next.mp4".into(),
+        },
+    );
+    let plex_favorite = selection::capture(&plex, &plex_row).unwrap();
+    let local_favorite = selection::capture(&local, &local_row).unwrap();
+    let plex_selection = format!("favorite:{}", plex_favorite.identity());
+    let local_selection = format!("favorite:{}", local_favorite.identity());
+    runtime.saved.profiles.profiles = vec![plex.clone(), local];
+    runtime.saved.profiles.active_profile = Some(plex.id.clone());
+    runtime.saved.favorites.toggle(plex_favorite).unwrap();
+    runtime.saved.favorites.toggle(local_favorite).unwrap();
+    runtime.saved.favorites_selected = true;
+    runtime.provider = ProviderKind::Plex;
+    runtime.page = "favorites";
+    runtime.catalog_loading = false;
+    runtime.catalog_dirty = false;
+    runtime.selected = Some(plex_selection.clone());
+
+    // State committed by start_resolved(ReadySource::Plex), after Job::Play
+    // consumes play_target. The inner native resolve has not succeeded yet.
+    runtime
+        .continuity
+        .user_selected(runtime.generation, &plex_selection);
+    runtime.playing = Some(Playing {
+        profile: plex,
+        entry: plex_row,
+        selection_id: plex_selection,
+        source: None,
+    });
+    runtime.play_target = None;
+    runtime.pending_play = None;
+    runtime.resolver_next = None;
+    // Hold the outgoing test resolver boundary. A queued next-file request is
+    // observable without reading /fixture/media or starting any network job.
+    runtime.resolver_busy = true;
+    app.ott = Some(runtime);
+
+    plx_media::route::install_plex_identity_for_test(&mut app.player.session, sid, "42");
+    assert!(
+        playing_matches(app.ott.as_ref().unwrap().playing.as_ref().unwrap(), &app),
+        "premise: the failed native source belongs to the committed OTT Plex item"
+    );
+    plx_media::route::refuse_for_test(
+        &mut app.player.session,
+        plx_media::route::PlayVerdict::DirectPlayDisabled,
+    );
+    assert_eq!(
+        plx_media::player::state(&app.player.session),
+        plx_media::player::PlaybackState::Error,
+        "premise: the native stage failed after OTT admitted the Plex item"
+    );
+
+    runtime_tick(&mut app);
+
+    let runtime = app.ott.as_ref().unwrap();
+    assert_eq!(
+        runtime.play_target.as_ref().map(|target| target.0.as_str()),
+        Some(local_selection.as_str()),
+        "a native Plex refusal must follow the same skip policy as an outer resolver failure"
+    );
+    assert!(
+        runtime.resolver_next.as_ref().is_some_and(|next| {
+            next.profile.kind == ProviderKind::Local
+                && next.favorite.as_ref().is_some_and(|favorite| {
+                    format!("favorite:{}", favorite.identity()) == local_selection
+                })
+        }),
+        "the next request must be rebound through Local, not replay the failed Plex item"
+    );
+
+    // Do not let the deliberately injected verdict affect another test.
+    plx_media::route::cancel_play(&mut app.player.session);
+}
diff --git a/rust-modules/src/app/ott_runtime_tests/plex_refresh.rs b/rust-modules/src/app/ott_runtime_tests/plex_refresh.rs
new file mode 100644
index 0000000000000000000000000000000000000000..581ca70eb2def8d802a65bf836e904479c2f3b8f
--- /dev/null
+++ b/rust-modules/src/app/ott_runtime_tests/plex_refresh.rs
@@ -0,0 +1,235 @@
+//! A verified background source refresh updates listings, never playback intent.
+use super::*;
+use crate::app::ott_import;
+
+fn plex_row(id: &str) -> CatalogEntry {
+    let mut row = local_entry(id);
+    row.media = MediaLocator::Plex {
+        server_id: "refresh-fixture".into(),
+        rating_key: id.into(),
+    };
+    row
+}
+
+#[derive(Clone, Copy)]
+enum Intent {
+    Exit,
+    ExitWithFailedStartupCatalog,
+    Play,
+    Back,
+}
+
+fn plex_refresh_after_intent(intent: Intent) {
+    let _serial = plx_base::testlock::serial();
+    struct ResetPlex;
+    impl Drop for ResetPlex {
+        fn drop(&mut self) {
+            let _ = ott_import::set_authorized_sources(&[]);
+            plx_plex::plex::reset_servers_for_test();
+            plx_plex::plex::grant::reset_for_test();
+        }
+    }
+    let _plex = ResetPlex;
+    let _media = ResetMedia;
+    plx_plex::plex::grant::reset_for_test();
+    plx_plex::plex::reset_servers_for_test();
+    ott_import::set_authorized_sources(&[]).unwrap();
+    let source = plx_plex::plex::session::SourceRef {
+        machine_id: "refresh-fixture".into(),
+        address: "127.0.0.1".into(),
+        port: 1,
+        origin_url: "http://127.0.0.1:1".into(),
+        token: "fixture-token".into(),
+        ..Default::default()
+    };
+    let sid = plx_plex::plex::register_for_test(
+        &source.machine_id,
+        &source.address,
+        1,
+        &source.token,
+        "fixture-client",
+    );
+    plx_plex::plex::client_for(sid).unwrap().disable_data_io();
+    // Use the real authority check and matching synthetic registered server.
+    // The test proof only replaces the successful network-verification result.
+    ott_import::set_authorized_sources(std::slice::from_ref(&source)).unwrap();
+    let verified = ott_import::verified_source_for_test(source.clone());
+    let profile = ProviderProfile {
+        id: "plex-refresh-fixture".into(),
+        name: "Plex fixture".into(),
+        kind: ProviderKind::Plex,
+        source: source.machine_id.clone(),
+        source_alias: String::new(),
+        enabled: true,
+    };
+    let mut app = app_fixture();
+    mount_player(&mut app);
+    {
+        let runtime = app.ott.as_mut().unwrap();
+        runtime.saved.profiles.profiles = vec![profile.clone()];
+        runtime.saved.profiles.active_profile = Some(profile.id.clone());
+        runtime
+            .saved
+            .settings
+            .insert("nativePlexSources".into(), json!([source]));
+        runtime.provider = ProviderKind::Plex;
+        let startup_loading = matches!(intent, Intent::ExitWithFailedStartupCatalog);
+        runtime.catalog.entries = if startup_loading {
+            Vec::new()
+        } else {
+            vec![plex_row("first"), plex_row("second")]
+        };
+        runtime.catalog_loading = startup_loading;
+        runtime.catalog_complete = !startup_loading;
+        runtime.catalog_dirty = false;
+        runtime.catalog_done.store(false, Ordering::Release);
+        runtime.generation = 7;
+        runtime.continuity = continuity::Continuity::new(7, None);
+        runtime.continuity.user_selected(7, "first");
+        runtime.playing = Some(Playing {
+            profile,
+            entry: plex_row("first"),
+            selection_id: "first".into(),
+            source: None,
+        });
+        runtime.selected = Some("first".into());
+        runtime.resolver_busy = true;
+        runtime.saving = true;
+        runtime.plex_refresh_pending = true;
+    }
+    plx_media::route::install_plex_identity_for_test(&mut app.player.session, sid, "first");
+    plx_media::route::install_plex_request_for_test(&mut app.player.session, sid, "first");
+    match intent {
+        Intent::Exit | Intent::ExitWithFailedStartupCatalog => {
+            exit_through_content(&mut app);
+            runtime_tick(&mut app);
+            assert!(app.player.pending_exit.is_none());
+            assert!(app.ott.as_ref().unwrap().playing.is_none());
+        }
+        Intent::Play => app.ott.as_mut().unwrap().play("second").unwrap(),
+        Intent::Back => {
+            app.ott.as_mut().unwrap().page = "channels";
+            bridge::show_page(&mut app.pages, AppArg::Ott);
+            settle_pages(&mut app);
+            runtime_tick(&mut app);
+            settle_pages(&mut app);
+            let tick = next_tick(&mut app);
+            bridge::frame(
+                &mut app.pages,
+                &mut app.bridge,
+                tick,
+                bridge::script_key(plx_machine::machine::Key::Back, tick),
+            );
+            runtime_tick(&mut app);
+            settle_pages(&mut app);
+            assert_eq!(app.ott.as_ref().unwrap().page, "providers");
+            assert!(matches!(app.route(), AppArg::Ott));
+        }
+    }
+    let play_generation = app.ott.as_ref().unwrap().play_generation;
+    let catalog_generation = app.ott.as_ref().unwrap().generation;
+    if matches!(intent, Intent::ExitWithFailedStartupCatalog) {
+        let runtime = app.ott.as_ref().unwrap();
+        assert!(runtime.catalog_loading);
+        assert!(!runtime.catalog_done.load(Ordering::Acquire));
+        // Both completions are ready before the same frame. The runtime drains
+        // PlexRestored first, while the obsolete startup scan still says loading.
+        runtime
+            .catalog_tx
+            .send(CatalogEvent::Finished(
+                catalog_generation,
+                Err("Plex server is not connected"),
+            ))
+            .unwrap_or_else(|_| panic!("fixture catalogue receiver disappeared"));
+    }
+    app.ott
+        .as_ref()
+        .unwrap()
+        .tx
+        .send(Job::PlexRestored(vec![Ok(verified)]))
+        .unwrap_or_else(|_| panic!("fixture restore receiver disappeared"));
+    runtime_tick(&mut app);
+    let runtime = app.ott.as_ref().unwrap();
+    assert!(!runtime.plex_refresh_pending);
+    if matches!(intent, Intent::ExitWithFailedStartupCatalog) {
+        assert_ne!(
+            runtime.generation, catalog_generation,
+            "verified Plex restoration must supersede a failed startup scan in the same frame"
+        );
+        assert!(
+            runtime
+                .catalog_next
+                .as_ref()
+                .is_some_and(|profile| profile.id == "plex-refresh-fixture"),
+            "the replacement catalogue must remain queued while the old worker is held"
+        );
+    }
+    assert!(
+        runtime.catalog_loading,
+        "verified source must refresh its catalogue"
+    );
+    if matches!(intent, Intent::Back) {
+        assert_eq!(
+            runtime.page, "providers",
+            "a background source refresh must not navigate away from the user's page"
+        );
+    }
+    runtime
+        .catalog_tx
+        .send(CatalogEvent::Batch(
+            runtime.generation,
+            Catalog {
+                entries: vec![plex_row("refreshed-first")],
+            },
+        ))
+        .unwrap_or_else(|_| panic!("fixture catalogue receiver disappeared"));
+    runtime_tick(&mut app);
+
+    let runtime = app.ott.as_ref().unwrap();
+    assert_eq!(
+        runtime.play_generation, play_generation,
+        "background Plex refresh must not create a replacement playback request"
+    );
+    if matches!(
+        intent,
+        Intent::Exit | Intent::ExitWithFailedStartupCatalog | Intent::Back
+    ) {
+        assert!(
+            runtime.play_target.is_none() && runtime.resolver_next.is_none(),
+            "Plex restoration must preserve an explicit Exit or Back"
+        );
+        assert!(!matches!(app.route(), AppArg::Player));
+        if matches!(intent, Intent::Back) {
+            assert_eq!(runtime.page, "providers");
+        }
+    } else {
+        assert_eq!(runtime.play_target, Some(("second".into(), 0)));
+        assert!(
+            runtime.resolver_next.as_ref().is_some_and(|next| next
+                .entry
+                .as_ref()
+                .is_some_and(|entry| entry.id == "second")),
+            "Plex restoration must preserve the newer user selection"
+        );
+    }
+}
+
+#[test]
+fn plex_restoration_after_exit_does_not_reenable_autoplay() {
+    plex_refresh_after_intent(Intent::Exit);
+}
+
+#[test]
+fn plex_restoration_preserves_a_newer_play_request() {
+    plex_refresh_after_intent(Intent::Play);
+}
+
+#[test]
+fn plex_restoration_after_back_preserves_providers_page_without_autoplay() {
+    plex_refresh_after_intent(Intent::Back);
+}
+
+#[test]
+fn plex_restoration_retries_a_same_frame_startup_failure_without_reenabling_autoplay() {
+    plex_refresh_after_intent(Intent::ExitWithFailedStartupCatalog);
+}
diff --git a/rust-modules/src/app/ott_runtime_tests/restart.rs b/rust-modules/src/app/ott_runtime_tests/restart.rs
