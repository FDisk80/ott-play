+/// Verify a profile's explicit server token without granting it to the active account.
+/// This fixed read-only request is the only credential operation an import proof permits.
+/// Live requests continue to use the ordinary grant table after durable activation.
+pub fn request_import_probe(proof: &crate::plex::grant::ImportProof, token: &str) -> Result<Reply, Option<plx_net::net::RequestFailure>> {
+    let _guard = plx_base::task::assert_may_block(const { &plx_base::task::BlockingLabel::new("PMS import verification") });
+    if !proof.current() || token.is_empty() || token.len() > 1024 || token.chars().any(char::is_control) { return Err(None); }
+    let origin = proof.origin();
+    let header = format!("X-Plex-Token: {token}");
+    let headers = [ACCEPT_JSON, &header];
+    let policy = BodyPolicy::Probe { max: 1024 * 1024, timeout_s: 4, learn_pin: false };
