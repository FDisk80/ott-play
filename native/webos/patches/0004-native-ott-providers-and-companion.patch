+/// A validated UI type scale. Geometry and media caption sizes are independent.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct FontScale(u16);
+impl FontScale {
+    pub const DEFAULT: Self = Self(100);
+    pub const fn from_percent(percent: u16) -> Option<Self> {
+        if percent >= 50 && percent <= 150 { Some(Self(percent)) } else { None }
+    }
+    pub const fn percent(self) -> u16 { self.0 }
+    pub fn pixels(self, logical: i32) -> i32 {
+        if self == Self::DEFAULT { return logical; }
+        ((i64::from(logical) * i64::from(self.0) + 50) / 100)
+            .clamp(i64::from(i32::MIN), i64::from(i32::MAX)) as i32
+    }
+    pub fn points(self, logical: f32) -> f32 {
+        if self == Self::DEFAULT { logical } else { logical * (f32::from(self.0) / 100.0) }
+    }
+}
+impl Default for FontScale { fn default() -> Self { Self::DEFAULT } }
+
+/// Converts logical UI type sizes before the wrapped capability observes them.
+/// In particular a recorder receives physical sizes, so UI and media captions
+/// never record conflicting answers under the same metric key.
+pub struct TypographyMeasure<M> { inner: M, scale: FontScale }
+impl<M> TypographyMeasure<M> {
+    pub const fn new(inner: M) -> Self { Self { inner, scale: FontScale::DEFAULT } }
+    pub fn set_font_scale(&mut self, scale: FontScale) { self.scale = scale; }
+    pub const fn scale(&self) -> FontScale { self.scale }
+}
+impl<M> std::ops::Deref for TypographyMeasure<M> {
+    type Target = M;
+    fn deref(&self) -> &M { &self.inner }
+}
