+    fn publish(&self, app: &mut App) {
+        if let Some(instance) = self.reply {
+            app.pages.emit(
+                MachineId::Nav,
+                Fx::Deliver(
+                    MachineId::Instance(instance),
+                    Delivery::Screen(plx_ui::screen::ScreenEvent::App(AppMsg::OttSnapshot(
+                        Arc::new(self.view()),
+                    ))),
+                ),
+            );
