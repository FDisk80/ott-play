+//! Read existing local media in bounded batches. Runs on the catalogue worker, never the UI.
+//! No imports, thumbnails, duration probes or copies are made while walking the tree.
+use plx_data::ott::{self, CatalogEntry, LocalFile, MediaLocator, ProviderKind, ProviderProfile};
+use std::collections::VecDeque;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+const BATCH_SIZE: usize = 64;
+const DIRECTORY_LIMIT: usize = 20_000;
+const ENTRY_LIMIT: usize = 500_000;
+const PENDING_PATH_BYTES: usize = 8 * 1024 * 1024;
+const DEPTH_LIMIT: usize = 64;
+
+/// A cancelled scan has no claim about the unseen remainder of its tree.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) struct ScanReport {
+    pub videos: usize,
+    pub directories: usize,
+    pub inspected: usize,
+    pub skipped: usize,
+    pub cancelled: bool,
+}
+
+pub(super) fn visit(
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    let report = visit_report(profile, cancel, emit)?;
+    outcome(report)
+}
+
+fn outcome(report: ScanReport) -> Result<(), &'static str> {
+    if !report.cancelled && report.skipped > 0 {
+        Err("Some local folders or files were unavailable; the readable videos remain available")
+    } else {
+        Ok(())
+    }
+}
+
+fn root(profile: &ProviderProfile) -> Result<PathBuf, &'static str> {
+    profile.validate().map_err(|_| "Invalid local profile")?;
+    if profile.kind != ProviderKind::Local || !Path::new(&profile.source).is_absolute() {
+        return Err("Local source is not a device folder");
+    }
+    let root = std::fs::canonicalize(&profile.source).map_err(|_| "Local folder is unavailable")?;
+    if !root.is_dir() {
+        return Err("Local source is not a folder");
+    }
+    Ok(root)
+}
+
+/// Do not collect or sort a whole directory before publishing the first media item.
+/// IDs derive from relative names, not the filesystem's unspecified enumeration order.
+pub(super) fn visit_report(
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<(), &'static str>,
+) -> Result<ScanReport, &'static str> {
+    let mut report = ScanReport::default();
+    if cancelled(cancel, &mut report) {
+        return Ok(report);
+    }
+    let root = root(profile)?;
+    let mut pending = VecDeque::from([(root.clone(), 0usize)]);
+    let mut pending_bytes = root.as_os_str().len();
+    let mut files = Vec::with_capacity(BATCH_SIZE);
+    while let Some((folder, depth)) = pending.pop_front() {
+        pending_bytes = pending_bytes.saturating_sub(folder.as_os_str().len());
+        if cancelled(cancel, &mut report) {
+            return Ok(report);
+        }
+        let canonical = match checked_path(&root, &folder, true) {
+            Ok(path) => path,
+            Err(_) if depth > 0 => {
+                report.skipped += 1;
+                continue;
+            }
+            Err(reason) => return Err(reason),
+        };
+        report.directories += 1;
+        if report.directories > DIRECTORY_LIMIT {
+            flush(profile, cancel, &mut report, &mut files, emit)?;
+            return Err("Local folder limit reached");
+        }
+        let directory = match std::fs::read_dir(&canonical) {
+            Ok(value) => value,
+            Err(_) if depth > 0 => {
+                report.skipped += 1;
+                continue;
+            }
+            Err(_) => return Err("Local folder cannot be read"),
+        };
+        for child in directory {
+            if cancelled(cancel, &mut report) {
+                return Ok(report);
+            }
+            report.inspected += 1;
+            if report.inspected > ENTRY_LIMIT {
+                flush(profile, cancel, &mut report, &mut files, emit)?;
+                return Err("Local directory entry limit reached");
+            }
+            let child = match child {
+                Ok(value) => value,
+                Err(_) => {
+                    report.skipped += 1;
+                    continue;
+                }
+            };
+            let kind = match child.file_type() {
+                Ok(value) => value,
+                Err(_) => {
+                    report.skipped += 1;
+                    continue;
+                }
+            };
+            // Symlinks are not registrations of additional roots and are never followed.
+            if kind.is_symlink() {
+                continue;
+            }
+            let path = child.path();
+            if kind.is_dir() {
+                if depth >= DEPTH_LIMIT {
+                    report.skipped += 1;
+                    continue;
+                }
+                let bytes = path.as_os_str().len();
+                if pending.len() >= DIRECTORY_LIMIT
+                    || pending_bytes.saturating_add(bytes) > PENDING_PATH_BYTES
+                {
+                    flush(profile, cancel, &mut report, &mut files, emit)?;
+                    return Err("Local pending folder limit reached");
+                }
+                pending_bytes += bytes;
+                pending.push_back((path, depth + 1));
+                continue;
+            }
+            if !kind.is_file() {
+                continue;
+            }
+            let Some(relative) = relative_name(&root, &path, &mut report) else {
+                continue;
+            };
+            if !ott::is_local_video_path(relative) {
+                continue;
+            }
+            if !ott::valid_local_relative_path(relative)
+                || checked_path(&root, &path, false).is_err()
+            {
+                report.skipped += 1;
+                continue;
+            }
+            if report.videos >= ott::MAX_CATALOG_ENTRIES {
+                flush(profile, cancel, &mut report, &mut files, emit)?;
+                return Err("Local video limit reached");
+            }
+            report.videos += 1;
+            files.push(LocalFile {
+                relative_path: relative.to_owned(),
+                size: 0,
+                duration_ms: None,
+            });
+            if report.videos == 1 || files.len() >= BATCH_SIZE {
+                flush(profile, cancel, &mut report, &mut files, emit)?;
+                if report.cancelled {
+                    return Ok(report);
+                }
+            }
+        }
+        // A small last batch need not wait for the next subtree's first directory read.
+        flush(profile, cancel, &mut report, &mut files, emit)?;
+        if report.cancelled {
+            return Ok(report);
+        }
+    }
+    Ok(report)
+}
+
+fn cancelled(cancel: &AtomicBool, report: &mut ScanReport) -> bool {
+    report.cancelled = cancel.load(Ordering::Acquire);
+    report.cancelled
+}
+
+fn relative_name<'a>(root: &Path, path: &'a Path, report: &mut ScanReport) -> Option<&'a str> {
+    let name = path.strip_prefix(root).ok().and_then(Path::to_str);
+    if name.is_none() {
+        report.skipped += 1;
+    }
+    name
+}
+
+fn flush(
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    report: &mut ScanReport,
+    files: &mut Vec<LocalFile>,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    if cancelled(cancel, report) || files.is_empty() {
+        return Ok(());
+    }
+    let batch = ott::catalog_from_local_files(files, profile)
+        .map_err(|_| "Local file has an invalid name")?;
+    files.clear();
+    if cancelled(cancel, report) {
+        return Ok(());
+    }
+    emit(batch.entries)
+}
+
+/// Revalidate at selection: an old catalogue row is not permission to leave the selected root.
+pub(super) fn resolve(
+    profile: &ProviderProfile,
+    entry: &CatalogEntry,
+) -> Result<PathBuf, &'static str> {
+    let MediaLocator::Local { relative_path } = &entry.media else {
+        return Err("Media is not a local file");
+    };
+    if !ott::valid_local_relative_path(relative_path) {
+        return Err("Invalid local media path");
+    }
+    let root = root(profile)?;
+    checked_path(&root, &root.join(relative_path), false)
+}
+
+fn checked_path(root: &Path, path: &Path, directory: bool) -> Result<PathBuf, &'static str> {
+    let relative = path
+        .strip_prefix(root)
+        .map_err(|_| "Local path escaped its folder")?;
+    let mut cursor = root.to_path_buf();
+    for component in relative.components() {
+        let std::path::Component::Normal(name) = component else {
+            return Err("Invalid local media path");
+        };
+        cursor.push(name);
+        let kind = std::fs::symlink_metadata(&cursor)
+            .map_err(|_| "Local media is unavailable")?
+            .file_type();
+        if kind.is_symlink() {
+            return Err("Local media link is outside its registration");
+        }
+    }
+    let canonical = std::fs::canonicalize(path).map_err(|_| "Local media is unavailable")?;
+    if !canonical.starts_with(root) {
+        return Err("Local path escaped its folder");
+    }
+    let kind = std::fs::symlink_metadata(&canonical)
+        .map_err(|_| "Local media is unavailable")?
+        .file_type();
+    if (directory && !kind.is_dir()) || (!directory && !kind.is_file()) {
+        return Err("Local media type changed");
+    }
+    Ok(canonical)
+}
