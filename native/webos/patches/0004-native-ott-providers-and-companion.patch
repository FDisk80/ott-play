+    fn import_plex(
+        &mut self,
+        profile: super::ott_profile::Profile,
+        invocation: Invocation,
+    ) -> Result<(), &'static str> {
+        if !self.loaded || self.saving {
+            return Err("Another settings operation is in progress");
