+        let changed=String::from_utf8(std::mem::take(&mut encoded)).unwrap().replace("\"Film\"","\"Renamed\"");
+        let incoming=Document::parse(changed.as_bytes()).unwrap(); let (id,bytes)=f.begin(&incoming);
