+            kind: ProviderKind::M3u,
+            source: "https://example.test/channels.m3u".into(),
+            source_alias: String::new(),
+            enabled: true,
+        });
+        saved.profiles.active_profile = Some("m3u-profile".into());
+        saved.settings.insert("slot:m3u-profile".into(), json!(7));
+        saved
+    }
+
+    #[test]
+    fn context_uses_sparse_slot_and_changes_with_source() {
+        let mut saved = saved();
+        let before = setting_context(&saved, ProviderKind::M3u, "runtime:1", &[1; 16]);
+        assert_eq!(before["profile"], 7);
+        assert_eq!(before["provider"], "m3u");
+        saved.profiles.profiles[0].source = "https://example.test/other.m3u".into();
+        let after = setting_context(&saved, ProviderKind::M3u, "runtime:1", &[1; 16]);
+        assert_ne!(before["token"], after["token"]);
+        assert!(!after.to_string().contains("example.test"));
+        assert_ne!(
+            after["token"],
+            setting_context(&saved, ProviderKind::M3u, "runtime:2", &[1; 16])["token"]
+        );
+        assert_ne!(
+            after["token"],
+            setting_context(&saved, ProviderKind::M3u, "runtime:1", &[2; 16])["token"]
+        );
+        assert_eq!(
+            setting_context(&saved, ProviderKind::Local, "runtime:1", &[1; 16])["profile"],
+            Value::Null
+        );
+    }
+
+    #[test]
+    fn font_scale_rejects_noninteger_and_out_of_range_values() {
+        for value in [
+            json!(-1),
+            json!(0),
+            json!(49),
+            json!(151),
+            json!(100.5),
+            json!("100"),
+            Value::Null,
+            json!(true),
+        ] {
+            assert!(!Setting::FontScale.valid(&value), "{value}");
+        }
+        for value in [json!(50), json!(100), json!(150)] {
+            assert!(Setting::FontScale.valid(&value), "{value}");
+        }
+        let descriptor = Setting::FontScale.descriptor();
+        assert_eq!(descriptor["constraints"]["minimum"], 50);
+        assert_eq!(descriptor["constraints"]["maximum"], 150);
+        assert_eq!(descriptor["access"]["write"], true);
+        assert_eq!(descriptor["default_value"], 100);
+    }
+
+    #[test]
+    fn choice_descriptors_include_cli_required_aliases() {
+        for (setting, label, alias) in [
+            (Setting::Player, "Native", "native"),
+            (Setting::Interface, "Modern", "modern"),
+        ] {
+            let descriptor = setting.descriptor();
+            let choices = descriptor["choices"].as_array().unwrap();
+            assert_eq!(choices.len(), 1);
+            assert!(fields(&choices[0], &["value", "label", "aliases"]));
+            assert_eq!(choices[0]["value"], setting.default());
+            assert_eq!(choices[0]["label"], label);
+            assert_eq!(choices[0]["aliases"], json!([alias]));
+        }
+    }
+
+    #[test]
+    fn stored_value_reports_invalid_without_echoing_it() {
+        let mut saved = saved();
+        assert_eq!(stored(&saved, Setting::FontScale)["storage"], "default");
+        saved
+            .settings
+            .insert("uiFontScale".into(), json!("invalid"));
+        let invalid = stored(&saved, Setting::FontScale);
+        assert_eq!(invalid["storage"], "invalid");
+        assert_eq!(invalid["value"], 100);
+        assert!(invalid.get("persisted_value").is_none());
+        saved.settings.insert("uiFontScale".into(), json!(120));
+        let valid = stored(&saved, Setting::FontScale);
+        assert_eq!(valid["storage"], "stored");
+        assert_eq!(valid["persisted_value"], 120);
+    }
+
+    #[test]
+    fn revisions_are_single_use_bound_to_storage_source_and_expiration() {
+        let mut saved = saved();
+        let context = setting_context(&saved, ProviderKind::M3u, "runtime:1", &[1; 16])["token"]
+            .as_str()
+            .unwrap()
+            .to_owned();
+        let mut receipts = Receipts::default();
+        let sig = signature(&saved, Setting::FontScale);
+        let token = receipts.record("setting:read", sig.clone(), context.clone(), 0, 10);
+        assert!(receipts.consume(&token, &sig, &context, 0, 11));
+        assert!(!receipts.consume(&token, &sig, &context, 0, 12));
+        let token = receipts.record("setting:changed", sig.clone(), context.clone(), 0, 10);
+        saved.settings.insert("uiFontScale".into(), json!(120));
+        assert!(!receipts.consume(
+            &token,
+            &signature(&saved, Setting::FontScale),
+            &context,
+            0,
+            11
+        ));
+        let token = receipts.record("setting:source", sig.clone(), context.clone(), 0, 10);
+        assert!(!receipts.consume(&token, &sig, "another-source", 0, 11));
+        let token = receipts.record("setting:expired", sig.clone(), context.clone(), 0, 10);
+        assert!(!receipts.consume(&token, &sig, &context, 0, 120010));
+    }
+
+    #[test]
+    fn restoring_the_same_value_does_not_restore_an_old_revision() {
+        let mut saved = saved();
+        saved.settings.insert("uiFontScale".into(), json!(100));
+        let before = signature(&saved, Setting::FontScale);
+        saved.settings.insert("uiFontScale".into(), json!(120));
+        saved
+            .settings
+            .insert(revision_key(Setting::FontScale), json!("write:1"));
+        saved.settings.insert("uiFontScale".into(), json!(100));
+        saved
+            .settings
+            .insert(revision_key(Setting::FontScale), json!("write:2"));
+        assert_ne!(signature(&saved, Setting::FontScale), before);
+    }
+
+    #[test]
+    fn schema_pages_validate_limits_fields_and_source_cursor() {
+        let context = json!({"token":"context:1"});
+        assert_eq!(
+            schema_page(&json!({"op":"schema","runtime":"runtime:1"}), &context),
+            Ok((0, 20))
+        );
+        assert_eq!(
+            schema_page(
+                &json!({"op":"schema","runtime":"runtime:1","limit":1,"cursor":"context:1:2"}),
+                &context
+            ),
+            Ok((2, 1))
+        );
+        for limit in [json!(0), json!(21), json!("1"), json!(1.5)] {
+            assert_eq!(
+                schema_page(
+                    &json!({"op":"schema","runtime":"runtime:1","limit":limit}),
+                    &context
+                ),
+                Err("invalid_request")
+            );
+        }
+        assert_eq!(
+            schema_page(
+                &json!({"op":"schema","runtime":"runtime:1","unexpected":true}),
+                &context
+            ),
+            Err("invalid_request")
+        );
+        assert_eq!(
+            schema_page(
+                &json!({"op":"schema","runtime":"runtime:1","cursor":"context:2:1"}),
+                &context
+            ),
+            Err("source_changed")
+        );
+        assert_eq!(
+            schema_page(
+                &json!({"op":"schema","runtime":"runtime:1","cursor":"context:1:4"}),
+                &context
+            ),
+            Err("invalid_request")
+        );
+        assert_eq!(
+            schema_page(
+                &json!({"op":"schema","runtime":"runtime:1","cursor":"context:1:-1"}),
+                &context
+            ),
+            Err("source_changed")
+        );
+    }
+}
diff --git a/rust-modules/src/app/ott_standby.rs b/rust-modules/src/app/ott_standby.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c6b4b5d1f5b2ef605b0327e660a8bb799dadf4e2
--- /dev/null
+++ b/rust-modules/src/app/ott_standby.rs
@@ -0,0 +1,164 @@
+//! Application Standby uses the player's existing foreground park and restore.
+//! The caller retires pending OTT catalogue work before entering; this adapter
+//! deliberately does not borrow `App::ott`, which may be owned by its dispatcher.
+
+use super::{bridge, content, lifecycle, run, App};
+
+/// A swallowed release must not leave either input implementation holding a
+/// press. Use their normal cancellation paths so the visual spring can finish
+/// without emitting a Hold/Commit on the covered screen.
+fn cancel_interaction(
+    shared: &mut plx_ui::input::InputMachine<u32>,
+    legacy: &mut plx_ui::press::Press,
+    down_sym: &mut u32,
+    ok_armed: &mut bool,
+    pointer: &mut super::input::Pointer,
+    queued: &mut Vec<plx_machine::machine::InputEvent<u32>>,
+) {
+    shared.cancel_press();
+    legacy.cancel();
+    *down_sym = 0;
+    *ok_armed = false;
+    pointer.button_down = false;
+    pointer.ok_from_click = false;
+    pointer.edge.stop();
+    queued.clear();
+}
+
+/// Set the logical Standby state; return whether that state changed.
+///
+/// Repeated Standby reasserts suspension if new playback work appeared, while
+/// retaining an already parked session's position and viewer pause. Wake only
+/// claims that session when the operating system grants foreground permission;
+/// otherwise its ordinary DID-foreground edge performs the restore later.
+/// The return value describes the state change, not completion of a native Load.
+pub(super) fn set(app: &mut App, standby: bool) -> bool {
+    let changed = app.ott_standby != standby;
+    app.ott_standby = standby;
+
+    if standby || changed {
+        cancel_interaction(
+            &mut app.pages.input,
+            &mut app.input.press,
+            &mut app.down_sym,
+            &mut app.ok_armed,
+            &mut app.ptr,
+            &mut app.inputs,
+        );
+    }
+
+    if standby {
+        // Give mounted editors and screens the same suspension event as an OS
+        // background, retaining the page stack for the eventual wake.
+        bridge::background(&mut app.pages);
+        // These paths must not independently restore a session held by Standby.
+        app.foreground_retry = None;
+        app.decoder_parked = false;
+
+        // A preview is ended, never restored as ordinary playback.
+        content::halt_preview_now(&mut app.player.session, &mut app.adapters.player);
+        let flight_parked = lifecycle::park_pending_foreground_flight(
+            &mut app.player.lifecycle,
+            &mut app.player.session,
+            &mut app.adapters.player,
+        );
+
+        // A resolve can own playback before the Player page mounts. Conversely,
+        // an already suspended session must not capture the suspension's pause
+        // or overwrite its saved position on another Standby command.
+        let needs_park = !app.player.lifecycle.awaiting_load()
+            && !plx_media::route::preview_request(&app.player.session)
+            && (plx_media::route::play_pending()
+                || app.adapters.player.is_live()
+                || plx_media::route::has_url(&app.player.session));
+        if needs_park {
+            run::park_playback(app);
+        }
+        if changed || flight_parked || needs_park {
+            plx_machine::idle::invalidate();
+        }
+    } else if changed {
+        if app.window_activity.allow_present(true) {
+            bridge::foreground(&mut app.pages);
+            if app.player.lifecycle.claimable_clock().is_some() {
+                run::claim_parked_foreground(app, lifecycle::ForegroundInput::DidForeground);
+            }
+        }
+        plx_machine::idle::invalidate();
+    }
+
+    changed
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use plx_machine::machine::{
+        Edge, EntryId, FocusKey, InputEvent, InputKind, InstanceId, Key, MachineId, PressArm,
+        PressFrom, Source, Tick,
+    };
+
+    #[test]
+    fn standby_cancels_held_and_click_presses_even_when_the_release_is_swallowed() {
+        for (from, holdable) in [(PressFrom::Key, true), (PressFrom::Pointer, false)] {
+            let mut shared = plx_ui::input::InputMachine::new();
+            shared.arm(
+                PressArm {
+                    key: FocusKey {
+                        entry: EntryId(1),
+                        elem: 7_u32,
+                    },
+                    from,
+                    holdable,
+                },
+                MachineId::Instance(InstanceId(1)),
+                1_000,
+            );
+            let mut legacy = plx_ui::press::Press::new();
+            legacy.begin(1_000);
+            let mut down_sym = 13;
+            let mut ok_armed = true;
+            let mut pointer = super::super::input::Pointer::IDLE;
+            pointer.button_down = true;
+            pointer.ok_from_click = true;
+            let mut queued = vec![InputEvent {
+                at: Tick {
+                    ms: 1_000,
+                    dt_us: 0,
+                },
+                source: Source::Script,
+                kind: InputKind::Key {
+                    key: Key::Ok,
+                    sym: 13,
+                    wcode: 0,
+                    edge: Edge::Down,
+                    at_edge: false,
+                },
+            }];
+
+            cancel_interaction(
+                &mut shared,
+                &mut legacy,
+                &mut down_sym,
+                &mut ok_armed,
+                &mut pointer,
+                &mut queued,
+            );
+            // The physical key/button-up is swallowed by Standby. Continue the
+            // normal frame clock beyond both long-press and lost-release delays.
+            for frame in 1..=160 {
+                let now = 1_000 + frame * 16;
+                assert!(
+                    shared.tick(now, 0.016).is_empty(),
+                    "covered control activated"
+                );
+                legacy.tick(now, 0.016);
+                assert!(!legacy.take_commit(now), "legacy control activated");
+            }
+            assert!(shared.arm.is_none());
+            assert!(queued.is_empty(), "queued pre-Standby input survived");
+            assert_eq!(down_sym, 0);
+            assert!(!ok_armed && !pointer.button_down && !pointer.ok_from_click);
+        }
+    }
+}
diff --git a/rust-modules/src/app/ott_vportal.rs b/rust-modules/src/app/ott_vportal.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c6c2602f15302e95d686c2123aed82ad3424ec7a
--- /dev/null
+++ b/rust-modules/src/app/ott_vportal.rs
@@ -0,0 +1,454 @@
+//! VPortal IO adapter. The parser retains folder metadata and page parameters;
+//! this runner owns bounded traversal and publishes playable rows incrementally.
+use plx_base::task::{time::Deadline, OffFrame};
+use plx_data::ott::{
+    self, CatalogEntry, MediaLocator, PortalRequest, ProviderKind, ProviderProfile,
+};
+use serde_json::Value;
+use std::collections::{HashMap, HashSet};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+
+const PAGE_LIMIT: usize = 4096;
+const DEPTH_LIMIT: usize = 128;
+const BATCH_SIZE: usize = 64;
+const CANCELLED: &str = "VPortal request cancelled";
+type Result<T> = std::result::Result<T, &'static str>;
+
+type Fetch<'a> = dyn FnMut(&str, &Value, &AtomicBool) -> Result<String> + 'a;
+
+fn active(cancel: &AtomicBool) -> Result<()> {
+    if cancel.load(Ordering::Acquire) {
+        Err(CANCELLED)
+    } else {
+        Ok(())
+    }
+}
+
+/// A blocking request is bounded to 25 seconds. Its result is discarded if the
+/// owner cancelled while libcurl was running. Playback resolution instead hands
+/// its lease to the caller for cleanup before that caller checks cancellation.
+fn fetch(endpoint: &str, body: &Value, cancel: &AtomicBool) -> Result<String> {
+    active(cancel)?;
+    if ott::http_url(endpoint).is_none() {
+        return Err("Invalid VPortal address");
+    }
+    let bytes = serde_json::to_vec(body).map_err(|_| "Invalid VPortal request")?;
+    if bytes.len() > ott::MAX_REQUEST_BYTES + 2048 {
+        return Err("VPortal request is too large");
+    }
+    let response = plx_net::net::request(
+        endpoint,
+        &["Content-Type: application/json".into()],
+        "POST",
+        Some(&bytes),
+        plx_net::net::Timeouts {
+            connect_s: 8,
+            total_s: 25,
+            total_ms: 0,
+            low_speed_bps: 1,
+            low_speed_s: 10,
+        },
+        false,
+        Some(ott::MAX_CATALOG_BYTES),
+        None,
+    );
+    let response = response.ok_or("VPortal request failed or timed out")?;
+    if !response.ok() {
+        return Err("VPortal rejected the request");
+    }
+    String::from_utf8(response.body).map_err(|_| "VPortal returned invalid text")
+}
+
+fn link(profile: &ProviderProfile) -> Result<ott::PortalLink> {
+    profile.validate().map_err(|_| "Invalid VPortal profile")?;
+    if profile.kind != ProviderKind::VPortal {
+        return Err("Invalid VPortal profile");
+    }
+    ott::parse_vportal_link(&profile.source).map_err(|_| "Invalid VPortal link")
+}
+
+fn request(
+    link: &ott::PortalLink,
+    params: &Value,
+    cancel: &AtomicBool,
+    fetch: &mut Fetch<'_>,
+) -> Result<String> {
+    active(cancel)?;
+    let body = link
+        .request_body(params)
+        .map_err(|_| "Invalid VPortal request")?;
+    let text = fetch(&link.endpoint, &body, cancel)?;
+    if text.len() > ott::MAX_CATALOG_BYTES {
+        return Err("VPortal response is too large");
+    }
+    Ok(text)
+}
+
+struct Path {
+    request: Arc<str>,
+    parent: Option<Arc<Path>>,
+    category: String,
+    depth: usize,
+}
+impl Path {
+    fn contains(&self, request: &str) -> bool {
+        let mut at = Some(self);
+        while let Some(path) = at {
+            if path.request.as_ref() == request {
+                return true;
+            }
+            at = path.parent.as_deref();
+        }
+        false
+    }
+}
+struct Job {
+    page: PortalRequest,
+    parent: Option<Arc<Path>>,
+}
+
+pub(super) fn visit(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<()>,
+) -> Result<()> {
+    visit_with(worker, profile, cancel, emit, &mut fetch)
+}
+
+pub(super) fn visit_before(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<()>,
+    deadline: Deadline,
+) -> Result<()> {
+    visit_with_deadline(worker, profile, cancel, emit, Some(deadline), &mut fetch)
+}
+
+fn visit_with(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<()>,
+    fetch: &mut Fetch<'_>,
+) -> Result<()> {
+    visit_with_deadline(worker, profile, cancel, emit, None, fetch)
+}
+
+fn within_deadline(worker: &OffFrame, deadline: Option<Deadline>) -> Result<()> {
+    if deadline.is_some_and(|at| at.expired(worker)) {
+        Err("VPortal catalogue lookup timed out")
+    } else {
+        Ok(())
+    }
+}
+
+fn visit_with_deadline(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<()>,
+    deadline: Option<Deadline>,
+    fetch: &mut Fetch<'_>,
+) -> Result<()> {
+    let link = link(profile)?;
+    let mut root = PortalRequest::root();
+    root.request["limit"] = Value::from(300);
+    let mut queued_bytes = root.byte_len();
+    let mut jobs = vec![Job {
+        page: root,
+        parent: None,
+    }];
+    let mut seen = HashSet::new();
+    let mut seen_bytes = 0usize;
+    let mut rows_seen: HashMap<String, String> = HashMap::new();
+    let mut row_bytes = 0usize;
+    let mut emitted = false;
+    while let Some(mut job) = jobs.pop() {
+        active(cancel)?;
+        within_deadline(worker, deadline)?;
+        queued_bytes = queued_bytes.saturating_sub(job.page.byte_len());
+        job.page.request["limit"] = Value::from(300);
+        let key = job
+            .page
+            .identity()
+            .map_err(|_| "Invalid VPortal page request")?;
+        if job.parent.as_ref().is_some_and(|path| path.contains(&key)) {
+            return Err("VPortal catalogue contains a page loop");
+        }
+        // Folder aliases are legitimate. Only the same request in the same
+        // category is redundant; the ancestor check catches recursive aliases.
+        let identity = (key.clone(), job.page.category.clone());
+        if seen.contains(&identity) {
+            continue;
+        }
+        seen_bytes = seen_bytes.saturating_add(key.len() + job.page.category.len());
+        if seen.len() >= PAGE_LIMIT || seen_bytes > ott::MAX_CATALOG_BYTES {
+            return Err("VPortal catalogue page limit reached");
+        }
+        seen.insert(identity);
+        let depth = job.parent.as_ref().map_or(1, |parent| {
+            parent.depth + usize::from(parent.category != job.page.category)
+        });
+        if depth > DEPTH_LIMIT {
+            return Err("VPortal catalogue nesting limit reached");
+        }
+        let path = Arc::new(Path {
+            request: Arc::from(key),
+            parent: job.parent,
+            category: job.page.category.clone(),
+            depth,
+        });
+        let text = request(&link, &job.page.request, cancel, fetch)?;
+        active(cancel)?;
+        within_deadline(worker, deadline)?;
+        let page = job
+            .page
+            .parse_response(&text, profile)
+            .map_err(|_| "Invalid or incomplete VPortal catalogue")?;
+        active(cancel)?;
+        let mut batch = Vec::with_capacity(BATCH_SIZE);
+        for entry in page.catalog.entries {
+            let encoded =
+                serde_json::to_string(&entry).map_err(|_| "Invalid VPortal catalogue row")?;
+            if rows_seen.get(&entry.id) == Some(&encoded) {
+                continue;
+            }
+            let old_bytes = rows_seen.get(&entry.id).map_or(0, String::len);
+            row_bytes = row_bytes
+                .saturating_sub(old_bytes)
+                .saturating_add(encoded.len());
+            if row_bytes > ott::MAX_CATALOG_MODEL_BYTES {
+                return Err("VPortal catalogue metadata limit reached");
+            }
+            rows_seen.insert(entry.id.clone(), encoded);
+            if rows_seen.len() > ott::MAX_CATALOG_ENTRIES {
+                return Err("VPortal catalogue entry limit reached");
+            }
+            batch.push(entry);
+            // A playable first row must not wait for sibling folders or pages.
+            if !emitted || batch.len() >= BATCH_SIZE {
+                active(cancel)?;
+                emit(std::mem::take(&mut batch))?;
+                active(cancel)?;
+                emitted = true;
+            }
+        }
+        if !batch.is_empty() {
+            active(cancel)?;
+            emit(batch)?;
+            active(cancel)?;
+        }
+        // Depth-first traversal reaches a playable leaf before fetching the
+        // remaining root pages. Reverse push preserves provider ordering.
+        for pending in page.pending.into_iter().rev() {
+            queued_bytes = queued_bytes.saturating_add(pending.byte_len());
+            if jobs.len() >= PAGE_LIMIT || queued_bytes > ott::MAX_CATALOG_BYTES {
+                return Err("VPortal catalogue queue limit reached");
+            }
+            jobs.push(Job {
+                page: pending,
+                parent: Some(path.clone()),
+            });
+        }
+    }
+    active(cancel)
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub(super) struct SessionHints {
+    pub stop: String,
+    pub heartbeat: Option<String>,
+}
+impl std::fmt::Debug for SessionHints {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("SessionHints(<private>)")
+    }
+}
+
+#[derive(PartialEq, Eq)]
+pub(super) struct Resolution {
+    pub url: String,
+    pub session: Option<SessionHints>,
+    pub failure: Option<&'static str>,
+}
+impl std::fmt::Debug for Resolution {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("Resolution(<private>)")
+    }
+}
+
+/// The caller must adopt `session` before checking its generation/cancel flag.
+/// A successful response that arrived after cancellation still owns server
+/// resources: dropping the adopted lease releases them without starting video.
+pub(super) fn resolve_typed(
+    profile: &ProviderProfile,
+    entry: &CatalogEntry,
+    cancel: &AtomicBool,
+) -> Result<Resolution> {
+    resolve_with(profile, entry, cancel, &mut fetch)
+}
+
+fn playable_url(endpoint: &str, value: Option<&Value>) -> Option<String> {
+    let value = value?.as_str()?;
+    if value.trim().is_empty() {
+        return None;
+    }
+    ott::resolve_http_url(endpoint, value)
+}
+
+fn resolve_with(
+    profile: &ProviderProfile,
+    entry: &CatalogEntry,
+    cancel: &AtomicBool,
+    fetch: &mut Fetch<'_>,
+) -> Result<Resolution> {
+    active(cancel)?;
+    let link = link(profile)?;
+    match &entry.media {
+        MediaLocator::Http { url } => Ok(Resolution {
+            url: ott::http_url(url).ok_or("Invalid VPortal playback address")?,
+            session: None,
+            failure: None,
+        }),
+        MediaLocator::VPortal { request: params } => {
+            let text = request(&link, params, cancel, fetch)?;
+            let data: Value =
+                serde_json::from_str(&text).map_err(|_| "Invalid VPortal playback response")?;
+            if data.get("type").and_then(Value::as_str) == Some("error") {
+                return failed_resolution(
+                    &link.endpoint,
+                    &data,
+                    "VPortal could not resolve this video",
+                );
+            }
+            let selected = data
+                .get("url")
+                .filter(|value| playable_url(&link.endpoint, Some(value)).is_some())
+                .or_else(|| {
+                    data.get("variants")
+                        .and_then(Value::as_object)
+                        .and_then(|variants| {
+                            variants
+                                .values()
+                                .find(|value| playable_url(&link.endpoint, Some(value)).is_some())
+                        })
+                });
+            let Some(selected) = selected else {
+                return failed_resolution(
+                    &link.endpoint,
+                    &data,
+                    "VPortal returned no playable source",
+                );
+            };
+            let url = playable_url(&link.endpoint, Some(selected))
+                .ok_or("Invalid VPortal playback address")?;
+            let session =
+                session_hints(&link.endpoint, &data, selected.as_str().unwrap_or(""), &url);
+            Ok(Resolution {
+                url,
+                session,
+                failure: None,
+            })
+        }
+        _ => Err("Invalid VPortal media locator"),
+    }
+}
+
+fn failed_resolution(endpoint: &str, data: &Value, message: &'static str) -> Result<Resolution> {
+    // A failed playback response may still own the top-level allocated session.
+    // Do not adopt arbitrary unselected entries from the variants session map.
+    let session = data
+        .get("stop")
+        .and_then(Value::as_str)
+        .and_then(|stop| session_url(endpoint, stop))
+        .map(|stop| SessionHints {
+            stop,
+            heartbeat: None,
+        });
+    if session.is_none() {
+        return Err(message);
+    }
+    Ok(Resolution {
+        url: String::new(),
+        session,
+        failure: Some(message),
+    })
+}
+
+fn session_hints(
+    endpoint: &str,
+    data: &Value,
+    selected: &str,
+    normalized: &str,
+) -> Option<SessionHints> {
+    let hints = data
+        .get("sessions")
+        .and_then(Value::as_object)
+        .and_then(|sessions| sessions.get(selected).or_else(|| sessions.get(normalized)))
+        .or_else(|| {
+            (playable_url(endpoint, data.get("url")).as_deref() == Some(normalized)).then_some(data)
+        })?;
+    let stop = session_url(endpoint, hints.get("stop")?.as_str()?)?;
+    let heartbeat = hints
+        .get("heartbeat")
+        .and_then(Value::as_str)
+        .and_then(|value| session_url(endpoint, value));
+    Some(SessionHints { stop, heartbeat })
+}
+
+/// Session control exists only for an explicitly selected NAS API origin.
+/// The narrow path grammar cannot turn a provider response into an arbitrary GET.
+fn session_url(endpoint: &str, value: &str) -> Option<String> {
+    if endpoint.contains(['?', '#']) || value.contains(['?', '#']) {
+        return None;
+    }
+    let endpoint = ott::http_url(endpoint)?;
+    let origin = plx_net::net::origin::Origin::parse(&endpoint)?.base();
+    if !endpoint
+        .strip_prefix(&origin)?
+        .eq_ignore_ascii_case("/nas/api")
+    {
+        return None;
+    }
+    let url = ott::http_url(value)?; // No relative or scheme-relative control URLs.
+    let control_origin = plx_net::net::origin::Origin::parse(&url)?.base();
+    if !control_origin.eq_ignore_ascii_case(&origin) {
+        return None;
+    }
+    let path = url.strip_prefix(&control_origin)?;
+    if !path.get(..12)?.eq_ignore_ascii_case("/nas/stream/") {
+        return None;
+    }
+    let path = &path[12..];
+    let (token, file) = path.split_once('/')?;
+    let (session, secret) = token.split_once('.')?;
+    let token_part = |part: &str| {
+        !part.is_empty()
+            && part
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+    };
+    if !token_part(session) || !token_part(secret) {
+        return None;
+    }
+    let extension = file
+        .get(..6)
+        .filter(|prefix| prefix.eq_ignore_ascii_case("media."))
+        .map(|_| &file[6..])?;
+    if extension.is_empty()
+        || extension.len() > 8
+        || !extension.bytes().all(|b| b.is_ascii_alphanumeric())
+    {
+        return None;
+    }
+    Some(url)
+}
