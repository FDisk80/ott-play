+            paused.catalog_updated(2, &["first", "second"], false),
+            Decision::Idle
+        );
+        paused.resume(2);
+        assert_eq!(
+            paused.ended(2, "first", &["first", "second"], false),
+            start("second", 0, Reason::Next)
+        );
