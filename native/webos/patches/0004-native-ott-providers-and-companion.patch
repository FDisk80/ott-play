index 0000000000000000000000000000000000000000..2c3258f4fe7dbdcf2b0be0003ae9446282481d77
--- /dev/null
+++ b/rust-modules/src/app/ott_runtime_tests/resume.rs
@@ -0,0 +1,225 @@
+//! Cross-boundary regressions: the real Player Exit must retire the OTT intent
+//! before decoder teardown loses its playhead. No filesystem, network or private
+//! storage is used; the resolver/persistence slots are deliberately held busy.
+use super::*;
+
+#[path = "supersession.rs"]
+mod supersession;
+
+#[path = "transport.rs"]
+mod transport;
+
+struct ResetMedia;
+impl Drop for ResetMedia {
+    fn drop(&mut self) {
+        plx_media::player::SHARED.reset_session();
+        plx_media::player::TX.reset();
+        plx_media::route::reset_player_control_for_test(&plx_media::route::PlaybackSession::IDLE);
+    }
+}
+
+fn local_entry(id: &str) -> CatalogEntry {
+    CatalogEntry {
+        id: id.into(),
+        title: format!("{id}.mp4"),
+        category: "Fixture folder".into(),
+        description: String::new(),
+        poster: String::new(),
+        media: MediaLocator::Local {
+            relative_path: format!("{id}.mp4"),
+        },
+        duration_ms: Some(60_000),
+        provider_id: None,
+        provider_id_field: None,
+    }
+}
+
+fn local_playing(app: &mut App, restore: Option<continuity::ResumePoint>, position_ms: u64) {
+    let profile = ProviderProfile {
+        id: "local-exit-fixture".into(),
+        name: "Fixture folder".into(),
+        kind: ProviderKind::Local,
+        source: "/media/ott-exit-fixture".into(),
+        source_alias: "Fixture folder".into(),
+        enabled: true,
+    };
+    let first = local_entry("first");
+    let source = plx_media::ff::ExternalSource::Local("/media/ott-exit-fixture/first.mp4".into());
+    plx_media::route::reset_player_control_for_test(&app.player.session);
+    plx_media::route::request_external_source(
+        &mut app.player.session,
+        &plx_media::ff::inspect::MediaInfo {
+            resolved_source: None,
+            video_codec: "h264".into(),
+            audio_codec: "aac".into(),
+            width: 1280,
+            height: 720,
+            fps: 24.0,
+            duration_ns: 60_000_000_000,
+            audio_channels: 2,
+            audio_sample_rate: 48_000,
+            audio_bit_depth: 16,
+            dovi: plx_data::metadata::Dovi::NONE,
+        },
+        source.clone(),
+        &first.title,
+        &first.category,
+        plx_platform::devcaps::assumed_shared(),
+    )
+    .expect("the inert local route must be admitted before checking the Exit boundary");
+    {
+        let runtime = app.ott.as_mut().unwrap();
+        runtime.saved.profiles.profiles = vec![profile.clone()];
+        runtime.saved.profiles.active_profile = Some(profile.id.clone());
+        runtime.provider = ProviderKind::Local;
+        runtime.catalog.entries = vec![first.clone()];
+        runtime.catalog_loading = true;
+        runtime.catalog_dirty = false;
+        runtime.generation = 7;
+        runtime.continuity = continuity::Continuity::new(7, restore);
+        assert!(matches!(
+            runtime.continuity.catalog_updated(7, &["first"], false),
+            continuity::Decision::Start {
+                reason: continuity::Reason::First,
+                ..
+            }
+        ));
+        runtime.playing = Some(Playing {
+            profile,
+            entry: first,
+            selection_id: "first".into(),
+            source: Some(source),
+        });
+        runtime.selected = Some("first".into());
+        runtime.resolver_busy = true;
+        runtime.saving = true;
+    }
+    mount_player(app);
+    plx_media::player::SHARED.playpos_ns.store(
+        (position_ms * 1_000_000) as i64,
+        std::sync::atomic::Ordering::Relaxed,
+    );
+    assert!(playing_matches(
+        app.ott.as_ref().unwrap().playing.as_ref().unwrap(),
+        app
+    ));
+}
+
+#[test]
+fn local_fallback_exit_does_not_reopen_when_the_saved_file_arrives() {
+    let _serial = plx_base::testlock::serial();
+    let _reset = ResetMedia;
+    let mut app = app_fixture();
+    local_playing(
+        &mut app,
+        Some(continuity::ResumePoint {
+            entry_id: "late".into(),
+            position_ms: 42_000,
+        }),
+        8_000,
+    );
+
+    exit_through_content(&mut app);
+    // The producer had already queued this old-generation discovery when Exit
+    // was pressed. Draining it must not stage a new media resolution.
+    app.ott
+        .as_ref()
+        .unwrap()
+        .catalog_tx
+        .send(CatalogEvent::Batch(
+            7,
+            Catalog {
+                entries: vec![local_entry("late")],
+            },
+        ))
+        .unwrap_or_else(|_| panic!("fixture catalogue receiver disappeared"));
+    runtime_tick(&mut app);
+
+    let runtime = app.ott.as_ref().unwrap();
+    assert!(
+        runtime.resolver_next.is_none(),
+        "Exit was bypassed by a late restore resolver"
+    );
+    assert!(
+        runtime.play_target.is_none(),
+        "Exit was bypassed by a late saved-file target"
+    );
+    assert!(
+        !matches!(app.route(), AppArg::Player),
+        "the player must remain closed"
+    );
+}
+
+#[test]
+fn local_exit_checkpoints_the_nonzero_playhead_before_decoder_teardown() {
+    let _serial = plx_base::testlock::serial();
+    let _reset = ResetMedia;
+    let mut app = app_fixture();
+    local_playing(&mut app, None, 23_700);
+    let runtime = app.ott.as_mut().unwrap();
+    let profile = runtime.active().unwrap().clone();
+    runtime.checkpoints.insert(
+        profile.id.clone(),
+        SavedResume {
+            entry_id: "first".into(),
+            position_ms: 9_000,
+            source_fingerprint: profile_fingerprint(&profile),
+        },
+    );
+
+    exit_through_content(&mut app);
+    assert_eq!(
+        plx_media::player::playpos_ns(),
+        0,
+        "the real teardown must have reset its clock"
+    );
+    runtime_tick(&mut app);
+
+    let checkpoint = app
+        .ott
+        .as_ref()
+        .unwrap()
+        .checkpoints
+        .get(&profile.id)
+        .unwrap();
+    assert_eq!(checkpoint.entry_id, "first");
+    assert_eq!(
+        checkpoint.position_ms, 23_700,
+        "the post-teardown zero must not replace the viewer's last position"
+    );
+}
+
+#[test]
+fn partial_catalogue_failure_does_not_grant_eos_wrap_or_hide_the_error() {
+    let _serial = plx_base::testlock::serial();
+    let _reset = ResetMedia;
+    let mut app = app_fixture();
+    local_playing(&mut app, None, 60_000);
+    const FAILURE: &str = "Fixture subtree is unavailable";
+    app.ott
+        .as_ref()
+        .unwrap()
+        .catalog_tx
+        .send(CatalogEvent::Finished(7, Err(FAILURE)))
+        .unwrap_or_else(|_| panic!("fixture catalogue receiver disappeared"));
+    runtime_tick(&mut app);
+    assert_eq!(app.ott.as_ref().unwrap().status, FAILURE);
+
+    // This is the real application continuation called by playback_tick on
+    // native EOS; the narrow fixture checks completion admission, not decoding.
+    assert!(finish_catalog_playback(&mut app));
+
+    let runtime = app.ott.as_ref().unwrap();
+    assert!(
+        runtime.resolver_next.is_none(),
+        "a failed scan must not wrap a partial catalogue"
+    );
+    assert!(
+        runtime.play_target.is_none(),
+        "EOS must wait after an incomplete scan"
+    );
+    assert_eq!(
+        runtime.status, FAILURE,
+        "EOS must not replace the scan failure with an opening message"
+    );
+}
diff --git a/rust-modules/src/app/ott_runtime_tests/shutdown.rs b/rust-modules/src/app/ott_runtime_tests/shutdown.rs
new file mode 100644
index 0000000000000000000000000000000000000000..65ca4dcab11eda534a5d5046c7fd9b2c17ed4dc9
--- /dev/null
+++ b/rust-modules/src/app/ott_runtime_tests/shutdown.rs
@@ -0,0 +1,107 @@
+//! Post-loop cleanup must keep live and late source leases until their bounded
+//! stop attempt has completed. Synthetic channels stand in for the server worker.
+use super::*;
+use plx_base::task::{time::Budget, OffFrame};
+
+fn closing_session() -> (
+    crate::app::ott_vportal_lease::Lease,
+    Arc<AtomicBool>,
+    std::thread::JoinHandle<()>,
+) {
+    let (lease, release, finished) = crate::app::ott_vportal_lease::Lease::pending_for_test();
+    let closed = Arc::new(AtomicBool::new(false));
+    let completed = closed.clone();
+    let worker = std::thread::spawn(move || {
+        release
+            .recv_timeout(Duration::from_secs(2))
+            .expect("shutdown must release the session");
+        let off = OffFrame::for_test();
+        Budget::start(&off, Duration::from_secs(1)).wait(
+            &off,
+            Duration::from_millis(40),
+            Duration::from_millis(5),
+            &|| false,
+        );
+        completed.store(true, Ordering::Release);
+        // The old implementation drops the receiver before this completion.
+        let _ = finished.send(());
+    });
+    (lease, closed, worker)
+}
+
+#[test]
+fn shutdown_waits_for_an_active_session_stop_without_installing_media() {
+    let _serial = plx_base::testlock::serial();
+    let mut app = app_fixture();
+    let (lease, closed, server) = closing_session();
+    app.ott.as_mut().unwrap().active_lease = Some(lease);
+    super::super::shutdown(&mut app);
+    let waited = closed.load(Ordering::Acquire);
+    server.join().unwrap();
+    assert!(waited, "shutdown returned before the active stop completed");
+    assert!(app.ott.is_none());
+    assert!(app.bridge.metadata_view().now_playing().is_none());
+}
+
+#[test]
+fn shutdown_drains_a_late_ready_and_waits_for_its_session_stop() {
+    let _serial = plx_base::testlock::serial();
+    let mut app = app_fixture();
+    let (lease, closed, server) = closing_session();
+    let runtime = app.ott.as_mut().unwrap();
+    runtime.resolver_busy = true;
+    let tx = runtime.tx.clone();
+    let producer = std::thread::spawn(move || {
+        let off = OffFrame::for_test();
+        Budget::start(&off, Duration::from_secs(1)).wait(
+            &off,
+            Duration::from_millis(20),
+            Duration::from_millis(5),
+            &|| false,
+        );
+        // A successfully allocated session arrived during shutdown. Send failure
+        // is expected in the old implementation and must also release the lease.
+        let _ = tx.send(Job::Play(
+            0,
+            synthetic_profile(),
+            Ok((
+                synthetic_entry(),
+                ReadySource::External(
+                    plx_media::ff::ExternalSource::Http("https://media.invalid/video".into()),
+                    unsupported_info(),
+                    Some(lease),
+                ),
+            )),
+        ));
+    });
+    super::super::shutdown(&mut app);
+    let waited = closed.load(Ordering::Acquire);
+    producer.join().unwrap();
+    server.join().unwrap();
+    assert!(
+        waited,
+        "shutdown returned before a late allocated session stopped"
+    );
+    assert!(
+        app.bridge.metadata_view().now_playing().is_none(),
+        "shutdown must never pass the late source to start_resolved"
+    );
+    assert!(!plx_media::route::has_url(&app.player.session));
+}
+
+#[test]
+fn shutdown_does_not_extend_the_total_allowance_for_an_unfinished_stop() {
+    let _serial = plx_base::testlock::serial();
+    let mut app = app_fixture();
+    let (lease, release, _finished) = crate::app::ott_vportal_lease::Lease::pending_for_test();
+    app.ott.as_mut().unwrap().active_lease = Some(lease);
+    let off = OffFrame::for_test();
+    let measured = Budget::start(&off, Duration::from_secs(1));
+    super::super::shutdown_with_budget(&mut app, Duration::from_millis(20));
+    assert!(
+        measured.spent(&off) < Duration::from_millis(500),
+        "shutdown renewed the per-session allowance instead of the shared budget"
+    );
+    assert_eq!(release.try_recv(), Ok(()));
+    assert!(app.ott.is_none());
+}
diff --git a/rust-modules/src/app/ott_runtime_tests/supersession.rs b/rust-modules/src/app/ott_runtime_tests/supersession.rs
new file mode 100644
index 0000000000000000000000000000000000000000..98e2740480412cfd53f1d9291cbaad63dda47cee
--- /dev/null
+++ b/rust-modules/src/app/ott_runtime_tests/supersession.rs
@@ -0,0 +1,235 @@
+//! Late catalogue and persistence replies must not replace a newer user intent.
+//! The retained Plex request is injected before its native resolve completes;
+//! all catalogue and save replies are synthetic, with their workers held inert.
+use super::*;
+
+#[path = "plex_refresh.rs"]
+mod plex_refresh;
+
+#[test]
+fn native_plex_request_prevents_late_local_resume_from_replacing_it() {
+    let _serial = plx_base::testlock::serial();
+    let _reset = ResetMedia;
+    struct ResetServers;
+    impl Drop for ResetServers {
+        fn drop(&mut self) {
+            plx_plex::plex::reset_servers_for_test();
+        }
+    }
+    let _servers = ResetServers;
+    plx_plex::plex::reset_servers_for_test();
+    let sid = plx_plex::plex::register_for_test(
+        "superseding-plex-fixture",
+        "127.0.0.1",
+        1,
+        "fixture-token",
+        "fixture-client",
+    );
+    plx_plex::plex::client_for(sid).unwrap().disable_data_io();
+    let mut app = app_fixture();
+    local_playing(
+        &mut app,
+        Some(continuity::ResumePoint {
+            entry_id: "late".into(),
+            position_ms: 42_000,
+        }),
+        8_000,
+    );
+    let outgoing_source = plx_media::route::external_source(&app.player.session);
+
+    // Native request_play retains the outgoing route during resolution. Inject
+    // only its new request identity, without starting the Plex/network worker.
+    plx_media::route::install_plex_request_for_test(&mut app.player.session, sid, "42");
+    assert_eq!(
+        plx_media::route::playback_request_identity(&app.player.session),
+        Some((sid, "42")),
+        "premise: a different native Plex item was requested"
+    );
+    assert_eq!(
+        plx_media::route::external_source(&app.player.session),
+        outgoing_source,
+        "premise: Local's outgoing route is still installed during native resolve"
+    );
+    app.ott
+        .as_ref()
+        .unwrap()
+        .catalog_tx
+        .send(CatalogEvent::Batch(
+            7,
+            Catalog {
+                entries: vec![local_entry("late")],
+            },
+        ))
+        .unwrap_or_else(|_| panic!("fixture catalogue receiver disappeared"));
+
+    runtime_tick(&mut app);
+
+    let runtime = app.ott.as_ref().unwrap();
+    assert!(
+        runtime.resolver_next.is_none() && runtime.play_target.is_none(),
+        "late Local discovery must not queue a restore over the newer native Plex request"
+    );
+    assert_eq!(
+        plx_media::route::playback_request_identity(&app.player.session),
+        Some((sid, "42")),
+        "retiring Local ownership must preserve the replacement Plex request"
+    );
+}
+
+#[test]
+fn late_saved_reload_after_exit_cannot_restart_the_first_local_batch() {
+    let _serial = plx_base::testlock::serial();
+    let _reset = ResetMedia;
+    let mut app = app_fixture();
+    local_playing(&mut app, None, 8_000);
+    let mut saved = app.ott.as_ref().unwrap().saved.clone();
+    saved.category = "Fixture folder".into();
+    // The fixture represents a save already in flight before Exit. Prevent the
+    // later reload from launching a filesystem worker; replies arrive below.
+    app.ott
+        .as_ref()
+        .unwrap()
+        .catalog_done
+        .store(false, Ordering::Release);
+
+    exit_through_content(&mut app);
+    runtime_tick(&mut app);
+    assert!(app.player.pending_exit.is_none(), "Exit was consumed");
+    assert!(app.ott.as_ref().unwrap().playing.is_none());
+    assert!(!matches!(app.route(), AppArg::Player));
+
+    app.ott
+        .as_ref()
+        .unwrap()
+        .tx
+        .send(Job::Saved(Ok(saved), None, true, json!({"status":"ok"})))
+        .unwrap_or_else(|_| panic!("fixture saved-reply receiver disappeared"));
+    runtime_tick(&mut app);
+    let runtime = app.ott.as_ref().unwrap();
+    assert!(!runtime.saving, "the pending save reply must be accepted");
+    assert_eq!(runtime.saved.category, "Fixture folder");
+    let generation = runtime.generation;
+    runtime
+        .catalog_tx
+        .send(CatalogEvent::Batch(
+            generation,
+            Catalog {
+                entries: vec![local_entry("first")],
+            },
+        ))
+        .unwrap_or_else(|_| panic!("fixture catalogue receiver disappeared"));
+
+    runtime_tick(&mut app);
+
+    let runtime = app.ott.as_ref().unwrap();
+    assert!(
+        runtime
+            .catalog
+            .entries
+            .iter()
+            .any(|entry| entry.id == "first"),
+        "the post-save catalogue may refresh while playback stays stopped"
+    );
+    assert!(
+        runtime.resolver_next.is_none() && runtime.play_target.is_none(),
+        "a pre-Exit save must not re-enable autoplay when its reload discovers a file"
+    );
+    assert!(runtime.playing.is_none());
+    assert!(!matches!(app.route(), AppArg::Player));
+}
+
+fn late_saved_preserves_new_local_play(source_changed: bool) {
+    let _serial = plx_base::testlock::serial();
+    let _reset = ResetMedia;
+    let mut app = app_fixture();
+    local_playing(&mut app, None, 8_000);
+    let native_source = plx_media::route::external_source(&app.player.session);
+    let (saved, generation, cancel, profile_id) = {
+        let runtime = app.ott.as_mut().unwrap();
+        runtime.catalog_done.store(false, Ordering::Release);
+        runtime.catalog.entries.push(local_entry("second"));
+        let profile_id = runtime.active().unwrap().id.clone();
+        let mut saved = runtime.saved.clone();
+        saved.category = "Fixture folder".into();
+        if source_changed {
+            let mut replacement = runtime.active().unwrap().clone();
+            replacement.id = "replacement-folder".into();
+            replacement.source = "/media/replacement-fixture".into();
+            saved.profiles.active_profile = Some(replacement.id.clone());
+            saved.profiles.profiles.push(replacement);
+        }
+        // Snapshot the writer's admission before the newer user selection.
+        // local_playing holds both the writer and resolver boundaries inert.
+        runtime.save_playback_epoch = runtime.playback_epoch;
+        runtime.play("second").unwrap();
+        assert_ne!(runtime.save_playback_epoch, runtime.playback_epoch);
+        (
+            saved,
+            runtime.play_generation,
+            runtime.play_cancel.clone(),
+            profile_id,
+        )
+    };
+    let saved_profile = saved.profiles.active_profile.clone();
+    app.ott
+        .as_ref()
+        .unwrap()
+        .tx
+        .send(Job::Saved(Ok(saved), None, true, json!({"status":"ok"})))
+        .unwrap_or_else(|_| panic!("fixture saved-reply receiver disappeared"));
+
+    runtime_tick(&mut app);
+
+    let runtime = app.ott.as_ref().unwrap();
+    assert!(!runtime.saving, "the durable save reply must be accepted");
+    assert_eq!(runtime.saved.category, "Fixture folder");
+    assert_eq!(runtime.saved.profiles.active_profile, saved_profile);
+    assert_eq!(
+        plx_media::route::external_source(&app.player.session),
+        native_source,
+        "a stale save must not tear down the native route while a newer video opens"
+    );
+    assert_eq!(
+        runtime.play_generation, generation,
+        "a stale save must not invalidate the newer user's resolver generation"
+    );
+    assert!(!cancel.load(Ordering::Acquire));
+    assert_eq!(runtime.play_target, Some(("second".into(), 0)));
+    assert!(
+        runtime.resolver_next.as_ref().is_some_and(|next| {
+            next.generation == generation
+                && next.profile.id == profile_id
+                && next
+                    .entry
+                    .as_ref()
+                    .is_some_and(|entry| entry.id == "second")
+        }),
+        "the newer request must retain the source captured when it was selected"
+    );
+    // Catalogue refresh remains allowed, but its first result is not a new
+    // playback instruction and must not replace the still-resolving selection.
+    runtime
+        .catalog_tx
+        .send(CatalogEvent::Batch(
+            runtime.generation,
+            Catalog {
+                entries: vec![local_entry("refreshed-first")],
+            },
+        ))
+        .unwrap_or_else(|_| panic!("fixture catalogue receiver disappeared"));
+    runtime_tick(&mut app);
+    let runtime = app.ott.as_ref().unwrap();
+    assert_eq!(runtime.play_generation, generation);
+    assert_eq!(runtime.play_target, Some(("second".into(), 0)));
+    assert!(!cancel.load(Ordering::Acquire));
+}
+
+#[test]
+fn late_saved_reload_preserves_a_newer_local_play_request() {
+    late_saved_preserves_new_local_play(false);
+}
+
+#[test]
+fn late_saved_source_change_preserves_a_newer_local_play_request() {
+    late_saved_preserves_new_local_play(true);
+}
