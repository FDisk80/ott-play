index 0000000000000000000000000000000000000000..bcb8780c5e82c96b960835825da62f7a9f53bf8b
--- /dev/null
+++ b/rust-modules/src/app/ott_metadata.rs
@@ -0,0 +1,377 @@
+//! Selected-entry metadata is fetched off-frame and tagged for the runtime's generation check.
+use plx_base::task::OffFrame;
+use plx_data::ott::{
+    favorites::Favorite, CatalogEntry, MediaLocator, ProviderKind, ProviderProfile,
+};
+use serde_json::{json, Value};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    mpsc::Sender,
+    Arc,
+};
+
+pub(super) struct Event {
+    pub generation: u64,
+    pub profile_id: String,
+    pub entry_id: String,
+    pub entry: Option<CatalogEntry>,
+    pub result: Result<Value, &'static str>,
+}
+
+pub(super) fn start(
+    profile: ProviderProfile,
+    entry: CatalogEntry,
+    generation: u64,
+    now_s: i64,
+    cancel: Arc<AtomicBool>,
+    tx: Sender<Event>,
+    done: Arc<AtomicBool>,
+) -> bool {
+    super::ott_worker::spawn("ott-metadata", done, move |worker| {
+        if run(&profile, &entry, generation, &cancel, &tx, || {
+            metadata(worker, &profile, &entry, now_s, &cancel)
+        }) {
+            plx_machine::idle::invalidate();
+        }
+    })
+}
+
+pub(super) fn start_favorite(
+    profile: ProviderProfile,
+    favorite: Favorite,
+    generation: u64,
+    now_s: i64,
+    cancel: Arc<AtomicBool>,
+    tx: Sender<Event>,
+    done: Arc<AtomicBool>,
+) -> bool {
+    super::ott_worker::spawn("ott-fav-preview", done, move |worker| {
+        if run_favorite(
+            &profile,
+            &favorite,
+            generation,
+            &cancel,
+            &tx,
+            || {
+                let entry =
+                    super::ott_catalog::find_favorite(worker, &profile, &favorite, &cancel)?;
+                hydrate_plex(&profile, entry, &cancel)
+            },
+            |entry| metadata(worker, &profile, entry, now_s, &cancel),
+        ) {
+            plx_machine::idle::invalidate();
+        }
+    })
+}
+
+fn metadata(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    entry: &CatalogEntry,
+    now_s: i64,
+    cancel: &AtomicBool,
+) -> Result<Value, &'static str> {
+    if matches!(
+        profile.kind,
+        ProviderKind::M3u | ProviderKind::Xtream | ProviderKind::Stalker
+    ) {
+        super::ott_provider_http::metadata(worker, profile, entry, now_s, cancel)
+    } else {
+        Ok(
+            json!({"description":entry.description,"poster":entry.poster,
+            "durationSeconds":entry.duration_ms.map(|ms|ms as f64/1000.0)}),
+        )
+    }
+}
+
+/// Favorites retain portable identity, not a stale metadata snapshot. Plex's
+/// direct identity lookup therefore needs its read-only metadata request here.
+fn hydrate_plex(
+    profile: &ProviderProfile,
+    mut entry: CatalogEntry,
+    cancel: &AtomicBool,
+) -> Result<CatalogEntry, &'static str> {
+    let MediaLocator::Plex {
+        server_id,
+        rating_key,
+    } = &entry.media
+    else {
+        return Ok(entry);
+    };
+    if cancel.load(Ordering::Acquire) {
+        return Err("Metadata request cancelled");
+    }
+    if profile.kind != ProviderKind::Plex || *server_id != profile.source {
+        return Err("Favorite Plex source does not match");
+    }
+    if rating_key.is_empty()
+        || rating_key.len() > 256
+        || !rating_key
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'))
+    {
+        return Err("Invalid Plex item identity");
+    }
+    let sid = plx_plex::plex::id_of_machine(server_id).ok_or("Plex server is not connected")?;
+    let client =
+        plx_plex::plex::client_for(sid).ok_or("Plex server authorization is unavailable")?;
+    let item = client
+        .metadata_bounded(rating_key)
+        .ok_or("Plex item metadata is unavailable")?;
+    if cancel.load(Ordering::Acquire) {
+        return Err("Metadata request cancelled");
+    }
+    if item.rating_key != *rating_key {
+        return Err("Plex returned a different item");
+    }
+    if item.summary.len() > plx_data::ott::MAX_METADATA_BYTES
+        || item.thumb.len() > 16384
+        || item.art.len() > 16384
+    {
+        return Err("Plex item metadata exceeds its limit");
+    }
+    entry.description = item.summary;
+    entry.poster = if item.thumb.is_empty() {
+        item.art
+    } else {
+        item.thumb
+    };
+    entry.duration_ms = u64::try_from(item.duration).ok().filter(|ms| *ms > 0);
+    Ok(entry)
+}
+
+fn run_favorite(
+    profile: &ProviderProfile,
+    favorite: &Favorite,
+    generation: u64,
+    cancel: &AtomicBool,
+    tx: &Sender<Event>,
+    lookup: impl FnOnce() -> Result<CatalogEntry, &'static str>,
+    inspect: impl FnOnce(&CatalogEntry) -> Result<Value, &'static str>,
+) -> bool {
+    publish(
+        profile,
+        format!("favorite:{}", favorite.identity()),
+        generation,
+        cancel,
+        tx,
+        || match lookup() {
+            Ok(entry) => {
+                if cancel.load(Ordering::Acquire) {
+                    return (None, Err("Metadata request cancelled"));
+                }
+                let result = inspect(&entry);
+                (Some(entry), result)
+            }
+            Err(error) => (None, Err(error)),
+        },
+    )
+}
+
+/// Cancellation checks avoid publishing abandoned work. The consumer must still check
+/// generation/profile/entry: selection can change between the final check and send.
+fn run(
+    profile: &ProviderProfile,
+    entry: &CatalogEntry,
+    generation: u64,
+    cancel: &AtomicBool,
+    tx: &Sender<Event>,
+    fetch: impl FnOnce() -> Result<Value, &'static str>,
+) -> bool {
+    publish(profile, entry.id.clone(), generation, cancel, tx, || {
+        (Some(entry.clone()), fetch())
+    })
+}
+
+fn publish(
+    profile: &ProviderProfile,
+    entry_id: String,
+    generation: u64,
+    cancel: &AtomicBool,
+    tx: &Sender<Event>,
+    work: impl FnOnce() -> (Option<CatalogEntry>, Result<Value, &'static str>),
+) -> bool {
+    if cancel.load(Ordering::Acquire) {
+        return false;
+    }
+    let (entry, result) = std::panic::catch_unwind(std::panic::AssertUnwindSafe(work))
+        .unwrap_or((None, Err("Metadata worker failed")));
+    if cancel.load(Ordering::Acquire) {
+        return false;
+    }
+    tx.send(Event {
+        generation,
+        profile_id: profile.id.clone(),
+        entry_id,
+        entry,
+        result,
+    })
+    .is_ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use plx_data::ott::{MediaLocator, ProviderKind};
+    use serde_json::json;
+    use std::sync::mpsc::{channel, TryRecvError};
+
+    fn profile() -> ProviderProfile {
+        ProviderProfile {
+            id: "profile-a".into(),
+            name: "Home".into(),
+            kind: ProviderKind::M3u,
+            source: "https://provider.test/catalog".into(),
+            source_alias: "Home".into(),
+            enabled: true,
+        }
+    }
+    fn entry() -> CatalogEntry {
+        CatalogEntry {
+            id: "entry-a".into(),
+            title: "Video".into(),
+            category: String::new(),
+            description: String::new(),
+            poster: String::new(),
+            duration_ms: None,
+            provider_id: None,
+            provider_id_field: None,
+            media: MediaLocator::Http {
+                url: "https://provider.test/video".into(),
+            },
+        }
+    }
+
+    #[test]
+    fn preserves_selection_identity_and_provider_result() {
+        let (tx, rx) = channel();
+        let expected = json!({"title":"Programme","description":"Full description","end":200});
+        assert!(run(
+            &profile(),
+            &entry(),
+            7,
+            &AtomicBool::new(false),
+            &tx,
+            || Ok(expected.clone())
+        ));
+        let event = rx.try_recv().unwrap();
+        assert_eq!(
+            (
+                event.generation,
+                event.profile_id.as_str(),
+                event.entry_id.as_str()
+            ),
+            (7, "profile-a", "entry-a")
+        );
+        assert_eq!(event.result, Ok(expected));
+        assert_eq!(event.entry, Some(entry()));
+        assert!(matches!(rx.try_recv(), Err(TryRecvError::Empty)));
+    }
+
+    #[test]
+    fn cancellation_before_and_during_fetch_publishes_nothing() {
+        let (tx, rx) = channel();
+        let cancel = AtomicBool::new(true);
+        assert!(!run(&profile(), &entry(), 1, &cancel, &tx, || panic!(
+            "cancelled work ran"
+        )));
+        cancel.store(false, Ordering::Release);
+        assert!(!run(&profile(), &entry(), 2, &cancel, &tx, || {
+            cancel.store(true, Ordering::Release);
+            Ok(Value::Null)
+        }));
+        assert!(matches!(rx.try_recv(), Err(TryRecvError::Empty)));
+    }
+
+    #[test]
+    fn failed_worker_reports_error_and_closed_receiver_does_not_signal_publication() {
+        let (tx, rx) = channel();
+        let cancel = AtomicBool::new(false);
+        assert!(run(&profile(), &entry(), 3, &cancel, &tx, || panic!(
+            "fixture failure"
+        )));
+        assert_eq!(rx.try_recv().unwrap().result, Err("Metadata worker failed"));
+        drop(rx);
+        assert!(!run(&profile(), &entry(), 4, &cancel, &tx, || Ok(
+            Value::Null
+        )));
+    }
+
+    fn favorite() -> Favorite {
+        Favorite {
+            title: "Film".into(),
+            origin: plx_data::ott::favorites::Origin {
+                provider: "vportal".into(),
+                profile: "Home".into(),
+                subprofile: None,
+                source_alias: "Home".into(),
+            },
+            locator: plx_data::ott::favorites::Locator::VPortal {
+                id_field: "id".into(),
+                id: "42".into(),
+            },
+        }
+    }
+
+    #[test]
+    fn favorite_preview_retains_card_and_uses_favorite_selection_identity() {
+        let (tx, rx) = channel();
+        let favorite = favorite();
+        let mut hydrated = entry();
+        hydrated.description = "First sentence. Full second sentence.".into();
+        hydrated.poster = "https://provider.test/poster.jpg".into();
+        assert!(run_favorite(
+            &profile(),
+            &favorite,
+            9,
+            &AtomicBool::new(false),
+            &tx,
+            || Ok(hydrated.clone()),
+            |_| Err("Programme is unavailable")
+        ));
+        let event = rx.try_recv().unwrap();
+        assert_eq!(event.entry_id, format!("favorite:{}", favorite.identity()));
+        assert_eq!(event.entry, Some(hydrated));
+        assert_eq!(event.result, Err("Programme is unavailable"));
+    }
+
+    #[test]
+    fn cancelled_favorite_lookup_never_starts_metadata_or_publishes() {
+        let (tx, rx) = channel();
+        let cancel = AtomicBool::new(false);
+        assert!(!run_favorite(
+            &profile(),
+            &favorite(),
+            9,
+            &cancel,
+            &tx,
+            || {
+                cancel.store(true, Ordering::Release);
+                Ok(entry())
+            },
+            |_| panic!("cancelled lookup started metadata")
+        ));
+        assert!(matches!(rx.try_recv(), Err(TryRecvError::Empty)));
+    }
+
+    #[test]
+    fn library_preview_keeps_full_metadata_without_a_programme_request() {
+        let mut row = entry();
+        row.description = "Complete description. Including the second sentence.".into();
+        row.poster = "https://provider.test/cover.jpg".into();
+        for kind in [
+            ProviderKind::Local,
+            ProviderKind::VPortal,
+            ProviderKind::Plex,
+        ] {
+            let mut p = profile();
+            p.kind = kind;
+            p.source = "no network endpoint".into();
+            let data =
+                metadata(&OffFrame::for_test(), &p, &row, 0, &AtomicBool::new(false)).unwrap();
+            assert_eq!(data["description"], row.description);
+            assert_eq!(data["poster"], row.poster);
+            assert!(data.get("programmes").is_none());
+        }
+    }
+}
diff --git a/rust-modules/src/app/ott_plex.rs b/rust-modules/src/app/ott_plex.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c1917c30134e03aa38701ae3e14ff85317cd611b
--- /dev/null
+++ b/rust-modules/src/app/ott_plex.rs
@@ -0,0 +1,196 @@
+//! Application worker for a flat, paged native Plex catalogue. Authentication,
+//! endpoint admission, TLS and paging stay with the existing typed PMS client.
+use plx_data::ott::{CatalogEntry, MediaLocator, ProviderProfile};
+use plx_plex::plex::{self, Metadata, SectionQuery};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+pub(super) fn visit(
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    if cancel.load(Ordering::Acquire) {
+        return Ok(());
+    }
+    let sid = plex::id_of_machine(&profile.source).ok_or("Plex server is not connected")?;
+    let client = plex::client_for(sid).ok_or("Plex server authorization is unavailable")?;
+    let sections = client
+        .sections_bounded()
+        .ok_or("Plex libraries could not be loaded")?;
+    let mut scanned = 0usize;
+    let mut pages = 0usize;
+    let mut first = true;
+    for section in sections.directory {
+        if cancel.load(Ordering::Relaxed) {
+            return Ok(());
+        }
+        let media_type = match section.kind.as_str() {
+            "movie" => "1",
+            "show" => "4",
+            _ => continue,
+        };
+        let key = section
+            .key
+            .parse::<i64>()
+            .map_err(|_| "Plex returned an invalid library key")?;
+        let filters = vec![("type".to_owned(), media_type.to_owned())];
+        let mut offset = 0;
+        loop {
+            if cancel.load(Ordering::Relaxed) {
+                return Ok(());
+            }
+            pages += 1;
+            if pages > 4096 {
+                return Err("Plex catalogue page limit reached");
+            }
+            let page = client
+                .section_items_query_bounded(&SectionQuery {
+                    section_key: key,
+                    sort: "titleSort",
+                    filters: &filters,
+                    start: offset,
+                    size: 128,
+                    include_meta: false,
+                })
+                .ok_or("Plex library page could not be loaded")?;
+            if cancel.load(Ordering::Acquire) {
+                return Ok(());
+            }
+            scanned = scanned.saturating_add(page.metadata.len());
+            if scanned > plx_data::ott::MAX_CATALOG_ENTRIES {
+                return Err("Plex catalogue entry limit reached");
+            }
+            let count = page.metadata.len() as i64;
+            let (next, complete) = page_progress(offset, page.offset, count, page.total_size)?;
+            let mut rows = Vec::with_capacity(page.metadata.len());
+            for item in page.metadata {
+                if let Some(row) = entry(profile, &section.title, item) {
+                    if first {
+                        emit(vec![row])?;
+                        first = false;
+                    } else {
+                        rows.push(row);
+                    }
+                }
+            }
+            if !rows.is_empty() {
+                emit(rows)?;
+            }
+            offset = next;
+            if complete {
+                break;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn page_progress(
+    offset: i64,
+    reported: i64,
+    count: i64,
+    total: i64,
+) -> Result<(i64, bool), &'static str> {
+    if reported != offset || offset < 0 || count < 0 || total < 0 {
+        return Err("Plex returned a different catalogue page");
+    }
+    if count == 0 && total > offset {
+        return Err("Plex catalogue is incomplete");
+    }
+    let next = offset
+        .checked_add(count)
+        .ok_or("Plex catalogue is too large")?;
+    Ok((
+        next,
+        count == 0 || (total > 0 && next >= total) || (total == 0 && count < 128),
+    ))
+}
+
+fn entry(profile: &ProviderProfile, library: &str, item: Metadata) -> Option<CatalogEntry> {
+    if !matches!(item.kind.as_str(), "movie" | "episode" | "clip")
+        || item.rating_key.is_empty()
+        || item.rating_key.len() > 256
+        || !item
+            .rating_key
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+    {
+        return None;
+    }
+    let category = if item.kind == "episode" && !item.grandparent_title.is_empty() {
+        format!(
+            "{library} / {} / {}",
+            item.grandparent_title,
+            if item.parent_title.is_empty() {
+                format!("Season {}", item.parent_index.unwrap_or(0))
+            } else {
+                item.parent_title.clone()
+            }
+        )
+    } else {
+        library.to_owned()
+    };
+    let title = if item.kind == "episode" && !item.grandparent_title.is_empty() {
+        format!("{} — {}", item.grandparent_title, item.title)
+    } else {
+        item.title
+    };
+    Some(CatalogEntry {
+        id: format!("{}:{}", profile.id, item.rating_key),
+        title,
+        category,
+        description: item.summary,
+        poster: if !item.thumb.is_empty() {
+            item.thumb
+        } else {
+            item.art
+        },
+        duration_ms: u64::try_from(item.duration)
+            .ok()
+            .filter(|duration| *duration > 0),
+        provider_id: Some(item.rating_key.clone()),
+        provider_id_field: None,
+        media: MediaLocator::Plex {
+            server_id: profile.source.clone(),
+            rating_key: item.rating_key,
+        },
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn paging_does_not_mistake_truncation_or_repeated_first_page_for_completion() {
+        assert_eq!(page_progress(0, 0, 128, 300).unwrap(), (128, false));
+        assert_eq!(page_progress(256, 256, 44, 300).unwrap(), (300, true));
+        assert!(page_progress(128, 128, 0, 300).is_err());
+        assert!(page_progress(128, 0, 128, 300).is_err());
+        assert!(page_progress(0, 128, 128, 300).is_err());
+        assert!(page_progress(i64::MAX, i64::MAX, 1, 0).is_err());
+    }
+    #[test]
+    fn episode_row_keeps_full_description_and_native_server_identity() {
+        let profile = ProviderProfile {
+            id: "plex-1".into(),
+            name: "Home".into(),
+            kind: plx_data::ott::ProviderKind::Plex,
+            source: "server-1".into(),
+            source_alias: String::new(),
+            enabled: true,
+        };
+        let item:Metadata=serde_json::from_str(r#"{"type":"episode","ratingKey":"42","title":"Episode","grandparentTitle":"Series","parentTitle":"Season 2","summary":"First sentence. Second sentence.","thumb":"/library/metadata/42/thumb/1","duration":120000}"#).unwrap();
+        let row = entry(&profile, "TV", item).unwrap();
+        assert_eq!(row.category, "TV / Series / Season 2");
+        assert_eq!(row.description, "First sentence. Second sentence.");
+        assert_eq!(row.duration_ms, Some(120000));
+        assert_eq!(row.poster, "/library/metadata/42/thumb/1");
+        assert_eq!(
+            row.media,
+            MediaLocator::Plex {
+                server_id: "server-1".into(),
+                rating_key: "42".into()
+            }
+        );
+    }
+}
