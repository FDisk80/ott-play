+        let mut batches = Vec::new();
+        let first = snapshot(&document(vec![item("one"), item("two")], true, 2)).unwrap();
+        assert!(!state
+            .publish(&p, &p.source, first, Duration::ZERO, &cancel, &mut |rows| {
+                batches.push(rows);
