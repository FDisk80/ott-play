+#[test]
+fn suspend_revokes_keyboard_and_pointer_arms_even_before_a_frame_runs() {
+    for pointer_arm in [false, true] {
+        let (mut d, mut rig) = boot(FixtureArg::Page(700));
+        d.draw(&mut rig, true);
+        let input = if pointer_arm {
+            let rect = d.input.hit.front()[0].rect;
+            click(rect.cx(), rect.cy(), tick(16))
+        } else { key(Key::Ok, tick(16)) };
+        d.frame(&mut rig, tick(16), vec![input], vec![], &mut NoTap);
+        assert!(d.input.arm.is_some(), "the gesture must be armed before suspension");
+        d.suspend();
+        assert!(d.input.arm.is_none(), "suspension revokes the gesture immediately");
+        d.resume();
+        d.frame(&mut rig, tick(1200), vec![], vec![], &mut NoTap);
+        let events = events_of(&d, 0);
+        assert!(!events.contains("\"press_hold\"") && !events.contains("\"press_commit\""), "{events}");
+    }
+}
+
+#[test]
+fn suspend_discards_carried_input_and_activation_but_keeps_addressed_updates() {
+    use plx_machine::machine::{Delivery, Fx};
+    use super::screen::ScreenEvent;
+    for suspend in [false, true] {
+        let (mut d, mut rig) = boot(FixtureArg::Page(800));
+        let owner = MachineId::Instance(d.nav.top_page().unwrap().inst.as_ref().unwrap().id);
+        // Force the interactive deliveries into the real cross-frame budget queue.
+        for revision in 0..super::dispatch::MAX_STEPS_PRE + super::dispatch::MAX_STEPS_POST {
+            d.emit(MachineId::Store(StoreOrd(0)), Fx::Deliver(owner,
+                Delivery::Screen(ScreenEvent::StoreChanged(StoreOrd(0), revision))));
+        }
+        for kind in 0..4 {
+            d.emit(MachineId::Input, Fx::Deliver(owner,
+                Delivery::Screen(interactive_event(kind, tick(16)))));
+        }
+        d.emit(MachineId::Store(StoreOrd(0)), Fx::Deliver(owner,
+            Delivery::Screen(ScreenEvent::App(super::fixture::FixtureMsg::Store(StoreOrd(0), 7)))));
+        let report = d.frame(&mut rig, tick(16), vec![], vec![], &mut NoTap);
+        assert!(report.carried > 0);
+        let items = rig.store.view.items.len();
+        if suspend { d.suspend(); d.resume(); }
+        d.frame(&mut rig, tick(32), vec![], vec![], &mut NoTap);
+        assert_eq!(rig.store.view.items.len() - items, if suspend { 0 } else { 4 },
+            "a restored owner does not regain its revoked input");
+        assert!(events_of(&d, 0).contains("\"app\""), "addressed updates still arrive");
+    }
+}
