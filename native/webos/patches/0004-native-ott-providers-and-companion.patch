@@ -0,0 +1,726 @@
+//! Native OTT catalogue surface. The application supplies immutable display
+//! snapshots and receives semantic actions; this screen performs no IO.
+mod metadata;
+
+use std::borrow::Cow;
+use std::collections::HashMap;
+use std::convert::Infallible;
+use std::sync::Arc;
+use plx_platform::i18n::msg;
+use crate::registry::{AppFx, AppLike, AppMsg, PageMemory};
+use plx_machine::machine::{Canon, Cx, Delivery, Edge, Effects, EntryId, FocusKey, Fx, GroupId,
+    Handled, InputKind, InstanceId, Key, LogicalState, Machine, MachineId, TextEdit};
+use plx_ui::form::{Activation, Form, FormSection, FormTable, RowKey, RowKind};
+use plx_ui::frame::Budget;
+use plx_ui::route_screen::RouteLayout;
+use plx_ui::screen::{At, Dir, DrawFrame, EdgeRule, ElemKind, FocusSource, Focusable, GroupSpec,
+    HitSource, Part, Placed, RenderStrategy, Screen, ScreenEvent, Step};
+use plx_ui::table::Row;
+use plx_ui::table_screen::{Header, TableScreen};
+use plx_ui::text_buffer::TextBuffer;
+use plx_ui::document_reader::DocumentReader;
+use plx_ui::table_screen::{DocumentFocus, DocumentPart};
+use plx_ui::{theme, Rect};
+
+pub const SHAPE: &str = "Ott{page:str,revision:u64,rows:[{id:str,enabled:bool,favorite:bool}],editor:bool,editing:bool,media:Option<str>,reading:bool,read_target:u32,preview:Option<str>,previewed:Option<str>,preview_dwell:f32,selected:u32,table:TableViewMotion}";
+
+/// IDs are opaque local identities, never URLs or credentials.
+#[derive(Clone, PartialEq, Eq)]
+pub enum OttAction {
+    ShowProviders, ShowProfiles, ShowCategories, ShowFavorites, ShowSettings,
+    SelectProvider(String), SelectProfile(String), SelectCategory(String),
+    Play(String), Preview(String), ToggleFavorite(String), EditSetting(String),
+    SubmitSetting { key: String, value: String },
+    Back, Refresh,
+}
+
+impl std::fmt::Debug for OttAction {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::SubmitSetting { key, .. } => f.debug_struct("SubmitSetting").field("key", key).field("value", &"<redacted>").finish(),
+            Self::SelectProvider(id) => f.debug_tuple("SelectProvider").field(id).finish(),
+            Self::SelectProfile(id) => f.debug_tuple("SelectProfile").field(id).finish(),
+            Self::SelectCategory(id) => f.debug_tuple("SelectCategory").field(id).finish(),
+            Self::Play(id) => f.debug_tuple("Play").field(id).finish(),
+            Self::Preview(id) => f.debug_tuple("Preview").field(id).finish(),
+            Self::ToggleFavorite(id) => f.debug_tuple("ToggleFavorite").field(id).finish(),
+            Self::EditSetting(id) => f.debug_tuple("EditSetting").field(id).finish(),
+            Self::ShowProviders => f.write_str("ShowProviders"), Self::ShowProfiles => f.write_str("ShowProfiles"),
+            Self::ShowCategories => f.write_str("ShowCategories"), Self::ShowFavorites => f.write_str("ShowFavorites"),
+            Self::ShowSettings => f.write_str("ShowSettings"), Self::Back => f.write_str("Back"), Self::Refresh => f.write_str("Refresh"),
+        }
+    }
+}
+
+#[derive(Clone)]
+pub enum OttOut {
+    Refresh { reply: InstanceId },
+    Action { reply: InstanceId, action: OttAction },
+}
+
+/// An addressed settings request. Values stay in the screen's draft until Save;
+/// sensitive values are never included in its logical-state diagnostics.
+#[derive(Clone)]
+pub struct OttEditor {
+    pub key: String,
+    pub title: String,
+    pub value: String,
+    pub secret: bool,
+    pub limit: usize,
+}
+
+#[derive(Clone)]
+enum FormAction { Forward(OttAction), Edit, Save, Cancel, Details }
+
+struct Editor {
+    spec: Arc<OttEditor>,
+    draft: TextBuffer,
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub enum OttPoster {
+    Plex { server: u16, key: String },
+    Http { url: String },
+}
+impl std::fmt::Debug for OttPoster {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self { Self::Plex { .. } => "PlexArtwork", Self::Http { .. } => "HttpArtwork" })
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct OttRow {
+    pub id: String,
+    pub title: String,
+    pub detail: String,
+    pub description: String,
+    pub poster: Option<OttPoster>,
+    pub action: OttAction,
+    pub enabled: bool,
+    pub favorite: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct OttView {
+    /// Changes when navigating; a new page opens at its requested/first item.
+    pub page_id: String,
+    pub revision: u64,
+    pub title: String,
+    pub description: String,
+    pub status: String,
+    pub rows: Vec<OttRow>,
+    pub selected_row: Option<String>,
+}
+
+impl Default for OttView {
+    fn default() -> Self {
+        Self { page_id: "loading".into(), revision: 0, title: msg::ott_brand().into(),
+            description: msg::ott_intro().into(), status: String::new(),
+            rows: Vec::new(), selected_row: None }
+    }
+}
+
+pub struct OttScreen {
+    entry: EntryId,
+    instance: InstanceId,
+    snapshot: Arc<OttView>,
+    form: FormTable<String, FormAction, Infallible>,
+    keys: HashMap<String, u32>,
+    next_key: u32,
+    copy: String,
+    editor: Option<Editor>,
+    editing: bool,
+    media: Option<usize>,
+    media_keys: HashMap<u32, usize>,
+    reading: bool,
+    reader: DocumentReader,
+    read_target: u32,
+    preview: Option<String>,
+    previewed: Option<String>,
+    preview_dwell: f32,
+}
+
+impl OttScreen {
+    /// Provider URLs may embed credentials even when displayed as plain text.
+    /// The runner must suppress raw text recording for every native editor.
+    pub fn handles_private_text(&self) -> bool { self.editor.is_some() }
+
+    pub fn new(entry: EntryId, instance: InstanceId) -> Self {
+        let mut screen = Self { entry, instance, snapshot: Arc::new(OttView::default()),
+            form: FormTable::new(crate::registry::BAND), keys: HashMap::new(), next_key: 1,
+            copy: String::new(), editor: None, editing: false, media: None,
+            media_keys: HashMap::new(), reading: false, reader: DocumentReader::new(), read_target: 0,
+            preview: None, previewed: None, preview_dwell: 0.0 };
+        screen.install(Arc::new(OttView::default()));
+        screen
+    }
+
+    fn row_key(&mut self, id: &str) -> RowKey {
+        if let Some(key) = self.keys.get(id) { return RowKey(*key); }
+        let key = self.next_key;
+        self.next_key += 1;
+        self.keys.insert(id.to_owned(), key);
+        RowKey(key)
+    }
+
+    fn install(&mut self, snapshot: Arc<OttView>) {
+        if snapshot.revision < self.snapshot.revision { return; }
+        let same_page = self.snapshot.page_id == snapshot.page_id;
+        let prior = self.media.and_then(|i| self.snapshot.rows.get(i)).map(|r| r.id.clone());
+        let wanted = if same_page { prior.as_ref().or(snapshot.selected_row.as_ref()) } else { snapshot.selected_row.as_ref() };
+        self.media = snapshot.rows.iter().position(|r| matches!(r.action, OttAction::Play(_)) && wanted == Some(&r.id))
+            .or_else(|| snapshot.rows.iter().position(|r| matches!(r.action, OttAction::Play(_))));
+        if !same_page {
+            self.reading = false; self.reader.reset(); self.read_target = 0;
+            self.preview = None; self.previewed = None; self.preview_dwell = 0.0;
+        }
+        self.media_keys.clear();
+        let mut navigation = FormSection::new(msg::ott_browse());
+        for (id, title, action) in [
+            ("nav:providers", msg::ott_providers(), OttAction::ShowProviders),
+            ("nav:profiles", msg::ott_profiles(), OttAction::ShowProfiles),
+            ("nav:categories", msg::ott_categories(), OttAction::ShowCategories),
+            ("nav:favorites", msg::ott_favorites(), OttAction::ShowFavorites),
+            ("nav:settings", msg::settings_title(), OttAction::ShowSettings),
+        ] {
+            let key = self.row_key(id);
+            navigation = navigation.item_keyed(id.to_owned(), key, RowKind::Button, FormAction::Forward(action), Row::new(title).chevron(true));
+        }
+        if self.media.and_then(|i| snapshot.rows.get(i)).is_some_and(|row| !row.description.is_empty()) {
+            navigation = navigation.item_keyed("nav:description".into(), self.row_key("nav:description"), RowKind::Button,
+                FormAction::Details, Row::new(msg::ott_description()).chevron(true));
+        }
+        let mut content = FormSection::new(snapshot.title.clone());
+        for (i, row) in snapshot.rows.iter().enumerate() {
+            let id = format!("item:{}", row.id);
+            let key = self.row_key(&id);
+            if matches!(row.action, OttAction::Play(_)) { self.media_keys.insert(key.0, i); }
+            content = content.item_keyed(id, key, RowKind::Button, FormAction::Forward(row.action.clone()),
+                Row::new(row.title.clone()).server_label().detail(row.detail.clone()).server_detail().checked(row.favorite))
+                .disabled(!row.enabled);
+        }
+        let footer = FormSection::new("")
+            .item_keyed("nav:refresh".to_owned(), self.row_key("nav:refresh"), RowKind::Button, FormAction::Forward(OttAction::Refresh), Row::new(msg::browse_home_refresh()))
+            .item_keyed("nav:back".to_owned(), self.row_key("nav:back"), RowKind::Button, FormAction::Forward(OttAction::Back), Row::new(msg::settings_back()));
+        let form = Form::new().section(navigation).section(content).section(footer);
+        let selected = snapshot.selected_row.as_ref().map(|id| format!("item:{id}"));
+        if same_page { self.form.refresh(form); }
+        else { self.form.open(form, selected.as_ref()); }
+        self.copy = snapshot.description.clone();
+        if !snapshot.status.is_empty() {
+            if !self.copy.is_empty() { self.copy.push_str("\n\n"); }
+            self.copy.push_str(&snapshot.status);
+        }
+        self.snapshot = snapshot;
+    }
+
+    fn editor_form(&mut self, opening: bool) {
+        let Some(editor) = &self.editor else { return; };
+        let value = if editor.spec.secret { "•".repeat(editor.draft.text().chars().count().min(24)) }
+            else { editor.draft.text().to_owned() };
+        let value_row = if value.is_empty() { Row::new(msg::ott_value_empty()) }
+            else { Row::new(value).server_label() };
+        let section = FormSection::new(msg::ott_value())
+            .item_keyed("edit:value".to_owned(), self.row_key("edit:value"), RowKind::Button,
+                FormAction::Edit, value_row)
+            .item_keyed("edit:save".to_owned(), self.row_key("edit:save"), RowKind::Button, FormAction::Save, Row::new(msg::ott_save()))
+            .item_keyed("edit:cancel".to_owned(), self.row_key("edit:cancel"), RowKind::Button, FormAction::Cancel, Row::new(msg::settings_cancel()));
+        if opening { self.form.open(Form::new().section(section), Some(&"edit:value".to_owned())); }
+        else { self.form.refresh(Form::new().section(section)); }
+    }
+
+    fn keyboard<H: AppLike>(&mut self, up: bool, fx: &mut Effects<'_, H>) {
+        if self.editing == up { return; }
+        self.editing = up;
+        fx.push(Fx::Deliver(MachineId::Instance(self.instance), Delivery::Keyboard { up }));
+        fx.invalidate(plx_machine::present::Provenance::Input);
+    }
+
+    fn close_editor<H: AppLike>(&mut self, fx: &mut Effects<'_, H>) {
+        self.keyboard(false, fx);
+        self.editor = None;
+        self.install(self.snapshot.clone());
+        fx.invalidate(plx_machine::present::Provenance::Input);
+    }
+
+    fn edit<H: AppLike>(&mut self, edit: &TextEdit, fx: &mut Effects<'_, H>) {
+        let Some(editor) = &mut self.editor else { return; };
+        let mut next = editor.draft.clone();
+        next.edit(edit);
+        if next.text().chars().count() <= editor.spec.limit.min(8192) {
+            editor.draft = next;
+            self.editor_form(false);
+            fx.invalidate(plx_machine::present::Provenance::Input);
+        }
+    }
+
+    fn view(&self) -> TableScreen<'_> {
+        let (title, copy) = self.editor.as_ref().map_or((self.snapshot.title.as_str(), self.copy.as_str()),
+            |editor| (editor.spec.title.as_str(), msg::ott_editor_help()));
+        let (title, copy) = if self.editor.is_none() && self.media.is_some() { ("", "") } else { (title, copy) };
+        let crumb = if self.editor.is_none() && self.media.is_some() { None } else { Some(msg::ott_brand()) };
+        TableScreen::new(Header::new(RouteLayout::screen(), crumb,
+            title, copy), &self.form.table, GroupId(0), self.entry).keyed(&self.form)
+    }
+
+    fn document_focus(&self) -> DocumentFocus<'_> {
+        DocumentFocus { reader: &self.reader, frame: RouteLayout::screen().document(true), group: GroupId(0), entry: self.entry }
+    }
+
+    fn has_description(&self) -> bool {
+        self.media.and_then(|i| self.snapshot.rows.get(i)).is_some_and(|row| !row.description.is_empty())
+    }
+
+    fn show_details<H: AppLike>(&mut self, fx: &mut Effects<'_, H>) {
+        if self.has_description() {
+            self.reading = true; self.reader.reset(); self.read_target = 0;
+            fx.invalidate(plx_machine::present::Provenance::Input);
+        }
+    }
+
+    fn send<H: AppLike>(&self, action: OttAction, fx: &mut Effects<'_, H>) {
+        fx.push(Fx::App(AppFx::Ott(OttOut::Action { reply: self.instance, action })));
+    }
+
+    fn preview_focus(&mut self, key: u32) {
+        let id = self.media_keys.get(&key).and_then(|index| self.snapshot.rows.get(*index))
+            .and_then(|row| match &row.action { OttAction::Play(id) => Some(id), _ => None });
+        if id == self.preview.as_ref() { return; }
+        self.preview = id.filter(|id| Some(*id) != self.previewed.as_ref()).cloned();
+        self.preview_dwell = 0.0;
+    }
+
+    fn preview_tick<H: AppLike>(&mut self, dt: f32, fx: &mut Effects<'_, H>) {
+        if self.preview.is_none() || self.editor.is_some() { return; }
+        plx_ui::dwell::accumulate(&mut self.preview_dwell, dt, &mut |event| fx.note(event));
+        if self.preview_dwell >= 0.2 {
+            if let Some(id) = self.preview.take() {
+                self.previewed = Some(id.clone());
+                self.send(OttAction::Preview(id), fx);
+            }
+            self.preview_dwell = 0.0;
+        }
+    }
+
+    fn activate<H: AppLike>(&mut self, key: u32, favorite: bool, fx: &mut Effects<'_, H>) {
+        if let Some(Activation::Action(action)) = self.form.index_of_key(RowKey(key)).and_then(|i| self.form.activate(i)) {
+            match action {
+                FormAction::Forward(OttAction::Play(id)) if favorite => self.send(OttAction::ToggleFavorite(id), fx),
+                FormAction::Forward(action) if !favorite => self.send(action, fx),
+                FormAction::Edit if !favorite => self.keyboard(true, fx),
+                FormAction::Save if !favorite => {
+                    if let Some(editor) = &self.editor {
+                        self.send(OttAction::SubmitSetting { key: editor.spec.key.clone(), value: editor.draft.text().to_owned() }, fx);
+                    }
+                    self.close_editor(fx);
+                }
+                FormAction::Cancel if !favorite => self.close_editor(fx),
+                FormAction::Details if !favorite => self.show_details(fx),
+                _ => {}
+            }
+        }
+    }
+}
