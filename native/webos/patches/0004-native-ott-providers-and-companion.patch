new file mode 100644
index 0000000000000000000000000000000000000000..553fa7c86f957133544f1d5a7df75b0bf6ad6c22
--- /dev/null
+++ b/rust-modules/src/app/adapters/poster/http.rs
@@ -0,0 +1,278 @@
+//! External artwork source for the shared texture cache. It has no Plex grant,
+//! never logs URL/query data, and hands over only bounded, decoded thumbnails.
+use super::{tex, Decoded, PosterError, PosterKey, PosterReady};
+use std::sync::Mutex;
+
+const CAP: usize = 16;
+const FIRST_KEY: u32 = 0x8000_0000;
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+struct Slot {
+    url: String,
+    w: u32,
+    h: u32,
+    key: PosterKey,
+    touched: u64,
+    state: State,
+}
+enum State {
+    Loading,
+    Decoded(Decoded),
+    Ready,
+    Failed(Option<u32>),
+    Evicted,
+}
+struct Store {
+    slots: Vec<Slot>,
+    clock: u64,
+    next: u32,
+    generation: u64,
+    busy: bool,
+}
+static STORE: Mutex<Store> = Mutex::new(Store {
+    slots: Vec::new(),
+    clock: 0,
+    next: FIRST_KEY,
+    generation: 0,
+    busy: false,
+});
+
+pub(super) fn owns(key: PosterKey) -> bool {
+    key.0 >= FIRST_KEY
+}
+pub(super) fn idle() -> bool {
+    let store = STORE.lock().unwrap_or_else(|e| e.into_inner());
+    !store.busy
+        && !store
+            .slots
+            .iter()
+            .any(|s| matches!(s.state, State::Decoded(_)))
+}
+pub(super) fn reset() {
+    let mut store = STORE.lock().unwrap_or_else(|e| e.into_inner());
+    store.generation = store.generation.wrapping_add(1);
+    store.slots.clear();
+    store.busy = false;
+}
+fn request(url: &str, w: i32, h: i32) -> Option<(String, u32, u32)> {
+    if !(1..=1024).contains(&w) || !(1..=1024).contains(&h) {
+        return None;
+    }
+    Some((plx_data::ott::http_url(url)?, w as u32, h as u32))
+}
+pub(super) fn probe(url: &str, w: i32, h: i32) -> Option<PosterKey> {
+    let now = crate::app::clock::now();
+    if plx_ui::card_motion::declines_request() {
+        return None;
+    }
