+fn guide_entry(profile: &ProviderProfile) -> CatalogEntry {
+    ott::parse_m3u(
+        "#EXTM3U\n#EXTINF:-1 tvg-id=\"news\",News\nhttp://127.0.0.1/news.ts\n",
+        profile,
+    )
+    .unwrap()
+    .entries
+    .remove(0)
+}
