+        assert!(retry_ready(&mut at, now.wrapping_add(30000)));
+    }
+    #[test]
+    fn external_art_never_accepts_local_files_credentials_or_unbounded_sizes() {
+        for url in [
+            "file:///etc/passwd",
+            "https://user:pass@host.invalid/a",
+            "https://host.invalid/a\n",
+            "javascript:alert(1)",
