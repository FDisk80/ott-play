+//! Off-frame HTTP client for the process-owned loopback companion only.
+//!
+//! A direct socket deliberately bypasses environment HTTP proxies. The capability in the
+//! request path must never be forwarded to another host, a redirect, or a proxy. This is a
+//! bounded JSON control plane, not a replacement for the application's media transport.
+use super::protocol::{self, Endpoint, Error, Reply, Request};
+use plx_base::task::{
+    time::{Budget, Deadline},
+    OffFrame,
+};
+use std::io::{self, BufRead, BufReader, Read, Write};
+use std::net::{Ipv4Addr, SocketAddr, SocketAddrV4, TcpStream};
+use std::time::Duration;
+
+pub struct Client {
+    endpoint: Endpoint,
+}
+
+impl Client {
+    pub fn new(endpoint: Endpoint) -> Self {
+        Self { endpoint }
+    }
+
+    pub fn endpoint(&self) -> &Endpoint {
+        &self.endpoint
+    }
+
+    /// Cancellation is checked at least every 200 ms while the peer is stalled. Cancelling a
+    /// Create after sending it may leave a lease whose ID is unknown: its process owner must
+    /// stop that helper. Media-only cancellation should instead accept and DELETE the reply.
+    pub fn execute_cancellable(
+        &self,
+        worker: &OffFrame,
+        request: &Request,
+        cancelled: &dyn Fn() -> bool,
+    ) -> Result<Reply, Error> {
+        let prepared = request.prepare()?;
+        if cancelled() {
+            return Err(Error("companion_cancelled"));
+        }
+        let deadline = Deadline::after(worker, Duration::from_secs(25));
+        let address = SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::LOCALHOST, self.endpoint.port()));
+        let socket = connect(worker, address, cancelled)?;
+        let mut stream = DeadlineStream {
+            socket,
+            deadline,
+            cancelled,
+            worker,
+        };
+        let user_agent = plx_net::net::user_agent_header_line();
+        let header = format!("{} {} HTTP/1.1\r\nHost: 127.0.0.1:{}\r\n{user_agent}Accept: application/json\r\nAccept-Encoding: identity\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+            prepared.method, self.endpoint.path(&prepared.route), self.endpoint.port(), prepared.body.len());
+        stream.write_all(header.as_bytes()).map_err(io_error)?;
+        stream.write_all(&prepared.body).map_err(io_error)?;
+        let response = read_response(&mut BufReader::with_capacity(8192, stream))?;
+        if deadline.expired(worker) {
+            return Err(Error("companion_timeout"));
+        }
+        protocol::decode(&self.endpoint, request, response.status, &response.body)
+    }
+}
+
+fn connect(
+    worker: &OffFrame,
+    address: SocketAddr,
+    cancelled: &dyn Fn() -> bool,
+) -> Result<TcpStream, Error> {
+    let budget = Budget::start(worker, Duration::from_secs(2));
+    loop {
+        if cancelled() {
+            return Err(Error("companion_cancelled"));
+        }
+        let remaining = budget.remaining(worker);
+        if remaining.is_zero() {
+            return Err(Error("companion_timeout"));
+        }
+        match TcpStream::connect_timeout(&address, remaining.min(Duration::from_millis(200))) {
+            Ok(socket) => return Ok(socket),
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    io::ErrorKind::TimedOut
+                        | io::ErrorKind::WouldBlock
+                        | io::ErrorKind::Interrupted
+                ) => {}
+            Err(error) => return Err(io_error(error)),
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Cancelled;
+impl std::fmt::Display for Cancelled {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("companion_cancelled")
+    }
+}
+impl std::error::Error for Cancelled {}
+
+struct DeadlineStream<'a> {
+    socket: TcpStream,
+    deadline: Deadline,
+    cancelled: &'a dyn Fn() -> bool,
+    worker: &'a OffFrame,
+}
+impl DeadlineStream<'_> {
+    fn remaining(&self) -> io::Result<Duration> {
+        if (self.cancelled)() {
+            return Err(io::Error::new(io::ErrorKind::ConnectionAborted, Cancelled));
+        }
+        let remaining = self.deadline.remaining(self.worker);
+        if remaining.is_zero() {
+            Err(io::ErrorKind::TimedOut.into())
+        } else {
+            Ok(remaining)
+        }
+    }
+}
+impl Read for DeadlineStream<'_> {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        loop {
+            self.socket
+                .set_read_timeout(Some(self.remaining()?.min(Duration::from_millis(200))))?;
+            match self.socket.read(bytes) {
+                Err(error)
+                    if matches!(
+                        error.kind(),
+                        io::ErrorKind::TimedOut
+                            | io::ErrorKind::WouldBlock
+                            | io::ErrorKind::Interrupted
+                    ) => {}
+                result => return result,
+            }
+        }
+    }
+}
+impl Write for DeadlineStream<'_> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        loop {
+            self.socket
+                .set_write_timeout(Some(self.remaining()?.min(Duration::from_millis(200))))?;
+            match self.socket.write(bytes) {
+                Err(error)
+                    if matches!(
+                        error.kind(),
+                        io::ErrorKind::TimedOut
+                            | io::ErrorKind::WouldBlock
+                            | io::ErrorKind::Interrupted
+                    ) => {}
+                result => return result,
+            }
+        }
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+struct Response {
+    status: u16,
+    body: Vec<u8>,
+}
+
+fn io_error(error: io::Error) -> Error {
+    if error.get_ref().is_some_and(|inner| inner.is::<Cancelled>()) {
+        return Error("companion_cancelled");
+    }
+    match error.kind() {
+        io::ErrorKind::TimedOut | io::ErrorKind::WouldBlock => Error("companion_timeout"),
+        io::ErrorKind::UnexpectedEof => Error("companion_response_truncated"),
+        _ => Error("companion_unavailable"),
+    }
+}
+
+/// Read one CRLF-terminated line under a shared byte budget. Unlike read_until, this never
+/// allocates an unbounded unterminated line, including for response headers and chunk extensions.
+fn line<R: BufRead>(reader: &mut R, remaining: &mut usize) -> Result<Vec<u8>, Error> {
+    let mut line = Vec::new();
+    loop {
+        let available = reader.fill_buf().map_err(io_error)?;
+        if available.is_empty() {
+            return Err(Error("companion_response_truncated"));
+        }
+        let end = available.iter().position(|byte| *byte == b'\n');
+        let count = end.map_or(available.len(), |position| position + 1);
+        if count > *remaining {
+            return Err(Error("companion_response_limit"));
+        }
+        line.extend_from_slice(&available[..count]);
+        reader.consume(count);
+        *remaining -= count;
+        if end.is_some() {
+            break;
+        }
+    }
+    if !line.ends_with(b"\r\n") {
+        return Err(Error("companion_http_invalid"));
+    }
+    line.truncate(line.len() - 2);
+    Ok(line)
+}
+
+fn header(line: &[u8]) -> Result<(&str, &str), Error> {
+    let value = std::str::from_utf8(line).map_err(|_| Error("companion_http_invalid"))?;
+    let (name, value) = value
+        .split_once(':')
+        .ok_or(Error("companion_http_invalid"))?;
+    if name.is_empty()
+        || !name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"!#$%&'*+-.^_`|~".contains(&b))
+        || value.bytes().any(|b| b.is_ascii_control() && b != b'\t')
+    {
+        return Err(Error("companion_http_invalid"));
+    }
+    Ok((name, value.trim_matches([' ', '\t'])))
+}
+
+fn read_response<R: BufRead>(reader: &mut R) -> Result<Response, Error> {
+    let mut header_budget = 16 * 1024;
+    let status_line = line(reader, &mut header_budget)?;
+    let status_line =
+        std::str::from_utf8(&status_line).map_err(|_| Error("companion_http_invalid"))?;
+    let mut parts = status_line.splitn(3, ' ');
+    let version = parts.next().unwrap_or_default();
+    let status = parts.next().unwrap_or_default();
+    if !matches!(version, "HTTP/1.0" | "HTTP/1.1")
+        || status.len() != 3
+        || !status.bytes().all(|b| b.is_ascii_digit())
+    {
+        return Err(Error("companion_http_invalid"));
+    }
+    let status: u16 = status
+        .parse()
+        .map_err(|_| Error("companion_http_invalid"))?;
+    if !(200..600).contains(&status) {
+        return Err(Error("companion_http_invalid"));
+    }
+    let mut length = None;
+    let mut chunked = false;
+    loop {
+        let bytes = line(reader, &mut header_budget)?;
+        if bytes.is_empty() {
+            break;
+        }
+        let (name, value) = header(&bytes)?;
+        if name.eq_ignore_ascii_case("content-length") {
+            if length.is_some() || value.is_empty() || !value.bytes().all(|b| b.is_ascii_digit()) {
+                return Err(Error("companion_http_invalid"));
+            }
+            let count: usize = value
+                .parse()
+                .map_err(|_| Error("companion_response_limit"))?;
+            if count > protocol::RESPONSE_BYTES {
+                return Err(Error("companion_response_limit"));
+            }
+            length = Some(count);
+        } else if name.eq_ignore_ascii_case("transfer-encoding") {
+            if chunked || !value.eq_ignore_ascii_case("chunked") {
+                return Err(Error("companion_http_invalid"));
+            }
+            chunked = true;
+        } else if name.eq_ignore_ascii_case("content-encoding")
+            && !value.eq_ignore_ascii_case("identity")
+        {
+            return Err(Error("companion_http_invalid"));
+        }
+    }
+    if chunked && length.is_some() {
+        return Err(Error("companion_http_invalid"));
+    }
+    if status == 204 {
+        if chunked || length.is_some_and(|n| n != 0) {
+            return Err(Error("companion_http_invalid"));
+        }
+        return Ok(Response {
+            status,
+            body: Vec::new(),
+        });
+    }
+    let body = if chunked {
+        read_chunked(reader)?
+    } else if let Some(count) = length {
+        let mut bytes = vec![0; count];
+        reader.read_exact(&mut bytes).map_err(io_error)?;
+        bytes
+    } else {
+        let mut bytes = Vec::new();
+        let mut buffer = [0; 8192];
+        loop {
+            let count = reader.read(&mut buffer).map_err(io_error)?;
+            if count == 0 {
+                break;
+            }
+            if count > protocol::RESPONSE_BYTES.saturating_sub(bytes.len()) {
+                return Err(Error("companion_response_limit"));
+            }
+            bytes.extend_from_slice(&buffer[..count]);
+        }
+        bytes
+    };
+    Ok(Response { status, body })
+}
+
+fn read_chunked<R: BufRead>(reader: &mut R) -> Result<Vec<u8>, Error> {
+    let mut body = Vec::new();
+    for _ in 0..8192 {
+        let size = line(reader, &mut 128)?;
+        let size = std::str::from_utf8(&size).map_err(|_| Error("companion_http_invalid"))?;
+        if size.bytes().any(|b| b.is_ascii_control()) {
+            return Err(Error("companion_http_invalid"));
+        }
+        let size = size.split(';').next().unwrap_or_default();
+        if size.is_empty() || size.len() > 16 || !size.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(Error("companion_http_invalid"));
+        }
+        let size =
+            usize::from_str_radix(size, 16).map_err(|_| Error("companion_response_limit"))?;
+        if size == 0 {
+            let mut trailer_budget = 16 * 1024;
+            loop {
+                let bytes = line(reader, &mut trailer_budget)?;
+                if bytes.is_empty() {
+                    return Ok(body);
+                }
+                let (name, _) = header(&bytes)?;
+                if ["content-length", "transfer-encoding", "content-encoding"]
+                    .iter()
+                    .any(|key| name.eq_ignore_ascii_case(key))
+                {
+                    return Err(Error("companion_http_invalid"));
+                }
+            }
+        }
+        if size > protocol::RESPONSE_BYTES.saturating_sub(body.len()) {
+            return Err(Error("companion_response_limit"));
+        }
+        let start = body.len();
+        body.resize(start + size, 0);
+        reader.read_exact(&mut body[start..]).map_err(io_error)?;
+        let mut ending = [0; 2];
+        reader.read_exact(&mut ending).map_err(io_error)?;
+        if ending != *b"\r\n" {
+            return Err(Error("companion_http_invalid"));
+        }
+    }
+    Err(Error("companion_response_limit"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Cursor;
+
+    fn parse(bytes: &[u8]) -> Result<Response, Error> {
+        read_response(&mut BufReader::with_capacity(7, Cursor::new(bytes)))
+    }
+
+    #[test]
+    fn cancellation_before_connect_does_not_contact_a_listener() {
+        let client = Client::new(Endpoint::new(8793, "a".repeat(32)).unwrap());
+        assert_eq!(
+            client
+                .execute_cancellable(&OffFrame::for_test(), &Request::Capabilities, &|| true)
+                .err()
+                .unwrap()
+                .code(),
+            "companion_cancelled"
+        );
+    }
+
+    #[test]
+    fn delete_sends_one_canonical_user_agent_between_host_and_accept() {
+        plx_net::net::set_user_agent(plx_plex::plex::identity::user_agent()).unwrap();
+        let canonical = plx_net::net::user_agent_header_line();
+        assert!(!canonical.is_empty());
+        let listener = std::net::TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let peer = std::thread::spawn(move || {
+            let worker = OffFrame::for_test();
+            let budget = Budget::start(&worker, Duration::from_secs(2));
+            let mut socket = loop {
+                match listener.accept() {
+                    Ok((socket, _)) => break socket,
+                    Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                        assert!(budget.wait(
+                            &worker,
+                            Duration::from_millis(5),
+                            Duration::from_millis(5),
+                            &|| false,
+                        ));
+                    }
+                    Err(error) => panic!("loopback accept failed: {error}"),
+                }
+            };
+            socket.set_nonblocking(false).unwrap();
+            socket
+                .set_write_timeout(Some(Duration::from_secs(2)))
+                .unwrap();
+            let mut request = Vec::new();
+            while !request.ends_with(b"\r\n\r\n") {
+                let remaining = budget.remaining(&worker);
+                assert!(!remaining.is_zero(), "request deadline exceeded");
+                socket.set_read_timeout(Some(remaining)).unwrap();
+                let mut bytes = [0; 512];
+                let count = socket.read(&mut bytes).unwrap();
+                assert!(count > 0, "request ended before its headers");
+                request.extend_from_slice(&bytes[..count]);
+                assert!(request.len() <= 16 * 1024, "request headers exceeded limit");
+            }
+            socket
+                .write_all(b"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")
+                .unwrap();
+            String::from_utf8(request).unwrap()
+        });
+        let endpoint = Endpoint::new(port, "a".repeat(32)).unwrap();
+        let expected_path = endpoint.path("sessions/test-session");
+        let reply = Client::new(endpoint).execute_cancellable(
+            &OffFrame::for_test(),
+            &Request::Delete {
+                id: "test-session".into(),
+            },
+            &|| false,
+        );
+        let request = peer.join().unwrap();
+        assert!(matches!(reply, Ok(Reply::Deleted)));
+        let lines: Vec<_> = request.split("\r\n").collect();
+        assert_eq!(lines[0], format!("DELETE {expected_path} HTTP/1.1"));
+        let user_agents: Vec<_> = lines
+            .iter()
+            .copied()
+            .filter(|line| {
+                line.split_once(':')
+                    .is_some_and(|(name, _)| name.eq_ignore_ascii_case("user-agent"))
+            })
+            .collect();
+        assert_eq!(user_agents, [canonical.trim_end_matches("\r\n")]);
+        let host = format!("Host: 127.0.0.1:{port}");
+        assert!(lines.windows(3).any(|window| window
+            == [
+                host.as_str(),
+                canonical.trim_end_matches("\r\n"),
+                "Accept: application/json",
+            ]));
+        assert!(lines.contains(&"Content-Length: 0"));
+    }
+
+    #[test]
+    fn stalled_socket_observes_cancellation_and_absolute_deadline() {
+        for cancel in [true, false] {
+            let listener = std::net::TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+            let address = listener.local_addr().unwrap();
+            let (release, wait) = std::sync::mpsc::channel::<()>();
+            let peer = std::thread::spawn(move || {
+                let (socket, _) = listener.accept().unwrap();
+                let _ = wait.recv_timeout(Duration::from_secs(3));
+                drop(socket);
+            });
+            let socket = TcpStream::connect(address).unwrap();
+            let worker = OffFrame::for_test();
+            let budget = Budget::start(&worker, Duration::from_secs(2));
+            let check = || cancel && budget.spent(&worker) >= Duration::from_millis(20);
+            let deadline = Deadline::after(
+                &worker,
+                if cancel {
+                    Duration::from_secs(2)
+                } else {
+                    Duration::from_millis(50)
+                },
+            );
+            let mut stream = DeadlineStream {
+                socket,
+                deadline,
+                cancelled: &check,
+                worker: &worker,
+            };
+            let error = io_error(stream.read(&mut [0]).unwrap_err());
+            let _ = release.send(());
+            peer.join().unwrap();
+            assert_eq!(
+                error.code(),
+                if cancel {
+                    "companion_cancelled"
+                } else {
+                    "companion_timeout"
+                }
+            );
+            assert!(budget.spent(&worker) < Duration::from_secs(2));
+        }
+    }
+
+    #[test]
+    fn fixed_length_and_no_content() {
+        let response = parse(b"HTTP/1.1 200 OK\r\nContent-Length: 7\r\n\r\n{\"a\":1}").unwrap();
+        assert_eq!(response.status, 200);
+        assert_eq!(response.body, br#"{"a":1}"#);
+        assert!(parse(b"HTTP/1.1 204 No Content\r\n\r\n")
+            .unwrap()
+            .body
+            .is_empty());
+    }
+
+    #[test]
+    fn chunked_with_trailer_and_close_delimited() {
+        let response = parse(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3;foo=bar\r\nabc\r\n2\r\nde\r\n0\r\nX-Status: done\r\n\r\n").unwrap();
+        assert_eq!(response.body, b"abcde");
+        assert_eq!(parse(b"HTTP/1.0 200 OK\r\n\r\nabc").unwrap().body, b"abc");
+    }
+
+    #[test]
+    fn rejects_ambiguous_or_invalid_framing() {
+        for input in [
+            &b"HTTP/1.1 200 OK\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n"[..],
+            b"HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\na",
+            b"HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n",
+            b"HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\n\r\n",
+            b"HTTP/1.1 200 OK\nContent-Length: 0\n\n",
+            b"HTTP/1.1 204 No Content\r\nContent-Length: 1\r\n\r\nx",
+            b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n-1\r\n",
+            b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1\r\naXX0\r\n\r\n",
+        ] {
+            assert!(parse(input).is_err());
+        }
+    }
+
+    #[test]
+    fn rejects_truncated_and_oversized_responses() {
+        for input in [
+            &b"HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nab"[..],
+            b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nab",
+            b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n",
+        ] {
+            assert_eq!(
+                parse(input).err().unwrap().code(),
+                "companion_response_truncated"
+            );
+        }
+        let big_length = format!(
+            "HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n",
+            protocol::RESPONSE_BYTES + 1
+        );
+        assert_eq!(
+            parse(big_length.as_bytes()).err().unwrap().code(),
+            "companion_response_limit"
+        );
+        let long_header = format!("HTTP/1.1 200 OK\r\nX-Test: {}", "a".repeat(16 * 1024));
+        assert_eq!(
+            parse(long_header.as_bytes()).err().unwrap().code(),
+            "companion_response_limit"
+        );
+        let big_chunk = format!(
+            "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n{:x}\r\n",
+            protocol::RESPONSE_BYTES + 1
+        );
+        assert_eq!(
+            parse(big_chunk.as_bytes()).err().unwrap().code(),
+            "companion_response_limit"
+        );
+    }
+}
diff --git a/rust-modules/src/app/ott_companion/erasure.rs b/rust-modules/src/app/ott_companion/erasure.rs
new file mode 100644
index 0000000000000000000000000000000000000000..07732e1fda75b57056a2ce817e657d7a3d1d3062
--- /dev/null
+++ b/rust-modules/src/app/ott_companion/erasure.rs
@@ -0,0 +1,470 @@
+//! The retired helper owns its data until its worker has reaped the child.
+//! No selected media path enters this adapter. Cleanup is fd-relative inside
+//! the fixed installation-owned ott-companion directory and never follows links.
+use super::*;
+use std::ffi::CStr;
+use std::os::fd::FromRawFd;
+use std::path::Component;
+use std::sync::mpsc::TryRecvError;
+
+const MAX_ENTRIES: usize = 20_000;
+const MAX_DEPTH: usize = 16;
+const POLL: Duration = Duration::from_millis(10);
+const PENDING: Error = Error("companion_erasure_pending");
+const FAILED: Error = Error("companion_erasure_failed");
+const UNSAFE: Error = Error("companion_erasure_unsafe");
+
+struct Retired {
+    worker: Option<JoinHandle<()>>,
+    root: Option<PathBuf>,
+}
+
+/// Keep this value for retry after a timeout. Only one cleanup worker can run
+/// for it at a time; a timed-out caller does not detach another concurrent wipe.
+pub struct ErasureStop {
+    retired: Arc<Mutex<Retired>>,
+    ticket: Option<Receiver<Result<(), Error>>>,
+    complete: bool,
+}
+
+impl ErasureStop {
+    /// Delete before Runtime construction still owns the install's helper data.
+    /// The caller supplies the same trusted root used by Supervisor::new.
+    pub(crate) fn owned_data_without_worker(root: PathBuf) -> Self {
+        Self::new(None, Some(root))
+    }
+
+    pub(super) fn new(worker: Option<JoinHandle<()>>, root: Option<PathBuf>) -> Self {
+        let complete = worker.is_none() && root.is_none();
+        Self {
+            retired: Arc::new(Mutex::new(Retired { worker, root })),
+            ticket: None,
+            complete,
+        }
+    }
+
+    /// Storage-worker boundary, never a frame callback. Both waiting and cleanup
+    /// have a fixed allowance. A filesystem syscall cannot be interrupted, so
+    /// its ticket is retained until completion instead of spawning a duplicate.
+    pub fn finish(&mut self, allowance: Duration) -> Result<(), Error> {
+        if self.complete {
+            return Ok(());
+        }
+        if let Some(ticket) = &self.ticket {
+            match ticket.try_recv() {
+                Ok(Ok(())) => {
+                    self.complete = true;
+                    self.ticket = None;
+                    return Ok(());
+                }
+                Ok(Err(_)) | Err(TryRecvError::Disconnected) => self.ticket = None,
+                Err(TryRecvError::Empty) => {}
+            }
+        }
+        if allowance.is_zero() {
+            return Err(PENDING);
+        }
+        if self.ticket.is_none() {
+            let retired = self.retired.clone();
+            let (sender, receiver) = mpsc::sync_channel(1);
+            if !plx_base::task::spawn_off_frame("ott-companion-erasure", move |off| {
+                let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    finish_retired(off, &retired, allowance)
+                }))
+                .unwrap_or(Err(FAILED));
+                let _ = sender.send(result);
+                plx_machine::idle::invalidate();
+            }) {
+                return Err(Error("companion_erasure_worker_unavailable"));
+            }
+            self.ticket = Some(receiver);
+        }
+        let mut result = None;
+        plx_base::task::time::drain_for(
+            self.ticket.as_ref().expect("cleanup ticket"),
+            allowance,
+            |value| {
+                result = Some(value);
+                false
+            },
+        );
+        match result {
+            Some(value) => {
+                self.ticket = None;
+                self.complete = value.is_ok();
+                value
+            }
+            None => Err(PENDING),
+        }
+    }
+}
+
+fn finish_retired(
+    off: &OffFrame,
+    retired: &Mutex<Retired>,
+    allowance: Duration,
+) -> Result<(), Error> {
+    let budget = Budget::start(off, allowance);
+    // This mutex belongs only to the single cleanup worker, not the UI thread.
+    let mut retired = lock(retired);
+    while retired
+        .worker
+        .as_ref()
+        .is_some_and(|worker| !worker.is_finished())
+    {
+        if !budget.wait(off, POLL, POLL, &|| false) {
+            return Err(PENDING);
+        }
+    }
+    if let Some(worker) = retired.worker.take() {
+        plx_base::task::join("ott-companion-erased-owner", worker);
+    }
+    if let Some(root) = &retired.root {
+        erase_root(off, budget, root)?;
+    }
+    retired.root = None;
+    Ok(())
+}
+
+fn check_budget(off: &OffFrame, budget: Budget) -> Result<(), Error> {
+    if budget.expired(off) {
+        Err(PENDING)
+    } else {
+        Ok(())
+    }
+}
+
+fn open_directory(parent: &File, name: &CStr) -> io::Result<File> {
+    let fd = unsafe {
+        libc::openat(
+            parent.as_raw_fd(),
+            name.as_ptr(),
+            libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+        )
+    };
+    if fd < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(unsafe { File::from_raw_fd(fd) })
+    }
+}
+
+fn entry_stat(parent: &File, name: &CStr) -> io::Result<libc::stat> {
+    let mut result = std::mem::MaybeUninit::<libc::stat>::uninit();
+    let status = unsafe {
+        libc::fstatat(
+            parent.as_raw_fd(),
+            name.as_ptr(),
+            result.as_mut_ptr(),
+            libc::AT_SYMLINK_NOFOLLOW,
+        )
+    };
+    if status == 0 {
+        Ok(unsafe { result.assume_init() })
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+struct Ancestors {
+    directories: Vec<File>,
+    names: Vec<CString>,
+}
+
+impl Ancestors {
+    fn parent(&self) -> &File {
+        self.directories
+            .last()
+            .expect("filesystem root is retained")
+    }
+
+    fn validate(&self, off: &OffFrame, budget: Budget) -> Result<(), Error> {
+        // An fd still opens the old directory after a rename. Check every named
+        // edge back to /, not only the root name inside the retained parent fd.
+        for index in (0..self.names.len()).rev() {
+            check_budget(off, budget)?;
+            same_directory(
+                &self.directories[index],
+                &self.names[index],
+                &self.directories[index + 1],
+            )?;
+        }
+        Ok(())
+    }
+
+    fn absent(&self, off: &OffFrame, budget: Budget, name: &CStr) -> Result<(), Error> {
+        self.validate(off, budget)?;
+        match entry_stat(self.parent(), name) {
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            _ => return Err(UNSAFE),
+        }
+        self.validate(off, budget)
+    }
+}
+
+fn same_directory(parent: &File, name: &CStr, held: &File) -> Result<(), Error> {
+    let actual = held.metadata().map_err(|_| FAILED)?;
+    let named = entry_stat(parent, name).map_err(|_| UNSAFE)?;
+    if named.st_dev as u64 != actual.dev()
+        || named.st_ino as u64 != actual.ino()
+        || named.st_mode & libc::S_IFMT != libc::S_IFDIR
+    {
+        return Err(UNSAFE);
+    }
+    Ok(())
+}
+
+fn open_ancestors(off: &OffFrame, budget: Budget, root: &Path) -> Result<Option<Ancestors>, Error> {
+    // Only the helper's own fixed directory is eligible, never a Local profile.
+    if !root.is_absolute() || root.file_name().is_none_or(|name| name != "ott-companion") {
+        return Err(UNSAFE);
+    }
+    let components: Vec<_> = root.components().collect();
+    if components.len() > 64 || !matches!(components.first(), Some(Component::RootDir)) {
+        return Err(UNSAFE);
+    }
+    let mut ancestors = Ancestors {
+        directories: vec![File::open("/").map_err(|_| FAILED)?],
+        names: Vec::new(),
+    };
+    for component in &components[1..components.len() - 1] {
+        check_budget(off, budget)?;
+        let Component::Normal(name) = component else {
+            return Err(UNSAFE);
+        };
+        let name = CString::new(name.as_bytes()).map_err(|_| UNSAFE)?;
+        let directory = match open_directory(ancestors.parent(), &name) {
+            Ok(directory) => directory,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                ancestors.absent(off, budget, &name)?;
+                return Ok(None);
+            }
+            Err(_) => return Err(UNSAFE),
+        };
+        ancestors.directories.push(directory);
+        ancestors.names.push(name);
+    }
+    ancestors.validate(off, budget)?;
+    Ok(Some(ancestors))
+}
+
+fn erase_root(off: &OffFrame, budget: Budget, root: &Path) -> Result<(), Error> {
+    let Some(ancestors) = open_ancestors(off, budget, root)? else {
+        return Ok(());
+    };
+    check_budget(off, budget)?;
+    let name = CString::new("ott-companion").expect("fixed directory name");
+    let directory = match open_directory(ancestors.parent(), &name) {
+        Ok(directory) => directory,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            ancestors.parent().sync_all().map_err(|_| FAILED)?;
+            return ancestors.absent(off, budget, &name);
+        }
+        Err(_) => return Err(UNSAFE),
+    };
+    erase_opened_root(off, budget, &ancestors, &name, &directory)
+}
+
+fn erase_opened_root(
+    off: &OffFrame,
+    budget: Budget,
+    ancestors: &Ancestors,
+    name: &CStr,
+    directory: &File,
+) -> Result<(), Error> {
+    ancestors.validate(off, budget)?;
+    same_directory(ancestors.parent(), name, directory)?;
+    let metadata = directory.metadata().map_err(|_| FAILED)?;
+    if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o022 != 0 {
+        return Err(UNSAFE);
+    }
+    let mut count = 0;
+    erase_directory(off, budget, directory, metadata.dev(), 0, &mut count)?;
+    ancestors.validate(off, budget)?;
+    remove_directory(off, budget, ancestors.parent(), name, directory)?;
+    ancestors.parent().sync_all().map_err(|_| FAILED)?;
+    ancestors.absent(off, budget, name)
+}
+
+struct Directory(*mut libc::DIR);
+impl Drop for Directory {
+    fn drop(&mut self) {
+        unsafe { libc::closedir(self.0) };
+    }
+}
+
+fn directory_stream(directory: &File) -> Result<Directory, Error> {
+    let duplicate = unsafe { libc::fcntl(directory.as_raw_fd(), libc::F_DUPFD_CLOEXEC, 0) };
+    if duplicate < 0 {
+        return Err(FAILED);
+    }
+    let stream = unsafe { libc::fdopendir(duplicate) };
+    if stream.is_null() {
+        unsafe { libc::close(duplicate) };
+        return Err(FAILED);
+    }
+    Ok(Directory(stream))
+}
+
+fn next_entry(directory: &Directory) -> Result<Option<CString>, Error> {
+    // POSIX distinguishes end-of-directory from an error through errno.
+    unsafe {
+        #[cfg(target_os = "macos")]
+        let errno = libc::__error();
+        #[cfg(not(target_os = "macos"))]
+        let errno = libc::__errno_location();
+        *errno = 0;
+        let entry = libc::readdir(directory.0);
+        if entry.is_null() {
+            return if *errno == 0 { Ok(None) } else { Err(FAILED) };
+        }
+        Ok(Some(CStr::from_ptr((*entry).d_name.as_ptr()).to_owned()))
+    }
+}
+
+fn erase_directory(
+    off: &OffFrame,
+    budget: Budget,
+    directory: &File,
+    device: u64,
+    depth: usize,
+    count: &mut usize,
+) -> Result<(), Error> {
+    if depth > MAX_DEPTH {
+        return Err(UNSAFE);
+    }
+    let entries = directory_stream(directory)?;
+    loop {
+        check_budget(off, budget)?;
+        let Some(name) = next_entry(&entries)? else {
+            break;
+        };
+        if matches!(name.to_bytes(), b"." | b"..") {
+            continue;
+        }
+        *count += 1;
+        if *count > MAX_ENTRIES {
+            return Err(UNSAFE);
+        }
+        let metadata = match entry_stat(directory, &name) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
+            Err(_) => return Err(FAILED),
+        };
+        if metadata.st_uid != unsafe { libc::geteuid() } || metadata.st_dev as u64 != device {
+            return Err(UNSAFE);
+        }
+        if metadata.st_mode & libc::S_IFMT == libc::S_IFDIR {
+            let child = open_directory(directory, &name).map_err(|_| UNSAFE)?;
+            let actual = child.metadata().map_err(|_| FAILED)?;
+            if actual.dev() != device || actual.ino() != metadata.st_ino as u64 {
+                return Err(UNSAFE);
+            }
+            erase_directory(off, budget, &child, device, depth + 1, count)?;
+            remove_directory(off, budget, directory, &name, &child)?;
+        } else {
+            // unlinkat removes a symlink itself, never the file it names.
+            check_budget(off, budget)?;
+            if unsafe { libc::unlinkat(directory.as_raw_fd(), name.as_ptr(), 0) } != 0 {
+                return Err(FAILED);
+            }
+        }
+    }
+    Ok(())
+}
+
+fn remove_directory(
+    off: &OffFrame,
+    budget: Budget,
+    parent: &File,
+    name: &CStr,
+    directory: &File,
+) -> Result<(), Error> {
+    check_budget(off, budget)?;
+    let actual = directory.metadata().map_err(|_| FAILED)?;
+    let named = entry_stat(parent, name).map_err(|_| FAILED)?;
+    if named.st_dev as u64 != actual.dev()
+        || named.st_ino as u64 != actual.ino()
+        || named.st_mode & libc::S_IFMT != libc::S_IFDIR
+    {
+        return Err(UNSAFE);
+    }
+    if unsafe { libc::unlinkat(parent.as_raw_fd(), name.as_ptr(), libc::AT_REMOVEDIR) } != 0 {
+        return Err(FAILED);
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn replaced_parent_or_ancestor_cannot_report_success_for_the_old_root() {
+        for replace_parent in [true, false] {
+            let base = plx_base::testscratch::process_dir(if replace_parent {
+                "companion-erase-parent-swap"
+            } else {
+                "companion-erase-ancestor-swap"
+            })
+            .canonicalize()
+            .unwrap();
+            let top = base.join("top");
+            let parent = top.join("parent");
+            let root = parent.join("ott-companion");
+            fs::create_dir_all(&root).unwrap();
+            fs::write(root.join("old-data"), b"old owned data").unwrap();
+            let off = OffFrame::for_test();
+            let budget = Budget::start(&off, Duration::from_secs(2));
+            let ancestors = open_ancestors(&off, budget, &root).unwrap().unwrap();
+            let name = CString::new("ott-companion").unwrap();
+            let held = open_directory(ancestors.parent(), &name).unwrap();
+
+            // The previously opened descriptor remains valid, but no longer
+            // names the installation path the user asked us to erase.
+            let retired = base.join("retired");
+            fs::rename(if replace_parent { &parent } else { &top }, &retired).unwrap();
+            fs::create_dir_all(&root).unwrap();
+            fs::write(root.join("new-data"), b"replacement data").unwrap();
+            assert_eq!(
+                erase_opened_root(&off, budget, &ancestors, &name, &held),
+                Err(UNSAFE)
+            );
+            assert_eq!(
+                fs::read(root.join("new-data")).unwrap(),
+                b"replacement data"
+            );
+            let old_root = if replace_parent {
+                retired.join("ott-companion")
+            } else {
+                retired.join("parent/ott-companion")
+            };
+            assert_eq!(
+                fs::read(old_root.join("old-data")).unwrap(),
+                b"old owned data"
+            );
+        }
+    }
+
+    #[test]
+    fn root_recreated_after_removal_is_not_proven_absent() {
+        let base = plx_base::testscratch::process_dir("companion-erase-root-recreated")
+            .canonicalize()
+            .unwrap();
+        let root = base.join("ott-companion");
+        fs::create_dir(&root).unwrap();
+        let off = OffFrame::for_test();
+        let budget = Budget::start(&off, Duration::from_secs(2));
+        let ancestors = open_ancestors(&off, budget, &root).unwrap().unwrap();
+        let name = CString::new("ott-companion").unwrap();
+        let held = open_directory(ancestors.parent(), &name).unwrap();
+        remove_directory(&off, budget, ancestors.parent(), &name, &held).unwrap();
+        fs::create_dir(&root).unwrap();
+        fs::write(root.join("new-data"), b"replacement data").unwrap();
+        assert_eq!(ancestors.absent(&off, budget, &name), Err(UNSAFE));
+        assert_eq!(
+            fs::read(root.join("new-data")).unwrap(),
+            b"replacement data"
+        );
+    }
+}
