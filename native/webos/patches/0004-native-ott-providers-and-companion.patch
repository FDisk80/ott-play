+        assert_eq!(page.row_ids(), [RowId::Policy, RowId::Delete]);
+        assert_eq!(page.form.opening_key(), Some(RowKey(4)));
+        assert_eq!(page.key_of(RowId::Delete), 7);
+        assert!(page.band_labels().is_empty());
+    }
+
+    #[test]
+    fn stale_upload_keys_and_first_run_answers_cannot_record_or_delete() {
+        let _serial = plx_base::testlock::serial();
+        let cx = test_cx(&FixtureMeasure);
+        let (mut out, mut present) = sink();
+        for stage in [0, STAGE_PRODUCT | ERRORS_SHARED] {
+            let mut page = ConsentPage::first_run(EntryId(1), stage, &cx, &mut mk_fx(&mut out, &mut present));
+            assert_eq!(page.row_ids(), [RowId::Policy, RowId::Delete]);
+            out.clear();
+            for key in [0, 1, 2, 3, 5, 6] {
+                page.row_commit(key, &mut mk_fx(&mut out, &mut present));
+            }
+            page.band_commit(0, &mut mk_fx(&mut out, &mut present));
