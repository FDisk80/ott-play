+//! Application-owned catalogue IO. Pure parsers live in plx_data::ott.
+use plx_base::task::{time::Budget, OffFrame};
+use plx_data::ott::{self, Catalog, CatalogEntry, MediaLocator, ProviderKind, ProviderProfile};
+use serde_json::Value;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    mpsc::{SyncSender, TrySendError},
+    Arc,
+};
+
+#[path = "ott_local.rs"]
+mod local;
+#[path = "ott_server_library.rs"]
+mod server_library;
+#[path = "ott_vportal.rs"]
+mod vportal;
+
+pub(super) struct Resolved {
+    pub url: String,
+    pub lease: Option<super::ott_vportal_lease::Lease>,
+}
+
+pub(super) enum Event {
+    Batch(u64, Catalog),
+    Finished(u64, Result<(), &'static str>),
+}
+
+fn fetch(url: &str, body: Option<&Value>) -> Result<String, &'static str> {
+    if ott::http_url(url).is_none() {
+        return Err("Invalid provider address");
+    }
+    let encoded = body.map(Value::to_string);
+    let headers = if body.is_some() {
+        vec!["Content-Type: application/json".into()]
+    } else {
+        Vec::new()
+    };
+    let response = plx_net::net::request(
+        url,
+        &headers,
+        if body.is_some() { "POST" } else { "GET" },
+        encoded.as_deref().map(str::as_bytes),
+        plx_net::net::Timeouts {
+            connect_s: 8,
+            total_s: 25,
+            total_ms: 0,
+            low_speed_bps: 1,
+            low_speed_s: 10,
+        },
+        false,
+        Some(ott::MAX_CATALOG_BYTES),
+        None,
+    )
+    .ok_or("Provider request failed or timed out")?;
+    if !response.ok() {
+        return Err("Provider rejected the catalogue request");
+    }
+    String::from_utf8(response.body).map_err(|_| "Provider returned invalid text")
+}
+
+/// Called off-frame. Adopt a successful server lease before cancellation checks,
+/// so a response arriving after replacement cannot leak a transcoding session.
+pub(super) fn resolve_typed(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    entry: &CatalogEntry,
+    cancel: &AtomicBool,
+) -> Result<Resolved, &'static str> {
+    if cancel.load(Ordering::Acquire) {
+        return Err("Playback request cancelled");
+    }
+    profile.validate().map_err(|_| "Invalid provider profile")?;
+    let mut failure = None;
+    let resolved = match &entry.media {
+        MediaLocator::Http { url } => Resolved {
+            url: ott::http_url(url).ok_or("Invalid media address")?,
+            lease: None,
+        },
+        MediaLocator::VPortal { .. } => {
+            let resolved = vportal::resolve_typed(profile, entry, cancel)?;
+            let lease = resolved
+                .session
+                .map(|session| {
+                    super::ott_vportal_lease::Lease::start(session.stop, session.heartbeat)
+                })
+                .transpose()?;
+            failure = resolved.failure;
+            Resolved {
+                url: resolved.url,
+                lease,
+            }
+        }
+        MediaLocator::Local { .. } => Resolved {
+            url: local::resolve(profile, entry)?
+                .to_str()
+                .ok_or("Local path cannot be represented")?
+                .into(),
+            lease: None,
+        },
+        MediaLocator::ServerLibrary { .. } => Resolved {
+            url: server_library::resolve(profile, entry, cancel)?,
+            lease: None,
+        },
+        MediaLocator::Xtream { .. } | MediaLocator::Stalker { .. } => Resolved {
+            url: super::ott_provider_http::resolve_cancellable(worker, profile, entry, cancel)?,
+            lease: None,
+        },
+        MediaLocator::Plex { .. } => return Err("Plex playback uses its native session"),
+    };
+    complete_resolution(resolved, failure, cancel)
+}
+
+/// The resolver cannot admit its replacement until cleanup has settled. Drop
+/// only signals asynchronous cleanup, so a rejected result must wait here on
+/// the worker while it still owns the lease's completion barrier.
+fn complete_resolution(
+    mut resolved: Resolved,
+    failure: Option<&'static str>,
+    cancel: &AtomicBool,
+) -> Result<Resolved, &'static str> {
+    let error = failure.or_else(|| {
+        cancel
+            .load(Ordering::Acquire)
+            .then_some("Playback request cancelled")
+    });
+    if let Some(error) = error {
+        if let Some(lease) = resolved.lease.take() {
+            lease.finish_off_frame()?;
+        }
+        return Err(error);
+    }
+    Ok(resolved)
+}
+
+pub(super) fn start(
+    profile: ProviderProfile,
+    generation: u64,
+    cancel: Arc<AtomicBool>,
+    tx: SyncSender<Event>,
+    done: Arc<AtomicBool>,
+) -> bool {
+    super::ott_worker::spawn("ott-catalog", done, move |worker| {
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            scan(worker, &profile, generation, &cancel, &tx)
+        }))
+        .unwrap_or(Err("Catalogue worker failed"));
+        let _ = send_event(&tx, Event::Finished(generation, result), &cancel);
+        plx_machine::idle::invalidate();
+    })
+}
+
+fn send_event<T>(
+    tx: &SyncSender<T>,
+    mut event: T,
+    cancel: &AtomicBool,
+) -> Result<(), &'static str> {
+    loop {
+        if cancel.load(Ordering::Acquire) {
+            return Err("Catalogue cancelled");
+        }
+        match tx.try_send(event) {
+            Ok(()) => return Ok(()),
+            Err(TrySendError::Disconnected(_)) => return Err("Catalogue cancelled"),
+            Err(TrySendError::Full(value)) => {
+                event = value;
+                std::thread::sleep(std::time::Duration::from_millis(5));
+            }
+        }
+    }
+}
+
+fn send(
+    tx: &SyncSender<Event>,
+    generation: u64,
+    rows: Vec<CatalogEntry>,
+    cancel: &AtomicBool,
+) -> Result<(), &'static str> {
+    if rows.is_empty() {
+        return Ok(());
+    }
+    send_event(
+        tx,
+        Event::Batch(generation, Catalog { entries: rows }),
+        cancel,
+    )?;
+    plx_machine::idle::invalidate();
+    Ok(())
+}
+
+fn scan(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    generation: u64,
+    cancel: &AtomicBool,
+    tx: &SyncSender<Event>,
+) -> Result<(), &'static str> {
+    visit(worker, profile, cancel, &mut |rows| {
+        send(tx, generation, rows, cancel)
+    })
+}
+
+fn visit(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    cancel: &AtomicBool,
+    emit: &mut dyn FnMut(Vec<CatalogEntry>) -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    profile.validate().map_err(|_| "Invalid provider profile")?;
+    match profile.kind {
+        ProviderKind::M3u | ProviderKind::Xtream | ProviderKind::Stalker => {
+            super::ott_provider_http::visit(worker, profile, cancel, emit)?
+        }
+        ProviderKind::VPortal => vportal::visit(worker, profile, cancel, emit)?,
+        ProviderKind::Local if ott::http_url(&profile.source).is_some() => {
+            server_library::visit(worker, profile, cancel, emit)?
+        }
+        ProviderKind::Local => local::visit(profile, cancel, emit)?,
+        ProviderKind::Plex => super::ott_plex::visit(profile, cancel, emit)?,
+    }
+    Ok(())
+}
+
+/// Rebind an imported Favorite against the receiving client's own profile. No source
+/// address is taken from the portable document, and duplicate names cannot pick an
+/// arbitrary channel. The UI remains responsive while this worker searches.
+pub(super) fn find_favorite(
+    worker: &OffFrame,
+    profile: &ProviderProfile,
+    favorite: &ott::favorites::Favorite,
+    cancel: &AtomicBool,
+) -> Result<CatalogEntry, &'static str> {
+    use ott::favorites::Locator;
+    if let Locator::Local {
+        root_alias,
+        relative_path,
+    } = &favorite.locator
+    {
+        if profile.kind == ProviderKind::Local && ott::http_url(&profile.source).is_some() {
+            return server_library::find_favorite(profile, root_alias, relative_path, cancel);
+        }
+    }
+    let direct = match &favorite.locator {
+        Locator::Local { relative_path, .. } => Some(MediaLocator::Local {
+            relative_path: relative_path.clone(),
+        }),
+        Locator::Plex {
+            server_id,
+            rating_key,
+        } => Some(MediaLocator::Plex {
+            server_id: server_id.clone(),
+            rating_key: rating_key.clone(),
+        }),
+        _ => None,
+    };
+    if let Some(media) = direct {
+        return Ok(CatalogEntry {
+            id: favorite.identity(),
+            title: favorite.title.clone(),
+            category: String::new(),
+            description: String::new(),
+            poster: String::new(),
+            media,
+            duration_ms: None,
+            provider_id: None,
+            provider_id_field: None,
+        });
+    }
+    let mut found: Option<CatalogEntry> = None;
+    let budget = Budget::start(worker, std::time::Duration::from_secs(60));
+    const FOUND: &str = "Favorite identity located";
+    let mut accept = |rows: Vec<CatalogEntry>| {
+        if cancel.load(Ordering::Relaxed) {
+            return Err("Playback request cancelled");
+        }
+        if budget.expired(worker) {
+            return Err("Favorite lookup timed out");
+        }
+        for entry in rows {
+            if super::ott_runtime::legacy_id_collision(favorite, &entry) {
+                return Err("Favorite identity is ambiguous");
+            }
+            if super::ott_runtime::matches_entry(favorite, &entry) {
+                // An attested portal identity has already been scoped to its
+                // saved category by matches_entry. Scanning unrelated folders
+                // cannot make that provider-owned identity more precise.
+                if matches!(favorite.locator, Locator::VPortal { .. }) {
+                    found = Some(entry);
+                    return Err(FOUND);
+                }
+                if found
+                    .as_ref()
+                    .is_some_and(|old| !same_match(&favorite.locator, old, &entry))
+                {
+                    return Err("Favorite matches more than one item");
+                }
+                // Multiple folder aliases may expose one provider-owned VPortal
+                // item. Retain its canonical first occurrence instead of calling
+                // different UI row IDs ambiguous media identities.
+                if found.is_none() {
+                    found = Some(entry);
+                }
+            }
+        }
+        Ok(())
+    };
+    let result = if profile.kind == ProviderKind::VPortal {
+        vportal::visit_before(worker, profile, cancel, &mut accept, budget.deadline())
+    } else {
+        visit(worker, profile, cancel, &mut accept)
+    };
+    if let Err(error) = result {
+        if error != FOUND || found.is_none() {
+            return Err(error);
+        }
+    }
+    if cancel.load(Ordering::Relaxed) {
+        return Err("Playback request cancelled");
+    }
+    found.ok_or("Favorite is not available from this profile")
+}
+
+fn same_match(locator: &ott::favorites::Locator, old: &CatalogEntry, next: &CatalogEntry) -> bool {
+    if old.id == next.id {
+        return true;
+    }
+    if let ott::favorites::Locator::VPortal { id_field, id } = locator {
+        return old.provider_id.as_ref() == Some(id)
+            && next.provider_id.as_ref() == Some(id)
+            && old.provider_id_field.as_ref() == Some(id_field)
+            && next.provider_id_field.as_ref() == Some(id_field);
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    #[test]
+    fn failed_or_cancelled_resolution_waits_for_the_session_stop() {
+        for (failure, cancelled) in [(Some("Provider failed"), false), (None, true)] {
+            let (lease, release, finished) =
+                super::super::ott_vportal_lease::Lease::pending_for_test();
+            let (returned, result) = mpsc::channel();
+            let worker = std::thread::spawn(move || {
+                let error = complete_resolution(
+                    Resolved {
+                        url: "https://media.test/video".into(),
+                        lease: Some(lease),
+                    },
+                    failure,
+                    &AtomicBool::new(cancelled),
+                )
+                .err();
+                returned.send(error).unwrap();
+            });
+            release.recv_timeout(Duration::from_secs(1)).unwrap();
+            assert_eq!(
+                result.recv_timeout(Duration::from_millis(30)),
+                Err(mpsc::RecvTimeoutError::Timeout),
+                "resolver returned before its session stop completed"
+            );
+            finished.send(()).unwrap();
+            assert_eq!(
+                result.recv_timeout(Duration::from_secs(1)).unwrap(),
+                Some(failure.unwrap_or("Playback request cancelled"))
+            );
+            worker.join().unwrap();
+        }
+    }
+
+    #[test]
+    fn failed_session_stop_is_not_hidden_by_the_original_provider_error() {
+        let (lease, _release, finished) =
+            super::super::ott_vportal_lease::Lease::pending_for_test();
+        drop(finished);
+        let result = complete_resolution(
+            Resolved {
+                url: String::new(),
+                lease: Some(lease),
+            },
+            Some("Provider failed"),
+            &AtomicBool::new(false),
+        );
+        assert_eq!(
+            result.err(),
+            Some("Previous playback session did not finish closing")
+        );
+    }
+
+    #[test]
+    fn accepted_resolution_keeps_its_live_session_owned_by_the_caller() {
+        let (lease, release, _finished) =
+            super::super::ott_vportal_lease::Lease::pending_for_test();
+        let result = complete_resolution(
+            Resolved {
+                url: "https://media.test/video".into(),
+                lease: Some(lease),
+            },
+            None,
+            &AtomicBool::new(false),
+        )
+        .unwrap_or_else(|error| panic!("accepted resolution failed: {error}"));
+        assert!(result.lease.is_some());
+        assert_eq!(release.try_recv(), Err(mpsc::TryRecvError::Empty));
+        drop(result);
+        assert_eq!(release.recv_timeout(Duration::from_secs(1)), Ok(()));
+    }
+
+    #[test]
+    fn full_channel_does_not_prevent_cancelling_old_scan() {
+        let (tx, _rx) = mpsc::sync_channel(1);
+        tx.send(1).unwrap();
+        let cancel = Arc::new(AtomicBool::new(false));
+        let worker_cancel = cancel.clone();
+        let (done, received) = mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            done.send(send_event(&tx, 2, &worker_cancel)).unwrap();
+        });
+        cancel.store(true, Ordering::Release);
+        assert!(received
+            .recv_timeout(Duration::from_secs(2))
+            .unwrap()
+            .is_err());
+        worker.join().unwrap();
+    }
+
+    #[test]
+    fn backpressure_keeps_order_and_receiver_drop_settles() {
+        let (tx, rx) = mpsc::sync_channel(1);
+        tx.send(1).unwrap();
+        let worker = std::thread::spawn(move || send_event(&tx, 2, &AtomicBool::new(false)));
+        assert_eq!(rx.recv().unwrap(), 1);
+        assert_eq!(rx.recv_timeout(Duration::from_secs(2)).unwrap(), 2);
+        assert!(worker.join().unwrap().is_ok());
+        let (tx, rx) = mpsc::sync_channel::<u8>(1);
+        drop(rx);
+        assert!(send_event(&tx, 1, &AtomicBool::new(false)).is_err());
+    }
+
+    #[test]
+    fn vportal_folder_aliases_share_favorite_identity() {
+        let item = |row: &str| CatalogEntry {
+            id: row.into(),
+            title: "Film".into(),
+            category: row.into(),
+            description: String::new(),
+            poster: String::new(),
+            duration_ms: None,
+            media: MediaLocator::VPortal {
+                request: serde_json::json!({"id":"42"}),
+            },
+            provider_id: Some("42".into()),
+            provider_id_field: Some("id".into()),
+        };
+        assert!(same_match(
+            &ott::favorites::Locator::VPortal {
+                id_field: "id".into(),
+                id: "42".into()
+            },
+            &item("a"),
+            &item("b")
+        ));
+        assert!(!same_match(
+            &ott::favorites::Locator::ChannelName {
+                name: "Film".into(),
+                group: None
+            },
+            &item("a"),
+            &item("b")
+        ));
+    }
+}
diff --git a/rust-modules/src/app/ott_commands.rs b/rust-modules/src/app/ott_commands.rs
new file mode 100644
index 0000000000000000000000000000000000000000..40f69809ef30e7d8d900f1b3b0b5babaf4e88be2
--- /dev/null
+++ b/rust-modules/src/app/ott_commands.rs
@@ -0,0 +1,1347 @@
+//! Native adapters for the existing authenticated OTT request/result contract.
+//! Source credentials remain inside Saved and never enter metadata receipts.
+use super::*;
+#[path = "ott_controls.rs"]
+mod controls;
+#[path = "ott_commands_offline.rs"]
+mod offline;
+#[path = "ott_provider_settings.rs"]
+mod provider_adapters;
+#[path = "ott_settings.rs"]
+mod settings;
+use crate::app::ott_remote::AfterReply;
+use plx_machine::machine::{Edge, InputEvent, InputKind, Key, Source, Tick};
+
+#[derive(Default)]
+pub(super) struct Receipts {
+    rows: Vec<Receipt>,
+    play_response: Option<(String, Value)>,
+    deferred_channel: Option<DeferredChannel>,
+}
+struct DeferredChannel {
+    invocation: Invocation,
+    catalog_generation: u64,
+    last_input: u32,
+    context: String,
+}
+
+fn selection_context(runtime: &Runtime) -> String {
+    hash(&json!([
+        context(runtime),
+        runtime.saved.category,
+        runtime.saved.favorites_selected
+    ]))
+}
+
+fn supersede_deferred(runtime: &mut Runtime) {
+    if let Some(pending) = runtime.command_receipts.deferred_channel.take() {
+        runtime
+            .remote
+            .complete(pending.invocation, rejected("Channel request superseded"));
+    }
+}
+
+/// Explicit playback exit must retire a channel still waiting for its first
+/// catalogue batch as well as the receipt for a previously admitted start.
+pub(super) fn cancel_pending_play(runtime: &mut Runtime) {
+    supersede_deferred(runtime);
+    runtime.command_receipts.play_response = None;
+}
+
+fn deferred_ready(
+    deadline: u64,
+    now: u64,
+    current: bool,
+    allowed: bool,
+    loading: bool,
+    empty: bool,
+) -> Result<bool, &'static str> {
+    if deadline <= now {
+        return Err("Channel request expired");
+    }
+    if !current {
+        return Err("Channel source or request changed");
+    }
+    if !allowed {
+        return Err("Playback is suspended");
+    }
+    Ok(!loading || !empty)
+}
+
+fn drain_deferred(runtime: &mut Runtime, app: &mut App) {
+    let Some(pending) = runtime.command_receipts.deferred_channel.take() else {
+        return;
+    };
+    let current = pending.catalog_generation == runtime.generation
+        && pending.last_input == app.last_input
+        && pending.context == selection_context(runtime)
+        && runtime.remote.invocation_is_current(&pending.invocation);
+    match deferred_ready(
+        pending.invocation.deadline_ms,
+        runtime.now_ms(),
+        current,
+        app.running && super::playback_allowed(app),
+        runtime.catalog_loading,
+        controls::channels(runtime).is_empty(),
+    ) {
+        Ok(false) => runtime.command_receipts.deferred_channel = Some(pending),
+        Ok(true) => {
+            if let Some(response) = command(runtime, app, &pending.invocation) {
+                runtime.remote.complete(pending.invocation, response);
+            }
+        }
+        Err(error) => runtime.remote.complete(pending.invocation, rejected(error)),
+    }
+}
+struct Receipt {
+    token: String,
+    signature: String,
+    context: String,
+    number: usize,
+    expires: u64,
+}
+impl Receipts {
+    fn record(
+        &mut self,
+        id: &str,
+        signature: String,
+        context: String,
+        number: usize,
+        now: u64,
+    ) -> String {
+        self.rows.retain(|r| r.expires > now);
+        let token = format!("revision:{id}");
+        self.rows.retain(|r| r.token != token);
+        if self.rows.len() >= 64 {
+            self.rows.remove(0);
+        }
+        self.rows.push(Receipt {
+            token: token.clone(),
+            signature,
+            context,
+            number,
+            expires: now.saturating_add(120000),
+        });
+        token
+    }
+    fn consume(
+        &mut self,
+        token: &str,
+        signature: &str,
+        context: &str,
+        number: usize,
+        now: u64,
+    ) -> bool {
+        let Some(i) = self.rows.iter().position(|r| r.token == token) else {
+            return false;
+        };
+        let r = self.rows.remove(i);
+        r.expires > now && r.signature == signature && r.context == context && r.number == number
+    }
+}
+
+fn wire_provider(kind: ProviderKind) -> &'static str {
+    if kind == ProviderKind::Local {
+        "offline"
+    } else {
+        kind.canonical_id()
+    }
+}
+fn provider_kind(value: &str) -> Option<ProviderKind> {
+    match value {
+        "m3u" => Some(ProviderKind::M3u),
+        "xtream" => Some(ProviderKind::Xtream),
+        "stalker" => Some(ProviderKind::Stalker),
+        "vportal" => Some(ProviderKind::VPortal),
+        "local" | "offline" => Some(ProviderKind::Local),
+        "plex" => Some(ProviderKind::Plex),
+        _ => None,
+    }
+}
+fn kinds() -> [ProviderKind; 6] {
+    [
+        ProviderKind::M3u,
+        ProviderKind::VPortal,
+        ProviderKind::Local,
+        ProviderKind::Plex,
+        ProviderKind::Xtream,
+        ProviderKind::Stalker,
+    ]
+}
+fn provider_name(kind: ProviderKind) -> &'static str {
+    match kind {
+        ProviderKind::M3u => "M3U",
+        ProviderKind::VPortal => "VPortal",
+        ProviderKind::Local => "Local videos",
+        ProviderKind::Plex => "Plex",
+        ProviderKind::Xtream => "Xtream",
+        ProviderKind::Stalker => "Stalker",
+    }
+}
+fn fields(value: &Value, keys: &[&str]) -> bool {
+    value
+        .as_object()
+        .is_some_and(|map| map.len() == keys.len() && keys.iter().all(|key| map.contains_key(*key)))
+}
+fn subset(value: &Value, keys: &[&str]) -> bool {
+    value
+        .as_object()
+        .is_some_and(|map| !map.is_empty() && map.keys().all(|key| keys.contains(&key.as_str())))
+}
+fn text(value: &Value, limit: usize, empty: bool) -> Option<&str> {
+    value.as_str().filter(|s| {
+        s.len() <= limit && (empty || !s.trim().is_empty()) && !s.chars().any(char::is_control)
+    })
+}
+fn unsupported(message: &str) -> Value {
+    json!({"status":"unsupported","data":{"error":message}})
+}
+fn profile_index(saved: &Saved, kind: ProviderKind, number: usize) -> Option<usize> {
+    saved
+        .profiles
+        .profiles
+        .iter()
+        .enumerate()
+        .filter(|(_, p)| p.kind == kind)
+        .enumerate()
+        .find(|(legacy, (_, profile))| {
+            saved
+                .settings
+                .get(&format!("slot:{}", profile.id))
+                .and_then(Value::as_u64)
+                .unwrap_or((*legacy + 1) as u64)
+                == number as u64
+        })
+        .map(|(_, (index, _))| index)
+}
+fn number(params: &Value) -> Result<usize, &'static str> {
+    params["number"]
+        .as_u64()
+        .filter(|n| (1..=15).contains(n))
+        .map(|n| n as usize)
+        .ok_or("Choose a profile number from 1 to 15")
+}
+fn metadata(saved: &Saved, kind: ProviderKind, number: usize) -> Value {
+    let profile = profile_index(saved, kind, number).map(|i| &saved.profiles.profiles[i]);
+    let mut result = json!({"number":number,"name":profile.map(|p|p.name.as_str()).unwrap_or(""),
+        "active":profile.is_some_and(|p|Some(&p.id)==saved.profiles.active_profile.as_ref()),
+        "playlist_configured":kind==ProviderKind::M3u && profile.is_some_and(|p|!p.source.is_empty()),
+        "history_hours":profile.and_then(|p|saved.settings.get(&format!("history:{}",p.id))).and_then(Value::as_u64).unwrap_or(0)});
+    if kind == ProviderKind::VPortal {
+        result["vportal_configured"] = json!(profile.is_some_and(|p| !p.source.is_empty()));
+    }
+    result
+}
+fn hash(value: &Value) -> String {
+    let bytes = plx_base::sha256::sha256(value.to_string().as_bytes());
+    use std::fmt::Write;
+    let mut result = String::with_capacity(64);
+    for byte in bytes {
+        let _ = write!(&mut result, "{byte:02x}");
+    }
+    result
+}
+fn revision(saved: &Saved, kind: ProviderKind, number: usize) -> String {
+    let profile = profile_index(saved, kind, number).map(|i| &saved.profiles.profiles[i]);
+    hash(&json!({"profile":profile,"metadata":metadata(saved,kind,number)}))
+}
+fn context(runtime: &Runtime) -> String {
+    hash(&json!([
+        runtime.remote.runtime(),
+        runtime.saved.profiles.active_profile,
+        wire_provider(runtime.provider)
+    ]))
+}
+fn defer(
+    runtime: &mut Runtime,
+    inv: &Invocation,
+    saved: Saved,
+    reload: bool,
+    response: Value,
+) -> Option<Value> {
+    match runtime.save_reply(saved, inv.clone(), reload, response) {
+        Ok(()) => None,
+        Err(error) => Some(rejected(error)),
+    }
+}
+fn insert_profile(
+    saved: &mut Saved,
+    kind: ProviderKind,
+    number: usize,
+    source: String,
+    name: Option<String>,
+) -> Result<usize, &'static str> {
+    if !(1..=15).contains(&number) {
+        return Err("Choose a profile number from 1 to 15");
+    }
+    let existing = profile_index(saved, kind, number);
+    let mut profile = if let Some(index) = existing {
+        saved.profiles.profiles[index].clone()
+    } else {
+        let mut id = format!("{}-{number}", kind.canonical_id());
+        while saved.profiles.profiles.iter().any(|p| p.id == id) {
+            id.push('_');
+        }
+        ProviderProfile {
+            id,
+            name: format!("{} {number}", provider_name(kind)),
+            kind,
+            source: String::new(),
+            source_alias: String::new(),
+            enabled: true,
+        }
+    };
+    profile.source = source;
+    if let Some(name) = name {
+        profile.name = if name.trim().is_empty() {
+            format!("{} {number}", provider_name(kind))
+        } else {
+            name
+        };
+    }
+    profile
+        .validate()
+        .map_err(|_| "Invalid provider source or profile name")?;
+    // Freeze all previous ordinal slots before adding a sparse numbered slot.
+    let ordinals: Vec<_> = saved
+        .profiles
+        .profiles
+        .iter()
+        .filter(|p| p.kind == kind)
+        .enumerate()
+        .map(|(i, p)| (p.id.clone(), i + 1))
+        .collect();
+    for (id, n) in ordinals {
+        saved
+            .settings
+            .entry(format!("slot:{id}"))
+            .or_insert(json!(n));
+    }
+    saved
+        .settings
+        .insert(format!("slot:{}", profile.id), json!(number));
+    if let Some(index) = existing {
+        saved.profiles.profiles[index] = profile;
+        Ok(index)
+    } else {
+        saved.profiles.profiles.push(profile);
+        Ok(saved.profiles.profiles.len() - 1)
+    }
+}
+
+fn profiles(runtime: &mut Runtime, inv: &Invocation) -> Option<Value> {
+    if inv.action == "profile_settings"
+        && matches!(
+            runtime.provider,
+            ProviderKind::Xtream | ProviderKind::Stalker
+        )
+    {
+        return provider_adapters::command(runtime, inv);
+    }
+    if runtime.provider == ProviderKind::Local {
+        return offline::request(runtime, inv);
+    }
+    let p = &inv.params;
+    if inv.action == "profiles" {
+        return Some(if fields(p, &[]) {
+            ok(
+                json!({"provider":wire_provider(runtime.provider),"profiles":(1..=15).map(|n|metadata(&runtime.saved,runtime.provider,n)).collect::<Vec<_>>()}),
+            )
+        } else {
+            rejected("The profiles query accepts no parameters")
+        });
+    }
+    let n = match number(p) {
+        Ok(n) => n,
+        Err(e) => return Some(rejected(e)),
+    };
+    let mut saved = runtime.saved.clone();
+    if inv.action == "profile" {
+        if !fields(p, &["number"]) {
+            return Some(rejected("Profile selection accepts only a number"));
+        }
+        let Some(index) = profile_index(&saved, runtime.provider, n) else {
+            return Some(rejected("Configure this profile before selecting it"));
+        };
+        let profile = &saved.profiles.profiles[index];
+        if !profile.enabled {
+            return Some(rejected("This profile is disabled"));
+        }
+        let reload = saved.profiles.active_profile.as_ref() != Some(&profile.id);
+        saved.profiles.active_profile = Some(profile.id.clone());
+        saved.category.clear();
+        saved.favorites_selected = false;
+        let response = ok(
+            json!({"provider":wire_provider(runtime.provider),"profile":metadata(&saved,runtime.provider,n),"dispatched":true,"reloaded":reload}),
+        );
+        return defer(runtime, inv, saved, reload, response);
+    }
+    if inv.action != "profile_settings" {
+        return Some(unsupported(
+            "Portable local profile bindings require a native binding adapter",
+        ));
+    }
+    let allowed = match runtime.provider {
+        ProviderKind::M3u => &["name", "playlist", "history_hours"][..],
+        ProviderKind::VPortal => &["name", "vportal"][..],
+        _ => &[][..],
+    };
+    if !fields(p, &["number", "settings"]) || !subset(&p["settings"], allowed) {
+        return Some(rejected("Unsupported profile settings fields"));
+    }
+    let settings = &p["settings"];
+    let current =
+        profile_index(&saved, runtime.provider, n).map(|i| saved.profiles.profiles[i].clone());
+    let source_key = if runtime.provider == ProviderKind::VPortal {
+        "vportal"
+    } else {
+        "playlist"
+    };
+    let source = if let Some(source) = settings.get(source_key) {
+        match text(source, 8192, false) {
+            Some(s) => s.to_owned(),
+            None => return Some(rejected("Use a valid playlist URL")),
+        }
+    } else {
+        current
+            .as_ref()
+            .map(|p| p.source.clone())
+            .unwrap_or_default()
+    };
+    let name = if let Some(name) = settings.get("name") {
+        match text(name, 256, true) {
+            Some(s) => Some(s.to_owned()),
+            None => return Some(rejected("Invalid profile name")),
+        }
+    } else {
+        None
+    };
+    let index = match insert_profile(&mut saved, runtime.provider, n, source, name) {
+        Ok(i) => i,
+        Err(e) => return Some(rejected(e)),
+    };
+    if let Some(hours) = settings.get("history_hours") {
+        let Some(hours) = hours.as_u64().filter(|n| *n <= 8760) else {
+            return Some(rejected("Use whole archive hours from 0 to 8760"));
+        };
+        saved.settings.insert(
+            format!("history:{}", saved.profiles.profiles[index].id),
+            json!(hours),
+        );
+    }
+    let reload = saved.profiles.active_profile.as_ref() == Some(&saved.profiles.profiles[index].id);
+    let changed =
+        saved.profiles != runtime.saved.profiles || saved.settings != runtime.saved.settings;
+    let response = ok(
+        json!({"provider":wire_provider(runtime.provider),"profile":metadata(&saved,runtime.provider,n),"saved":true,"fields":settings.as_object().unwrap().keys().collect::<Vec<_>>(),"reloaded":reload&&changed}),
+    );
+    defer(runtime, inv, saved, reload && changed, response)
+}
+fn provider_settings(runtime: &mut Runtime, inv: &Invocation) -> Option<Value> {
+    let now = runtime.now_ms();
+    let p = &inv.params;
+    let Some(kind) = p["provider"].as_str().and_then(provider_kind) else {
+        return Some(rejected("Unknown provider"));
+    };
+    if matches!(kind, ProviderKind::Xtream | ProviderKind::Stalker) {
+        return provider_adapters::command(runtime, inv);
+    }
+    if kind == ProviderKind::Plex {
+        return plex_settings(runtime, inv);
+    }
+    let compare = inv.action == "settings_compare";
+    let expected = match (kind, compare) {
+        (ProviderKind::VPortal, true) => &["provider", "number", "runtime", "settings"][..],
+        (ProviderKind::VPortal, false) => {
+            &["provider", "runtime", "context", "revision", "settings"][..]
+        }
+        (_, true) => &["provider", "number", "settings"][..],
+        (_, false) => &["provider", "settings"][..],
+    };
+    if !fields(p, expected) {
+        return Some(rejected("Invalid provider settings parameters"));
+    }
+    let settings = &p["settings"];
+    let n = if kind == ProviderKind::VPortal && !compare {
+        settings["profile"]
+            .as_u64()
+            .and_then(|n| usize::try_from(n).ok())
+    } else {
+        p["number"]
+            .as_u64()
+            .and_then(|n| usize::try_from(n).ok())
+            .or_else(|| {
+                (!compare).then(|| {
+                    (1..=15)
+                        .find(|n| {
+                            profile_index(&runtime.saved, kind, *n).is_some_and(|i| {
+                                Some(&runtime.saved.profiles.profiles[i].id)
+                                    == runtime.saved.profiles.active_profile.as_ref()
+                            })
+                        })
+                        .unwrap_or(1)
+                })
+            })
+    };
+    let Some(n) = n.filter(|n| (1..=15).contains(n)) else {
+        return Some(rejected("Choose a profile number from 1 to 15"));
+    };
+    if kind == ProviderKind::VPortal {
+        if p["runtime"] != runtime.remote.runtime() {
+            return Some(rejected("The player runtime changed"));
+        }
+        let allowed = if compare {
+            &["name", "vportal"][..]
+        } else {
+            &["profile", "name", "vportal"][..]
+        };
+        if !subset(settings, allowed)
+            || text(&settings["vportal"], 8192, true).is_none()
+            || settings
+                .get("name")
+                .is_some_and(|v| text(v, 256, true).is_none())
+            || (!compare && settings.get("profile").is_none())
+        {
+            return Some(rejected("Unsupported VPortal settings fields"));
+        }
+    } else if kind == ProviderKind::M3u {
+        let allowed = if compare {
+            &["name", "playlist", "history_hours"][..]
+        } else {
+            &["playlist"][..]
+        };
+        if !subset(settings, allowed) {
+            return Some(rejected("Unsupported M3U settings fields"));
+        }
+    } else {
+        return Some(unsupported(
+            "Select a native local folder on this installation",
+        ));
+    }
+    let current =
+        profile_index(&runtime.saved, kind, n).map(|i| &runtime.saved.profiles.profiles[i]);
+    if compare {
+        let matched = if kind == ProviderKind::VPortal {
+            current.is_some_and(|c| {
+                settings["vportal"] == c.source && settings.get("name").is_none_or(|n| *n == c.name)
+            })
+        } else {
+            current.is_some_and(|c| {
+                settings["playlist"] == c.source
+                    && settings["name"] == c.name
+                    && settings["history_hours"]
+                        == metadata(&runtime.saved, kind, n)["history_hours"]
+            })
+        };
+        let mut data = json!({"provider":wire_provider(kind),"number":n,"matched":matched});
+        if kind == ProviderKind::VPortal {
+            data["runtime"] = json!(runtime.remote.runtime());
+            let ctx = context(runtime);
+            let signature = revision(&runtime.saved, kind, n);
+            data["context"] = json!(ctx);
+            data["revision"] = json!(runtime
+                .command_receipts
+                .record(&inv.id, signature, ctx, n, now));
+        }
+        return Some(ok(data));
+    }
+    if kind == ProviderKind::VPortal {
+        let ctx = context(runtime);
+        let signature = revision(&runtime.saved, kind, n);
+        if p["context"] != ctx
+            || !runtime.command_receipts.consume(
+                p["revision"].as_str().unwrap_or(""),
+                &signature,
+                &ctx,
+                n,
+                now,
+            )
+        {
+            return Some(rejected("The settings source changed before saving"));
+        }
+    }
+    if kind == ProviderKind::M3u && runtime.provider != kind {
+        return Some(rejected(
+            "Select this provider before changing its settings",
+        ));
+    }
+    let source_key = if kind == ProviderKind::VPortal {
+        "vportal"
+    } else {
+        "playlist"
+    };
+    let source = if let Some(value) = settings.get(source_key) {
+        match text(value, 16384, false) {
+            Some(s) => s.to_owned(),
+            None => return Some(rejected("Invalid provider source")),
+        }
+    } else {
+        current.map(|c| c.source.clone()).unwrap_or_default()
+    };
+    let name = if let Some(value) = settings.get("name") {
+        match text(value, 256, true) {
+            Some(s) => Some(s.to_owned()),
+            None => return Some(rejected("Invalid profile name")),
+        }
+    } else {
+        None
+    };
+    let mut saved = runtime.saved.clone();
+    let index = match insert_profile(&mut saved, kind, n, source, name) {
+        Ok(i) => i,
+        Err(e) => return Some(rejected(e)),
+    };
+    if kind == ProviderKind::M3u && saved.profiles.active_profile.is_none() {
+        saved.profiles.active_profile = Some(saved.profiles.profiles[index].id.clone());
+    }
+    let reload = saved.profiles.active_profile.as_ref() == Some(&saved.profiles.profiles[index].id);
+    let mut data = json!({"provider":wire_provider(kind),"fields":settings.as_object().unwrap().keys().collect::<Vec<_>>(),"saved":true});
+    if kind == ProviderKind::VPortal {
+        data["runtime"] = json!(runtime.remote.runtime());
+        data["profile"] = json!(n);
+        data["context"] = json!(context(runtime));
+        let signature = revision(&saved, kind, n);
+        let ctx = context(runtime);
+        data["revision"] = json!(runtime
+            .command_receipts
+            .record(&inv.id, signature, ctx, n, now));
+        data["reloaded"] = json!(reload);
+        data["reload_required"] = json!(false);
+    }
+    defer(runtime, inv, saved, reload, ok(data))
+}
+fn stored_plex(runtime: &Runtime) -> Option<plx_plex::plex::session::SourceRef> {
+    let sources: Vec<plx_plex::plex::session::SourceRef> = runtime
+        .saved
+        .settings
+        .get("nativePlexSources")
+        .cloned()
+        .and_then(|v| serde_json::from_value(v).ok())?;
+    let active = runtime.active().filter(|p| p.kind == ProviderKind::Plex);
+    sources
+        .into_iter()
+        .rev()
+        .find(|s| active.is_none_or(|p| p.source == s.machine_id))
+}
+fn plex_settings(runtime: &mut Runtime, inv: &Invocation) -> Option<Value> {
+    let p = &inv.params;
+    let compare = inv.action == "settings_compare";
+    let settings = &p["settings"];
+    if !fields(p, &["provider", "settings"])
+        || !(if compare {
+            fields(settings, &["server", "token"])
+        } else {
+            subset(settings, &["server", "token"])
+        })
+        || settings
+            .get("server")
+            .is_some_and(|v| text(v, 8192, true).is_none())
+        || settings
+            .get("token")
+            .is_some_and(|v| text(v, 1024, true).is_none())
+    {
+        return Some(rejected("Unsupported Plex settings fields"));
+    }
+    let current = stored_plex(runtime);
+    if compare {
+        let matched = current.is_some_and(|s| {
+            let expected = plx_plex::plex::Origin::parse(
+                settings["server"]
+                    .as_str()
+                    .unwrap()
+                    .trim()
+                    .trim_end_matches('/'),
+            );
+            expected.is_some()
+                && expected.as_ref() == s.origin().as_ref()
+                && settings["token"].as_str().unwrap().trim() == s.token
+        });
+        return Some(ok(json!({"provider":"plex","matched":matched})));
+    }
+    if runtime.provider != ProviderKind::Plex {
+        return Some(rejected("Select Plex before changing its settings"));
+    }
+    let address = settings["server"]
+        .as_str()
+        .map(str::to_owned)
+        .or_else(|| current.as_ref().map(|s| s.origin_url.clone()))
+        .unwrap_or_default();
+    let token = settings["token"]
+        .as_str()
+        .map(str::to_owned)
+        .or_else(|| current.as_ref().map(|s| s.token.clone()))
+        .unwrap_or_default();
+    // An encrypted previously verified source may carry its original HTTP consent.
+    // A remote command cannot silently grant plaintext access to a different origin.
+    let expected = plx_plex::plex::Origin::parse(&address);
+    let same = current
+        .as_ref()
+        .filter(|s| expected.is_some() && s.origin().as_ref() == expected.as_ref());
+    let profile = crate::app::ott_profile::Profile::parse(
+        json!({"address":address,"token":token,
+        "serverId":same.map(|s|s.machine_id.as_str()).unwrap_or(""),
+        "name":current.as_ref().map(|s|s.name.as_str()).unwrap_or("OTTPlay Plex"),
+        "allowInsecureHttp":same.is_some_and(|s|s.origin().is_some_and(|o|!o.is_tls()))})
+        .to_string()
+        .as_bytes(),
+    );
+    match profile.and_then(|profile| runtime.import_plex(profile, inv.clone())) {
+        Ok(()) => None,
+        Err(e) => Some(rejected(e)),
+    }
+}
