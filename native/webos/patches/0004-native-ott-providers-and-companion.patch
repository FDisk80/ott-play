+#[test]
+fn suspend_revokes_queued_press_arms_and_results() {
+    use plx_machine::machine::{Delivery, Fx, PressArm, PressFrom, PressId};
+    for kind in 0..4 {
+        let (mut d, mut rig) = boot(FixtureArg::Page(800));
+        let owner = MachineId::Instance(d.nav.top_page().unwrap().inst.as_ref().unwrap().id);
+        let focus = d.focus().unwrap();
+        let effect = match kind {
+            0 | 1 => Fx::Press(PressArm { key: focus,
+                from: if kind == 0 { PressFrom::Key } else { PressFrom::Pointer }, holdable: true }),
+            _ => Fx::Deliver(owner, Delivery::Press { id: PressId(1), key: focus, held: kind == 2 }),
+        };
+        d.emit(owner, effect);
+        let items = rig.store.view.items.len();
+        d.suspend();
+        d.resume();
+        d.frame(&mut rig, tick(16), vec![], vec![], &mut NoTap);
+        assert!(d.input.arm.is_none(), "a revoked queued arm cannot return after Resume");
+        assert_eq!(rig.store.view.items.len(), items, "queued press results cannot activate the restored page");
+    }
+}
