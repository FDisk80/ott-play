new file mode 100644
index 0000000000000000000000000000000000000000..9022d5e6e2324d97f60d5c863cdd417773556cc4
--- /dev/null
+++ b/rust-modules/data/src/ott/m3u.rs
@@ -0,0 +1,300 @@
+use super::{
+    identity, resolve_http_url, text, Catalog, CatalogEntry, CatalogError, MediaLocator,
+    ProviderKind, ProviderProfile, MAX_CATALOG_BYTES, MAX_CATALOG_ENTRIES, MAX_CATALOG_LINE_BYTES,
+};
+use std::collections::BTreeMap;
+
+#[derive(Default)]
+struct Information {
+    title: String,
+    group: String,
+    logo: String,
+    id: Option<String>,
+    duration_ms: Option<u64>,
+}
+
+/// Streaming line parser: a runner can publish the first returned row before the scan completes.
+pub struct M3uParser {
+    profile: ProviderProfile,
+    pending: Information,
+    bytes: usize,
+    entries: usize,
+}
+
+impl M3uParser {
+    pub fn new(profile: &ProviderProfile) -> Result<Self, CatalogError> {
+        profile.validate()?;
+        if profile.kind != ProviderKind::M3u {
+            return Err(CatalogError::InvalidProfile);
+        }
+        Ok(Self {
+            profile: profile.clone(),
+            pending: Information::default(),
+            bytes: 0,
+            entries: 0,
+        })
+    }
+
+    pub fn push_line(&mut self, line: &str) -> Result<Option<CatalogEntry>, CatalogError> {
+        self.bytes = self.bytes.saturating_add(line.len() + 1);
+        if line.len() > MAX_CATALOG_LINE_BYTES || self.bytes > MAX_CATALOG_BYTES {
+            return Err(CatalogError::LimitExceeded);
+        }
+        let line = line.trim().trim_start_matches('\u{feff}');
+        if line.is_empty() {
+            return Ok(None);
+        }
+        if line.starts_with("#EXT-X-") {
+            return Err(CatalogError::InvalidFormat);
+        }
+        if let Some(info) = line.strip_prefix("#EXTINF:") {
+            self.pending = information(info);
+            return Ok(None);
+        }
+        if let Some(group) = line.strip_prefix("#EXTGRP:") {
+            self.pending.group = text(group, 1024);
+            return Ok(None);
+        }
+        if line.starts_with('#') {
+            return Ok(None);
+        }
+        let pending = std::mem::take(&mut self.pending);
+        let Some(url) = resolve_http_url(&self.profile.source, line) else {
+            return Ok(None);
+        };
+        if self.entries >= MAX_CATALOG_ENTRIES {
+            return Err(CatalogError::LimitExceeded);
+        }
+        self.entries += 1;
+        let untitled = pending.title.is_empty();
+        let title = if untitled {
+            format!("Video {}", self.entries)
+        } else {
+            pending.title
+        };
+        // Ignore known expiring query credentials while preserving distinct source paths.
+        let key = format!(
+            "{}\0{}\0{}\0{}",
+            pending.id.as_deref().unwrap_or(""),
+            if untitled { "" } else { &title },
+            pending.group,
+            stable_source(&url)
+        );
+        Ok(Some(CatalogEntry {
+            id: identity(&self.profile.id, &key),
+            title,
+            category: pending.group,
+            description: String::new(),
+            poster: resolve_http_url(&self.profile.source, &pending.logo).unwrap_or_default(),
+            media: MediaLocator::Http { url },
+            duration_ms: pending.duration_ms,
+            provider_id_field: None,
+            provider_id: pending.id,
+        }))
+    }
+}
+
+pub fn parse_m3u(input: &str, profile: &ProviderProfile) -> Result<Catalog, CatalogError> {
+    if input.len() > MAX_CATALOG_BYTES {
+        return Err(CatalogError::LimitExceeded);
+    }
+    let mut parser = M3uParser::new(profile)?;
+    let mut catalogue = Catalog::default();
+    for line in input.lines() {
+        if let Some(entry) = parser.push_line(line)? {
+            catalogue.entries.push(entry);
+        }
+    }
+    // Deduplication applies to repeated source rows, not repeated display names or tvg-ids.
+    let mut result = Catalog::default();
+    result.merge(catalogue)?;
+    Ok(result)
+}
+
+fn information(input: &str) -> Information {
+    let mut quote = None;
+    let mut separator = None;
+    for (index, ch) in input.char_indices() {
+        if matches!(ch, '\'' | '"') {
+            if quote == Some(ch) {
+                quote = None;
+            } else if quote.is_none() {
+                quote = Some(ch);
+            }
+        } else if ch == ',' && quote.is_none() {
+            separator = Some(index);
+            break;
+        }
+    }
+    let (head, title) = separator.map_or((input, ""), |i| (&input[..i], &input[i + 1..]));
+    let seconds = head
+        .split_whitespace()
+        .next()
+        .and_then(|v| v.parse::<f64>().ok());
+    let duration_ms = seconds
+        .filter(|s| s.is_finite() && *s > 0.0 && *s <= 86400.0 * 365.0)
+        .map(|s| (s * 1000.0) as u64);
+    let fields = attributes(head);
+    let field = |name: &str| fields.get(name).map(String::as_str).unwrap_or("");
+    let title = if title.trim().is_empty() {
+        field("tvg-name")
+    } else {
+        title
+    };
+    Information {
+        title: text(title, 1024),
+        group: text(field("group-title"), 1024),
+        logo: field("tvg-logo").into(),
+        id: (!field("tvg-id").is_empty()).then(|| text(field("tvg-id"), 256)),
+        duration_ms,
+    }
+}
+
+fn attributes(input: &str) -> BTreeMap<String, String> {
+    let mut rest = input;
+    let mut fields = BTreeMap::new();
+    while !rest.is_empty() {
+        rest = rest.trim_start();
+        let Some(end) = rest.find(|c: char| c == '=' || c.is_whitespace()) else {
+            break;
+        };
+        let key = &rest[..end];
+        rest = &rest[end..];
+        if !rest.starts_with('=') {
+            rest = rest.trim_start();
+            continue;
+        }
+        rest = rest[1..].trim_start();
+        let value;
+        if rest.starts_with(['\'', '"']) {
+            let q = rest.as_bytes()[0] as char;
+            rest = &rest[1..];
+            let Some(end) = rest.find(q) else {
+                break;
+            };
+            value = &rest[..end];
+            rest = &rest[end + 1..];
+        } else {
+            let end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+            value = &rest[..end];
+            rest = &rest[end..];
+        }
+        fields.insert(key.to_ascii_lowercase(), value.to_string());
+    }
+    fields
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn unnamed_sources_keep_identity_after_reordering() {
+        let a = parse_m3u(
+            "#EXTM3U\nhttps://tv.invalid/a.mp4\nhttps://tv.invalid/b.mp4",
+            &profile(),
+        )
+        .unwrap();
+        let b = parse_m3u(
+            "#EXTM3U\nhttps://tv.invalid/b.mp4\nhttps://tv.invalid/a.mp4",
+            &profile(),
+        )
+        .unwrap();
+        assert_eq!(a.entries[0].id, b.entries[1].id);
+        assert_eq!(a.entries[1].id, b.entries[0].id);
+    }
+    fn profile() -> ProviderProfile {
+        ProviderProfile {
+            id: "m3u-home".into(),
+            name: "Home".into(),
+            kind: ProviderKind::M3u,
+            source: "https://tv.invalid/lists/live.m3u".into(),
+            source_alias: "".into(),
+            enabled: true,
+        }
+    }
+    #[test]
+    fn first_row_is_available_without_finish() {
+        let mut parser = M3uParser::new(&profile()).unwrap();
+        assert!(parser.push_line("#EXTM3U").unwrap().is_none());
+        parser
+            .push_line("#EXTINF:-1 tvg-name=\"News, one\" group-title=\"World\",News")
+            .unwrap();
+        let row = parser.push_line("../news.m3u8").unwrap().unwrap();
+        assert_eq!(row.title, "News");
+        assert_eq!(row.category, "World");
+        assert_eq!(
+            row.media,
+            MediaLocator::Http {
+                url: "https://tv.invalid:443/news.m3u8".into()
+            }
+        );
+    }
+    #[test]
+    fn metadata_quotes_commas_and_duplicate_ids_are_preserved() {
+        let result = parse_m3u("\u{feff}#EXTM3U\r\n#EXTINF:61.5 tvg-id='one' tvg-logo='/one.png' group-title='A,B',Film, part 1\r\nhttps://tv.invalid/1.mp4\n#EXTINF:-1 tvg-id='one',Other\nhttps://tv.invalid/2\n", &profile()).unwrap();
+        assert_eq!(result.entries.len(), 2);
+        assert_ne!(result.entries[0].id, result.entries[1].id);
+        assert_eq!(result.entries[0].duration_ms, Some(61500));
+        assert_eq!(result.entries[0].category, "A,B");
+        assert_eq!(result.entries[0].poster, "https://tv.invalid:443/one.png");
+    }
+    #[test]
+    fn invalid_transports_and_hls_segments_do_not_become_channels() {
+        assert!(parse_m3u(
+            "#EXTM3U\nfile:///private/movie.mp4\njavascript:alert(1)",
+            &profile()
+        )
+        .unwrap()
+        .entries
+        .is_empty());
+        assert_eq!(
+            parse_m3u("#EXTM3U\n#EXT-X-TARGETDURATION:10\nsegment.ts", &profile()),
+            Err(CatalogError::InvalidFormat)
+        );
+    }
+}
+
+fn stable_source(url: &str) -> String {
+    let (base, query) = url.split_once('?').unwrap_or((url, ""));
+    let stable: Vec<&str> = query
+        .split('&')
+        .filter(|part| {
+            let key = part.split('=').next().unwrap_or("").to_ascii_lowercase();
+            !part.is_empty()
+                && !matches!(
+                    key.as_str(),
+                    "token"
+                        | "access_token"
+                        | "auth"
+                        | "key"
+                        | "signature"
+                        | "sig"
+                        | "expires"
+                        | "exp"
+                        | "username"
+                        | "password"
+                        | "session"
+                )
+        })
+        .collect();
+    if stable.is_empty() {
+        base.to_owned()
+    } else {
+        format!("{base}?{}", stable.join("&"))
+    }
+}
+
+/// Source-advertised XMLTV references, resolved with the same strict URL policy.
+pub fn epg_urls(header: &str, base: &str) -> Vec<String> {
+    let fields = attributes(
+        header
+            .trim_start_matches('\u{feff}')
+            .trim_start_matches("#EXTM3U"),
+    );
+    ["url-tvg", "x-tvg-url"]
+        .into_iter()
+        .filter_map(|key| fields.get(key))
+        .flat_map(|value| value.split(','))
+        .filter_map(|url| resolve_http_url(base, url.trim()))
+        .collect()
+}
diff --git a/rust-modules/data/src/ott/mod.rs b/rust-modules/data/src/ott/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6667a1d64ac145da39007df495031f9bb70388ae
--- /dev/null
+++ b/rust-modules/data/src/ott/mod.rs
@@ -0,0 +1,149 @@
+//! Provider-neutral input to the native catalogue. Parsers do not fetch, persist or start playback.
+//! The app runner owns IO and supplies complete, bounded responses or directory batches.
+
+pub mod favorites;
+pub mod favorites_wire;
+pub mod xtream;
+pub mod stalker;
+pub mod epg;
+mod local;
+mod m3u;
+mod profiles;
+mod urls;
+mod vportal;
+
+pub use local::{catalog_from_local_files, LocalFile, is_local_video_path, valid_local_relative_path};
+pub use m3u::{parse_m3u, M3uParser, epg_urls};
+pub use profiles::{parse_profiles_json, ProviderKind, ProviderProfile, ProviderProfiles};
+pub use urls::{http_url, resolve_http_url};
+pub use vportal::{parse_vportal_link, parse_vportal_response, PortalLink, PortalPage, PortalRequest};
+
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeSet;
+
+/// Admissions, not promises about a server's total catalogue size.
+pub const MAX_CATALOG_ENTRIES: usize = 50_000;
+pub const MAX_CATALOG_MODEL_BYTES: usize = 32 * 1024 * 1024;
+pub const MAX_CATALOG_BYTES: usize = 8 * 1024 * 1024;
+pub const MAX_CATALOG_LINE_BYTES: usize = 64 * 1024;
+pub const MAX_METADATA_BYTES: usize = 128 * 1024;
+pub const MAX_REQUEST_BYTES: usize = 64 * 1024;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CatalogError { InvalidProfile, InvalidFormat, InvalidUrl, InvalidPath, LimitExceeded, Truncated }
+
+impl std::fmt::Display for CatalogError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::InvalidProfile => "Invalid provider profile",
+            Self::InvalidFormat => "Invalid catalogue response",
+            Self::InvalidUrl => "Invalid HTTP media address",
+            Self::InvalidPath => "Invalid relative media path",
+            Self::LimitExceeded => "Catalogue response exceeds its limit",
+            Self::Truncated => "Catalogue response is incomplete",
+        })
+    }
+}
+impl std::error::Error for CatalogError {}
+
+#[derive(Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "kebab-case", deny_unknown_fields)]
+pub enum MediaLocator {
+    Http { url: String },
+    Local { relative_path: String },
+    VPortal { request: serde_json::Value },
+    Plex { server_id: String, rating_key: String },
+    Xtream { stream_id: String, stream_kind: String, extension: String, #[serde(default)] series_id: Option<String>, #[serde(default)] has_direct_source: bool },
+    Stalker { cmd: String, stream_kind: String, #[serde(default)] series: String },
+    ServerLibrary {source_id:String,item_id:String,#[serde(default)] relative_path:Option<String>,#[serde(default)] root_alias:Option<String>},
+}
+
+// HTTP URLs and portal requests may contain credentials. Ordinary debug output must not.
+impl std::fmt::Debug for MediaLocator {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self { Self::Http { .. } => "Http(<private>)", Self::Local { .. } => "Local(<private>)", Self::VPortal { .. } => "VPortal(<private>)", Self::Plex { .. } => "Plex(<private>)", Self::Xtream { .. } => "Xtream(<private>)", Self::Stalker { .. } => "Stalker(<private>)",Self::ServerLibrary {..}=>"ServerLibrary(<private>)" })
+    }
+}
+
+#[derive(Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CatalogEntry {
+    pub id: String,
+    pub title: String,
+    pub category: String,
+    pub description: String,
+    pub poster: String,
+    pub media: MediaLocator,
+    pub duration_ms: Option<u64>,
+    /// A provider-attested ID (e.g. tvg-id), separate from the catalogue's collision-safe key.
+    pub provider_id: Option<String>,
+    #[serde(default)] pub provider_id_field: Option<String>,
+}
+
+impl std::fmt::Debug for CatalogEntry {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("CatalogEntry").field("id", &self.id).field("category", &self.category).field("media", &self.media).finish_non_exhaustive()
+    }
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Catalog { pub entries: Vec<CatalogEntry> }
+
+impl Catalog {
+    /// First-seen order is retained. The UI adds its reserved All and Favorites choices.
+    pub fn categories(&self) -> Vec<String> {
+        let mut seen = BTreeSet::new();
+        self.entries.iter().filter_map(|entry| {
+            (!entry.category.is_empty() && seen.insert(entry.category.clone())).then(|| entry.category.clone())
+        }).collect()
+    }
+
+    /// Atomic bounded merge of background batches. Repeated page entries replace their old row.
+    pub fn merge(&mut self, batch: Catalog) -> Result<(), CatalogError> {
+        let mut ids: BTreeSet<&str> = self.entries.iter().map(|e| e.id.as_str()).collect();
+        ids.extend(batch.entries.iter().map(|e| e.id.as_str()));
+        if ids.len() > MAX_CATALOG_ENTRIES { return Err(CatalogError::LimitExceeded); }
+        let mut positions: std::collections::BTreeMap<String, usize> = self.entries.iter().enumerate().map(|(i,e)| (e.id.clone(), i)).collect();
+        let mut sizes: std::collections::BTreeMap<&str, usize> = self.entries.iter().map(|e| (e.id.as_str(), model_bytes(e))).collect();
+        for entry in &batch.entries {sizes.insert(&entry.id,model_bytes(entry));}
+        if sizes.values().try_fold(0usize,|total,size| total.checked_add(*size)).is_none_or(|size|size>MAX_CATALOG_MODEL_BYTES) {
+            return Err(CatalogError::LimitExceeded);
+        }
+        for entry in batch.entries {
+            if let Some(&i) = positions.get(&entry.id) { self.entries[i] = entry; }
+            else { positions.insert(entry.id.clone(), self.entries.len()); self.entries.push(entry); }
+        }
+        Ok(())
+    }
+}
+
+fn model_bytes(entry:&CatalogEntry)->usize {
+    let media=match &entry.media {
+        MediaLocator::Http {url}=>url.len(),MediaLocator::Local {relative_path}=>relative_path.len(),
+        MediaLocator::VPortal {request}=>request.to_string().len(),
+        MediaLocator::Plex {server_id,rating_key}=>server_id.len()+rating_key.len(),
+        MediaLocator::Xtream {stream_id,stream_kind,extension,series_id,..}=>stream_id.len()+stream_kind.len()+extension.len()+series_id.as_ref().map_or(0,String::len),
+        MediaLocator::Stalker {cmd,stream_kind,series}=>cmd.len()+stream_kind.len()+series.len(),
+        MediaLocator::ServerLibrary {source_id,item_id,relative_path,root_alias}=>source_id.len()+item_id.len()+relative_path.as_ref().map_or(0,String::len)+root_alias.as_ref().map_or(0,String::len),
+    };
+    entry.id.len()+entry.title.len()+entry.category.len()+entry.description.len()+entry.poster.len()+media
+        +entry.provider_id.as_ref().map_or(0,String::len)+entry.provider_id_field.as_ref().map_or(0,String::len)+std::mem::size_of::<CatalogEntry>()
+}
+
+pub(super) fn text(value: &str, limit: usize) -> String {
+    let mut output = String::new();
+    for ch in value.trim().chars() {
+        let ch = if ch.is_control() && ch != '\n' && ch != '\t' { ' ' } else { ch };
+        if output.len() + ch.len_utf8() > limit { break; }
+        output.push(ch);
+    }
+    output
+}
+
+/// Deterministic non-security fingerprint; never used for authentication or credential hiding.
+pub(super) fn identity(profile: &str, value: &str) -> String {
+    let mut hash = 0xcbf29ce484222325_u64;
+    for byte in value.bytes() { hash ^= u64::from(byte); hash = hash.wrapping_mul(0x100000001b3); }
+    format!("{profile}:{hash:016x}")
+}
