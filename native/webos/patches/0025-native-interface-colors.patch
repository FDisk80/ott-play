+#[cfg(test)]
+mod interface_palette_renderer_tests {
+    use super::*;
+    use crate::palette::{self, Config, Role};
+
+    struct Restore(Config);
+    impl Drop for Restore {
+        fn drop(&mut self) { palette::project(self.0); }
+    }
+
+    #[test]
+    fn retained_wash_and_controls_repaint_and_reset_without_reconstruction() {
+        let _serial = plx_base::testlock::serial();
+        let _restore = Restore(palette::current());
+        palette::project(Config::default());
+        let wash = AmbientWash::flat(theme::SURFACE_APP);
+        let retained = ControlPalette::default();
+        let base = crate::draw_census::capture_grounds(|| wash.draw(Painter::recording(), Rect::FULL));
+        let base_face = ControlStyle::Accent.face(true, ControlGround::Keyed, retained);
+        let custom = Config::default().with(Role::Background, Some("#F8FAFC")).unwrap()
+            .with(Role::Surface, Some("#E2E8F0")).unwrap()
+            .with(Role::Text, Some("#0F172A")).unwrap()
+            .with(Role::Selection, Some("#DBEAFE")).unwrap()
+            .with(Role::SelectionText, Some("#1E3A8A")).unwrap();
+        palette::project(custom);
+        let ground = crate::draw_census::capture_grounds(|| wash.draw(Painter::recording(), Rect::FULL));
+        assert_eq!(ground, vec![[[248.0/255.0, 250.0/255.0, 252.0/255.0]; 4]]);
+        assert_eq!(wash.sample(Rect::FULL, 13.0, 27.0), ground[0][0]);
+        let face = ControlStyle::Accent.face(true, ControlGround::Keyed, retained);
+        assert_eq!(face.top, [219.0/255.0, 234.0/255.0, 254.0/255.0, base_face.top[3]]);
+        assert_eq!(face.ink, [30.0/255.0, 58.0/255.0, 138.0/255.0, base_face.ink[3]]);
+        let runs = crate::draw_census::capture_runs(|| {
+            Button::new(c"Choose".as_ptr(), theme::size::BODY, Rect::new(20.0,20.0,240.0,60.0))
+                .focused(true).palette(retained).draw(&Env::inert(), Painter::recording());
+        });
+        assert!(runs.iter().any(|run| run.text == "Choose" && run.ink == face.ink));
+        palette::project(Config::default());
+        assert_eq!(crate::draw_census::capture_grounds(|| wash.draw(Painter::recording(), Rect::FULL)), base);
+        let reset = ControlStyle::Accent.face(true, ControlGround::Keyed, retained);
+        assert_eq!(reset.top, base_face.top);
+        assert_eq!(reset.ink, base_face.ink);
+    }
+
+    #[test]
+    fn custom_scrim_preserves_artwork_coverage_and_inherited_geometry() {
+        let _serial = plx_base::testlock::serial();
+        let _restore = Restore(palette::current());
+        palette::project(Config::default());
+        let (base, count) = hero_scrim_quads(0.75, true);
+        palette::project(Config::default().with(Role::Background, Some("#F8FAFC")).unwrap());
+        let (custom, custom_count) = hero_scrim_quads(0.75, true);
+        assert_eq!(count, custom_count);
+        for (old, new) in base.iter().zip(custom) {
+            assert_eq!(old.0, new.0);
+            for (a,b) in old.1.iter().zip(new.1) {
+                assert_eq!(a[3], b[3]);
+                assert_eq!(&b[..3], &[248.0/255.0,250.0/255.0,252.0/255.0]);
+            }
+        }
+    }
